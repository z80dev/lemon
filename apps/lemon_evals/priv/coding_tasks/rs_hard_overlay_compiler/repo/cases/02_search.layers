# search service deployment: common base, regional routing, security policy
[base]
set|service.name|search.base
set|service.port|8080
set|service.enabled|true
list|service.tags|base,common,base
set|service.url|https://${service.name}:${service.port}
set|auth.token|initial-search
set|auth.header|Bearer ${auth.token}
set|cache.ttl|300
set|cache.note|base cache
set|cachex|prefix lookalike survives
set|meta.literal|$${service.name} $$ ${service.name}
[regional]
parents=base
append|service.tags|common,ap-south,common
set|service.port|009200
set|cache.note|regional cache
[security]
parents=base
append|service.tags|secure,common
set|auth.token|rotated-search
delete|cache
[release]
parents=regional,security
append|service.tags|ap-south,release,common
remove|service.tags|common
set|service.name|search.final
append|service.tags|release,${service.name},search.final
set|cache.ttl|90
