# inventory service deployment: common base, regional routing, security policy
[base]
set|service.name|inventory.base
set|service.port|8080
set|service.enabled|true
list|service.tags|base,common,base
set|service.url|https://${service.name}:${service.port}
set|auth.token|initial-inventory
set|auth.header|Bearer ${auth.token}
set|cache.ttl|300
set|cache.note|base cache
set|cachex|prefix lookalike survives
set|meta.literal|$${service.name} $$ ${service.name}
[regional]
parents=base
append|service.tags|common,eu-west,common
set|service.port|008400
set|cache.note|regional cache
[security]
parents=base
append|service.tags|secure,common
set|auth.token|rotated-inventory
delete|cache
[release]
parents=security,regional
append|service.tags|eu-west,release,common
remove|service.tags|common
set|service.name|inventory.final
append|service.tags|release,${service.name},inventory.final
set|cache.ttl|90
