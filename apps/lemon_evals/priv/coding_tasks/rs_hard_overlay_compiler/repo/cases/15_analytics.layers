# analytics service deployment: common base, regional routing, security policy
[base]
set|service.name|analytics.base
set|service.port|8080
set|service.enabled|false
list|service.tags|base,common,base
set|service.url|https://${service.name}:${service.port}
set|auth.token|initial-analytics
set|auth.header|Bearer ${auth.token}
set|cache.ttl|300
set|cache.note|base cache
set|cachex|prefix lookalike survives
set|meta.literal|$${service.name} $$ ${service.name}
[regional]
parents=base
append|service.tags|common,us-central,common
set|service.port|008600
set|cache.note|regional cache
[security]
parents=base
append|service.tags|secure,common
set|auth.token|rotated-analytics
delete|cache
[release]
parents=security,regional
append|service.tags|us-central,release,common
remove|service.tags|common
set|service.name|analytics.final
append|service.tags|release,${service.name},analytics.final
set|cache.ttl|90
