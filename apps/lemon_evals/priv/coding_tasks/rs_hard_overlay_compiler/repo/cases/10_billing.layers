# billing service deployment: common base, regional routing, security policy
[base]
set|service.name|billing.base
set|service.port|8080
set|service.enabled|true
list|service.tags|base,common,base
set|service.url|https://${service.name}:${service.port}
set|auth.token|initial-billing
set|auth.header|Bearer ${auth.token}
set|cache.ttl|300
set|cache.note|base cache
set|cachex|prefix lookalike survives
set|meta.literal|$${service.name} $$ ${service.name}
[regional]
parents=base
append|service.tags|common,us-east,common
set|service.port|008444
set|cache.note|regional cache
[security]
parents=base
append|service.tags|secure,common
set|auth.token|rotated-billing
delete|cache
[release]
parents=regional,security
append|service.tags|us-east,release,common
remove|service.tags|common
set|service.name|billing.final
append|service.tags|release,${service.name},billing.final
set|cache.ttl|90
