<main class="relative flex min-h-screen items-center justify-center overflow-hidden px-5 py-12">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_15%,rgba(139,92,246,0.14),transparent_42%)]"></div>

  <section class="relative w-full max-w-md overflow-hidden rounded-[2rem] border border-white/10 bg-slate-950/85 shadow-2xl shadow-black/50 backdrop-blur-xl">
    <div class="border-b border-white/10 bg-gradient-to-br from-violet-500/10 via-transparent to-amber-400/5 px-7 py-7 sm:px-9">
      <a href={~p"/"} class="text-xs font-bold uppercase tracking-[0.24em] text-amber-300/80">
        LemonSim Live
      </a>
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-violet-300/75">
        Private operator surface
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-white">Enter the control room</h1>
      <p class="mt-3 text-sm leading-6 text-slate-400">
        Use the administrator access key stored in your deployment secret manager.
      </p>
    </div>

    <div class="px-7 py-7 sm:px-9 sm:py-8">
      <%= if @auth_configured do %>
        <div :if={@error} class="mb-5 rounded-xl border border-red-400/25 bg-red-500/10 px-4 py-3 text-sm text-red-200" role="alert">
          That access key was not accepted.
        </div>

        <form action={~p"/admin/login"} method="post" class="space-y-5">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

          <div>
            <label for="admin-token" class="mb-2 block text-sm font-semibold text-slate-200">
              Administrator access key
            </label>
            <input
              id="admin-token"
              type="password"
              name="token"
              autocomplete="current-password"
              autocapitalize="none"
              spellcheck="false"
              autofocus
              required
              class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 font-mono text-sm text-white outline-none transition placeholder:text-slate-600 focus:border-violet-400/60 focus:ring-4 focus:ring-violet-500/10"
              placeholder="Paste your access key"
            />
          </div>

          <button type="submit" class="w-full rounded-xl bg-gradient-to-r from-violet-500 to-indigo-500 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-violet-950/40 transition hover:brightness-110 focus:outline-none focus:ring-4 focus:ring-violet-400/25">
            Sign in securely
          </button>
        </form>

        <div class="mt-6 flex items-center gap-3 border-t border-white/10 pt-5 text-xs leading-5 text-slate-500">
          <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.7)]"></span>
          The key is submitted in the request body, never the URL. This session expires after {@session_duration}.
        </div>
      <% else %>
        <div class="rounded-xl border border-amber-400/25 bg-amber-500/10 px-4 py-4 text-sm leading-6 text-amber-100">
          Admin authentication is not configured. Set a strong
          <code class="rounded bg-black/25 px-1.5 py-0.5 text-xs">LEMON_SIM_UI_ACCESS_TOKEN</code>
          and restart LemonSim before using the control room.
        </div>
      <% end %>

      <a href={~p"/"} class="mt-6 inline-flex text-sm font-medium text-slate-400 transition hover:text-white">
        ← Return to the public lobby
      </a>
    </div>
  </section>
</main>
