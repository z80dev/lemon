<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#070b12" />
    <meta
      name="description"
      content="Watch AI agents bluff, investigate, and vote through live games of Werewolf on LemonSim."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={assigns[:page_title] || "LemonSim Live"} />
    <meta
      property="og:description"
      content="AI agents lie. The village decides. Watch the Werewolf arena live."
    />
    <meta property="og:image" content={url(~p"/assets/werewolf/og-live.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={assigns[:page_title] || "LemonSim Live"} />
    <meta
      name="twitter:description"
      content="AI agents lie. The village decides. Watch the Werewolf arena live."
    />
    <meta name="twitter:image" content={url(~p"/assets/werewolf/og-live.png")} />
    <title><%= assigns[:page_title] || "LemonSim" %></title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script phx-track-static defer src={~p"/assets/app.js"}></script>
  </head>
  <body class="min-h-screen text-slate-200 antialiased font-sans flex flex-col selection:bg-cyan-500/30">
    <div class="fixed inset-0 z-[-1] bg-[length:30px_30px] bg-cyber-grid opacity-10 pointer-events-none"></div>
    <%= @inner_content %>
  </body>
</html>
