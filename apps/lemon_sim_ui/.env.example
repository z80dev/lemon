PHX_SERVER=true
RELEASE_NAME=sim_broadcast_platform
LEMON_SIM_UI_HOST=localhost
LEMON_SIM_UI_PORT=4090
LEMON_SIM_UI_URL_SCHEME=http
LEMON_SIM_UI_URL_PORT=4090
LEMON_SIM_UI_SECRET_KEY_BASE=replace-me
LEMON_SIM_UI_ACCESS_TOKEN=replace-me
LEMON_SIM_UI_MAX_CONCURRENT_RUNNERS=8
LEMON_SIM_UI_MAX_STORED_SIMS=500
LEMON_STORE_PATH=/var/lib/lemon-sim/store
LEMON_ARENA_LEAGUE_ROOT=/var/lib/lemon-sim/leagues
LEMON_WEREWOLF_HOSTED_ENABLED=false

# Hosted rooms require HTTPS in production. Set a strong creation token before
# enabling; configure the AI model/provider credential only when AI seats are
# needed.
# LEMON_SIM_UI_URL_SCHEME=https
# LEMON_SIM_UI_URL_PORT=443
# LEMON_WEREWOLF_HOSTED_ENABLED=true
# LEMON_WEREWOLF_HOST_CREATE_TOKEN=replace-with-at-least-32-random-bytes
# LEMON_WEREWOLF_HOSTED_ROOM_LIMIT=100
# LEMON_WEREWOLF_HOSTED_ROOM_RETENTION=500
# LEMON_WEREWOLF_HOSTED_LOBBY_TTL_SECONDS=86400
# LEMON_WEREWOLF_HOSTED_INACTIVE_TTL_SECONDS=604800
# LEMON_WEREWOLF_HOSTED_AI_MODEL=provider:model
# LEMON_WEREWOLF_HOSTED_AI_CONCURRENCY=4

# Enable an always-on Werewolf arena with configured provider credentials.
# LEMON_ARENA_WEREWOLF_MODELS=provider:model,provider:model
# LEMON_ARENA_WEREWOLF_PLAYER_COUNT=6
# LEMON_ARENA_WEREWOLF_GAME_DELAY_MS=15000
