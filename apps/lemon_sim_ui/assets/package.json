{
  "name": "lemon-sim-ui-assets",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -c tailwind.config.js -i css/app.css -o ../priv/static/assets/app.css --minify",
    "build:js": "esbuild js/app.js --bundle --target=es2020 --format=iife --minify --outfile=../priv/static/assets/app.js",
    "smoke:werewolf": "node scripts/werewolf-smoke.mjs",
    "smoke:hosted-werewolf": "node scripts/hosted-werewolf-smoke.mjs"
  },
  "dependencies": {
    "phoenix": "1.7.24",
    "phoenix_live_view": "1.2.6"
  },
  "devDependencies": {
    "esbuild": "0.25.6",
    "playwright-core": "1.58.1",
    "tailwindcss": "3.4.17"
  }
}
