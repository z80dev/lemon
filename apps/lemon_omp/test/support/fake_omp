#!/bin/sh
# Test double for `omp --mode rpc` (newline-delimited JSON over stdio).
#
# LemonOmp spawns it as `fake_omp --mode rpc --cwd DIR [--session-dir DIR]
# [--model M] [--thinking L] [--approval-mode A] [--resume ID]`. Lemon strips LEMON_* variables from the
# child, so behaviour is selected per workspace instead:
#
#   DIR/.fake_omp_mode   startup mode (default: $FAKE_OMP_MODE, else normal)
#   DIR/.fake_omp.pid    written with this process id
#   DIR/.fake_omp.child  pid of the background child (ignore-term only)
#   DIR/.fake_omp.log    every stdin line received, one per line
#   DIR/.fake_omp.args   the argv it was started with
#
# Modes:
#   normal       ready, then answers commands (see prompt keywords below);
#                exits on stdin EOF like omp
#   hang         ready, then never answers anything
#   crash-start  ready, ~3 KiB of stderr, exit 3
#   slow-start   never sends ready; exits on stdin EOF
#   garbage      malformed and oversized (> 4 MiB) lines after ready, then normal
#   ignore-eof   normal, but keeps running after stdin EOF (SIGTERM kills it)
#   ignore-term  ignores SIGTERM, starts a TERM-ignoring child, keeps running
#                after stdin EOF (only SIGKILL stops either)
#
# Prompt keywords (case-sensitive, normal-like modes):
#   HOLD        start the turn and keep it open (steer completes it, abort aborts it)
#   MUTE        start the turn, then ignore every later command
#   CRASH       start the turn, write to stderr, exit 3
#   UI_REQUEST  start the turn, send blocking/non-blocking UI and host requests;
#               the turn completes once the confirm reply arrives
#   BIGTEXT     complete the turn with a ~100 KB assistant text
#   LATE_ACK    finish the whole turn before acknowledging the prompt
#   APPROVAL    wait for an Approve/Deny tool approval
#   APPROVAL_TIMEOUT  approval with a short omp dialog timeout
#   APPROVAL_CANCEL   cancel approval when a follow_up arrives
#   APPROVAL_CANCEL_NOW  cancel immediately (registration race)
#   APPROVAL_EXIT  exit when a follow_up arrives, leaving the approval pending
#   OTHER_UI    emit input/editor/non-approval selects, all declined
#   ACK_GATE    wait for DIR/.fake_omp_release before acknowledging the prompt
#   REJECT      reject the prompt without starting a turn
#   WRITE_FILE  create worker.txt in cwd before completing the turn
#   SUBAGENTS   realistic progress/lifecycle for a task child (HOLD keeps it running)
#   anything else completes the turn at once.
#
# Redirect message keywords:
#   REJECT          reject abort_and_prompt without aborting
#   PROMPT_FAIL     acknowledge, then fail the asynchronous prompt with the same id
#   LATE_REDIRECT   complete the new turn before acknowledging abort_and_prompt
#   REDIRECT_GATE   after abort events, wait for .fake_omp_redirect_ack; acknowledge,
#                   wait for .fake_omp_redirect_start; start the new turn,
#                   wait for .fake_omp_redirect_finish; complete it
#
# Configure controls:
#   DIR/.fake_omp_configure_gate  wait for .fake_omp_configure_release before model ack
#   DIR/.fake_omp_thinking_mode   reject, mute or exit when setting thinking
#   DIR/.fake_omp_state_mode      reject, mute or gate (.fake_omp_state_release)
#   fake/no-thinking              model with no thinking level; fake/clamped clamps high to low
#   fake/REJECT                   reject set_model

if [ "$1" = models ]; then
  [ -z "$FAKE_OMP_MODELS_COUNT" ] || printf 'call\n' >>"$FAKE_OMP_MODELS_COUNT"
  case "$FAKE_OMP_MODELS_MODE" in
    malformed) printf 'not json\n'; exit 0 ;;
    fail) exit 7 ;;
    timeout) exec sleep 5 ;;
  esac
  [ -z "$LEMON_CATALOG_SECRET" ] || exit 9
  printf '{"models":['
  i=0
  while [ "$i" -lt 205 ]; do
    [ "$i" -eq 0 ] || printf ','
    printf '{"provider":"paid","id":"m%s","selector":"paid/m%s","name":"Paid %s","contextWindow":1000,"reasoning":true,"cost":{"input":2,"output":3}}' "$i" "$i" "$i"
    i=$((i + 1))
  done
  printf ',{"provider":"free","id":"z","selector":"free/z","name":"\\u001b[31mZed","contextWindow":2000,"cost":{"input":0,"output":0}},{"provider":"free","id":"a","selector":"free/a","name":"Alpha","contextWindow":3000,"cost":{"input":0,"output":0}},{"provider":"cheap","id":"c","selector":"cheap/c","name":"Cheap","cost":{"input":0.1,"output":0.2}}]}\n'
  exit 0
fi

all_args="$*"
cwd=
resume=
provider=fake
model_id=fake-model
thinking=low
while [ $# -gt 0 ]; do
  case "$1" in
    --version)
      echo "omp 0.0.0-fake (test double)"
      exit 0
      ;;
    --cwd)
      cwd=$2
      shift
      ;;
    --session-dir)
      [ -d "$2" ] || exit 8
      shift
      ;;
    --model)
      provider=${2%%/*}
      model_id=${2#*/}
      shift
      ;;
    --thinking)
      thinking=$2
      shift
      ;;
    --resume)
      resume=$2
      shift
      ;;
  esac
  [ $# -gt 0 ] && shift
done

[ -n "$cwd" ] || cwd=$(pwd)
mode=${FAKE_OMP_MODE:-normal}
[ -f "$cwd/.fake_omp_mode" ] && mode=$(cat "$cwd/.fake_omp_mode")
log="$cwd/.fake_omp.log"
echo $$ >"$cwd/.fake_omp.pid"
printf '%s\n' "$all_args" >"$cwd/.fake_omp.args"
session_id=${resume:-fake-session-0001}
turns_done=0
held=
muted=0
approval=
approval_action=

emit() {
  printf '%s\n' "$1"
}

field() {
  printf '%s' "$line" | sed -n 's/.*"'"$1"'":"\([^"]*\)".*/\1/p'
}

respond() {
  if [ -n "$3" ]; then
    emit '{"type":"response","id":"'"$1"'","command":"'"$2"'","success":true,"data":'"$3"'}'
  else
    emit '{"type":"response","id":"'"$1"'","command":"'"$2"'","success":true}'
  fi
}

start_turn() {
  emit '{"type":"agent_start"}'
  emit '{"type":"turn_start"}'
  emit '{"type":"tool_execution_start","toolCallId":"call_todo_1","toolName":"todo","intent":"Tracking tasks"}'
}

complete_turn() {
  text=$2
  emit '{"type":"tool_execution_end","toolCallId":"call_todo_1","toolName":"todo","isError":false,"result":{"content":[{"type":"text","text":"ok"}],"details":{"phases":[{"name":"Tasks","tasks":[{"content":"Read README.md","status":"completed"},{"content":"Write tests","status":"in_progress"}]}]}}}'
  emit '{"type":"message_end","message":{"role":"assistant","provider":"fake","model":"fake-model","stopReason":"stop","content":[{"type":"text","text":"'"$text"'"}],"usage":{"input":100,"output":20,"cacheRead":50,"cacheWrite":0,"totalTokens":170,"cost":{"total":0.0012}}}}'
  emit '{"type":"agent_end","messages":[],"isTerminal":true}'
  emit '{"type":"prompt_result","id":"'"$1"'","agentInvoked":true,"status":"completed","sessionSettled":false}'
  emit '{"type":"session_settled"}'
  turns_done=$((turns_done + 1))
}

subagent_started() {
  emit '{"type":"subagent_lifecycle","payload":{"id":"child-1","index":0,"agent":"explore\u001b[31m","agentSource":"builtin","description":"Tiny child","status":"started","parentToolCallId":"task-1","sessionFile":"/private/child.jsonl"}}'
  emit '{"type":"subagent_progress","payload":{"index":0,"agent":"explore\u001b[31m","agentSource":"builtin","task":"Create sub.txt","parentToolCallId":"task-1","sessionFile":"/private/child.jsonl","progress":{"index":0,"id":"child-1","agent":"explore","agentSource":"builtin","status":"running","task":"Create sub.txt","description":"Tiny child","lastIntent":"Create \u202esub.txt","currentTool":"write\u001b[0m","currentToolArgs":"sub.txt","currentToolStartMs":1000,"recentTools":[{"tool":"read\u0000","args":"README.md","endMs":999}],"recentOutput":["latest output\u202e","earlier output"],"toolCount":2,"requests":1,"tokens":120,"contextTokens":200,"contextWindow":10000,"cost":0.001,"durationMs":42,"resolvedModel":"fake/child:off","resolvedModelIdentity":"fake/child"}}}'
}

subagent_finished() {
  emit '{"type":"subagent_progress","payload":{"index":0,"agent":"explore","agentSource":"builtin","task":"Create sub.txt","parentToolCallId":"task-1","progress":{"index":0,"id":"child-1","agent":"explore","agentSource":"builtin","status":"completed","task":"Create sub.txt","recentTools":[{"tool":"write","args":"sub.txt","endMs":1100}],"recentOutput":["Created sub.txt\u202e"],"toolCount":2,"requests":2,"tokens":150,"cost":0.002,"durationMs":100,"resolvedModelIdentity":"fake/child"}}}'
  emit '{"type":"subagent_lifecycle","payload":{"id":"child-1","index":0,"agent":"explore","agentSource":"builtin","status":"completed","parentToolCallId":"task-1","sessionFile":"/private/child.jsonl"}}'
}

subagent_messages() {
  # Shape matches RpcSubagentMessagesResult, including cursor and raw session path.
  printf '{"type":"response","id":"%s","command":"get_subagent_messages","success":true,"data":{"sessionFile":"/private/child.jsonl","fromByte":0,"nextByte":12345,"reset":false,"entries":[],"messages":[' "$id"
  padding=$(head -c 2500 /dev/zero | tr '\0' 'x')
  n=1
  while [ "$n" -le 60 ]; do
    [ "$n" -eq 1 ] || printf ','
    if [ "$n" -eq 1 ]; then
      printf '{"role":"user","content":"Create sub.txt"}'
    elif [ "$n" -eq 60 ]; then
      printf '{"role":"toolResult","toolName":"write\\u001b[31m\\u202e","content":[{"type":"text","text":"message %s\\u001b[31m\\u202e %s"}]}' "$n" "$padding"
    else
      printf '{"role":"assistant","content":[{"type":"text","text":"message %s\\u001b[31m\\u202e %s"},{"type":"thinking","thinking":"not exposed"}]}' "$n" "$padding"
    fi
    n=$((n + 1))
  done
  printf ']}}\n'
}

abort_turn() {
  emit '{"type":"agent_end","messages":[],"isTerminal":true}'
  emit '{"type":"prompt_result","id":"'"$1"'","agentInvoked":true,"status":"aborted","sessionSettled":true}'
}

stats() {
  if [ "$turns_done" -gt 0 ]; then
    echo '{"sessionId":"'"$session_id"'","tokens":{"input":111,"output":22,"cacheRead":55,"cacheWrite":1,"total":189},"cost":0.5,"contextUsage":{"percent":12.345}}'
  else
    echo '{"sessionId":"'"$session_id"'","tokens":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0},"cost":0}'
  fi
}

on_eof() {
  case "$mode" in
    ignore-eof | ignore-term) exec sleep 600 ;;
    *) exit 0 ;;
  esac
}

drain() {
  while IFS= read -r line; do
    printf '%s\n' "$line" >>"$log"
  done
  exit 0
}

case "$mode" in
  slow-start)
    drain
    ;;
  hang)
    emit '{"type":"ready","protocolVersion":1}'
    drain
    ;;
  crash-start)
    emit '{"type":"ready","protocolVersion":1}'
    i=0
    while [ $i -lt 40 ]; do
      echo "fake omp: noise line $i ................................................................" >&2
      i=$((i + 1))
    done
    echo "fake omp: fatal: provider configuration is invalid" >&2
    exit 3
    ;;
  ignore-term)
    trap '' TERM
    sleep 600 </dev/null >/dev/null 2>&1 &
    echo $! >"$cwd/.fake_omp.child"
    ;;
esac

emit '{"type":"ready","protocolVersion":1,"supportedProtocolVersions":[1,2],"maxFrameBytes":1048576}'

if [ "$mode" = garbage ]; then
  emit 'this is not json'
  emit '[1,2,3]'
  emit '{"no":"type"}'
  printf '{"type":"message_update","pad":"'
  head -c 4300000 /dev/zero | tr '\0' 'a'
  printf '"}\n'
  emit '{"type":"extension_ui_request","method":"confirm"}'
fi

while IFS= read -r line; do
  printf '%s\n' "$line" >>"$log"
  [ "$muted" = 1 ] && continue
  type=$(field type)
  id=$(field id)

  case "$type" in
    prompt)
      msg=$(field message)
      case "$msg" in
        *REJECT*)
          emit '{"type":"response","id":"'"$id"'","command":"prompt","success":false,"error":"Task refused"}'
          continue
          ;;
        *ACK_GATE*)
          while [ ! -f "$cwd/.fake_omp_release" ]; do sleep 0.02; done
          ;;
        *LATE_ACK*)
          # omp may stream and finish a turn before acknowledging its prompt.
          start_turn
          complete_turn "$id" "Done early"
          respond "$id" prompt '{"agentInvoked":true}'
          continue
          ;;
      esac
      respond "$id" prompt '{"agentInvoked":true}'
      start_turn

      case "$msg" in
        *SUBAGENTS*)
          subagent_started
          case "$msg" in
            *HOLD*) held=$id ;;
            *)
              subagent_finished
              complete_turn "$id" "Child finished"
              ;;
          esac
          ;;
        *WRITE_FILE*)
          printf 'worker change\n' >"$cwd/worker.txt"
          complete_turn "$id" "Wrote worker.txt"
          ;;
        *APPROVAL*)
          held=$id
          approval=ui-approval-1
          approval_action=$msg
          timeout=
          case "$msg" in *APPROVAL_TIMEOUT*) timeout=',"timeout":100' ;; esac
          emit '{"type":"extension_ui_request","id":"ui-approval-1","method":"select","title":"Allow tool: bash\nCommand: printf safe\u001b[31m\u202e","options":["Approve","Deny"]'"$timeout"'}'
          case "$msg" in
            *APPROVAL_CANCEL_NOW*)
              emit '{"type":"extension_ui_request","id":"ui-cancel-1","method":"cancel","targetId":"ui-approval-1"}'
              approval=
              ;;
          esac
          ;;
        *OTHER_UI*)
          held=$id
          emit '{"type":"extension_ui_request","id":"ui-input","method":"input","title":"Input?"}'
          emit '{"type":"extension_ui_request","id":"ui-editor","method":"editor","title":"Edit?"}'
          emit '{"type":"extension_ui_request","id":"ui-select","method":"select","title":"Choose","options":["Deny","Approve"]}'
          ;;
        *HOLD*)
          held=$id
          ;;
        *MUTE*)
          muted=1
          ;;
        *CRASH*)
          echo "fake omp: fatal crash during turn" >&2
          exit 3
          ;;
        *UI_REQUEST*)
          held=$id
          emit '{"type":"extension_ui_request","id":"ui-confirm-1","method":"confirm","title":"Allow?","message":"Run rm -rf?"}'
          emit '{"type":"extension_ui_request","id":"ui-notify-1","method":"notify","message":"fyi"}'
          emit '{"type":"host_tool_call","id":"host-1","toolName":"evil","arguments":{}}'
          ;;
        *BIGTEXT*)
          big=$(head -c 100000 /dev/zero | tr '\0' 'x')
          complete_turn "$id" "${big}END"
          ;;
        *)
          complete_turn "$id" "Done: $msg"
          ;;
      esac
      ;;
    steer)
      respond "$id" steer
      if [ -n "$held" ]; then
        complete_turn "$held" "Steered: $(field message)"
        held=
      fi
      ;;
    follow_up)
      respond "$id" follow_up
      case "$approval_action" in
        *APPROVAL_CANCEL*)
          emit '{"type":"extension_ui_request","id":"ui-cancel-1","method":"cancel","targetId":"ui-approval-1"}'
          approval=
          ;;
        *APPROVAL_EXIT*) exit 3 ;;
      esac
      ;;
    abort_and_prompt)
      msg=$(field message)
      case "$msg" in
        *REJECT*)
          emit '{"type":"response","id":"'"$id"'","command":"abort_and_prompt","success":false,"error":"Redirect refused"}'
          continue
          ;;
      esac
      if [ -n "$held" ]; then
        abort_turn "$held"
        held=
      fi
      case "$msg" in
        *REDIRECT_GATE*)
          while [ ! -f "$cwd/.fake_omp_redirect_ack" ]; do sleep 0.02; done
          ;;
        *LATE_REDIRECT*)
          start_turn
          complete_turn "$id" "Redirected early"
          respond "$id" abort_and_prompt
          continue
          ;;
      esac
      respond "$id" abort_and_prompt
      case "$msg" in
        *PROMPT_FAIL*)
          case "$msg" in *PROMPT_FAIL_STARTED*) start_turn ;; esac
          emit '{"type":"response","id":"'"$id"'","command":"abort_and_prompt","success":false,"error":"Redirect prompt failed\u001b[31m"}'
          continue
          ;;
        *REDIRECT_GATE*)
          while [ ! -f "$cwd/.fake_omp_redirect_start" ]; do sleep 0.02; done
          ;;
      esac
      start_turn
      case "$msg" in
        *REDIRECT_GATE*)
          while [ ! -f "$cwd/.fake_omp_redirect_finish" ]; do sleep 0.02; done
          ;;
      esac
      complete_turn "$id" "Redirected: $msg"
      ;;
    abort)
      respond "$id" abort
      if [ -n "$held" ]; then
        if [ -n "$approval" ]; then
          emit '{"type":"extension_ui_request","id":"ui-cancel-abort","method":"cancel","targetId":"'"$approval"'"}'
          approval=
        fi
        abort_turn "$held"
        held=
      fi
      ;;
    extension_ui_response)
      if [ -n "$held" ]; then
        approval=
        complete_turn "$held" "UI answered"
        held=
      fi
      ;;
    get_session_stats)
      respond "$id" get_session_stats "$(stats)"
      ;;
    get_subagent_messages)
      case "$(field subagentId)" in
        child-1) subagent_messages ;;
        silent) ;;
        exit) exit 3 ;;
        *)
          emit '{"type":"response","id":"'"$id"'","command":"get_subagent_messages","success":false,"error":"Unknown subagent\u001b[31m\u202e"}'
          ;;
      esac
      ;;
    set_model)
      next_model=$(field modelId)
      case "$next_model" in
        REJECT)
          emit '{"type":"response","id":"'"$id"'","command":"set_model","success":false,"error":"Model refused\u001b[31m\u202e"}'
          continue
          ;;
      esac
      provider=$(field provider)
      model_id=$next_model
      case "$model_id" in
        no-thinking) thinking= ;;
        clamped) thinking=low ;;
      esac
      emit '{"type":"model_changed"}'
      if [ -f "$cwd/.fake_omp_configure_gate" ]; then
        while [ ! -f "$cwd/.fake_omp_configure_release" ]; do sleep 0.02; done
      fi
      respond "$id" set_model '{"provider":"'"$provider"'","id":"'"$model_id"'"}'
      ;;
    set_thinking_level)
      thinking_mode=
      [ ! -f "$cwd/.fake_omp_thinking_mode" ] || thinking_mode=$(cat "$cwd/.fake_omp_thinking_mode")
      case "$thinking_mode" in
        reject)
          emit '{"type":"response","id":"'"$id"'","command":"set_thinking_level","success":false,"error":"Thinking refused"}'
          continue
          ;;
        mute) continue ;;
        exit) exit 3 ;;
      esac
      thinking=$(field level)
      case "$model_id" in
        no-thinking) thinking= ;;
        clamped) thinking=low ;;
      esac
      emit '{"type":"thinking_level_changed","thinkingLevel":"'"$thinking"'"}'
      respond "$id" set_thinking_level
      ;;
    get_state)
      state_mode=
      [ ! -f "$cwd/.fake_omp_state_mode" ] || state_mode=$(cat "$cwd/.fake_omp_state_mode")
      case "$state_mode" in
        reject)
          emit '{"type":"response","id":"'"$id"'","command":"get_state","success":false,"error":"State refused"}'
          continue
          ;;
        mute) continue ;;
        gate)
          while [ ! -f "$cwd/.fake_omp_state_release" ]; do sleep 0.02; done
          ;;
      esac
      thinking_json=
      [ -z "$thinking" ] || thinking_json='"thinkingLevel":"'"$thinking"'",'
      respond "$id" get_state '{"sessionId":"'"$session_id"'","sessionName":"Resumed fake session",'"$thinking_json"'"model":{"provider":"'"$provider"'","id":"'"$model_id"'"},"todoPhases":[{"name":"Earlier","tasks":[{"content":"Carry over","status":"pending"}]}]}'
      ;;
    host_tool_result | host_uri_result) ;;
    *)
      [ -n "$id" ] && respond "$id" "$type"
      ;;
  esac
done

on_eof
