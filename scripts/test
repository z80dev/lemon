#!/usr/bin/env bash
# Canonical Lemon repo-level test runner.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LANE="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

SCRUB_CREDENTIAL_ENV_VARS=(
  AI21_API_KEY
  ANTHROPIC_API_KEY
  ANTHROPIC_TOKEN
  AWS_ACCESS_KEY_ID
  AWS_PROFILE
  AWS_SECRET_ACCESS_KEY
  AWS_SESSION_TOKEN
  AZURE_OPENAI_API_KEY
  BROWSERBASE_API_KEY
  BROWSERBASE_PROJECT_ID
  BROWSER_USE_API_KEY
  BRAVE_API_KEY
  CAMOFOX_API_KEY
  CAMOFOX_URL
  CHATGPT_TOKEN
  CLAUDE_CODE_OAUTH_TOKEN
  DEEPGRAM_API_KEY
  DINGTALK_BOT_TOKEN
  DISCORD_BOT_TOKEN
  ELEVENLABS_API_KEY
  EXA_API_KEY
  FEISHU_APP_SECRET
  FEISHU_BOT_TOKEN
  FIREWORKS_API_KEY
  GEMINI_API_KEY
  GH_TOKEN
  GITHUB_COPILOT_API_KEY
  GITHUB_TOKEN
  GOOGLE_API_KEY
  GOOGLE_APPLICATION_CREDENTIALS
  GOOGLE_APPLICATION_CREDENTIALS_JSON
  GOOGLE_CLOUD_PROJECT
  GOOGLE_CLOUD_PROJECT_ID
  GOOGLE_GENERATIVE_AI_API_KEY
  GOOGLE_GEMINI_CLI_API_KEY
  GROQ_API_KEY
  KIMI_API_KEY
  LEMON_EVAL_API_KEY
  LEMON_EVAL_API_KEY_SECRET
  LEMON_SECRETS_MASTER_KEY
  MINIMAX_API_KEY
  MISTRAL_API_KEY
  MOONSHOT_API_KEY
  NOUS_API_KEY
  OPENAI_API_KEY
  OPENAI_CODEX_API_KEY
  OPENCODE_API_KEY
  OPENROUTER_API_KEY
  INTEGRATION_API_KEY
  INTEGRATION_API_KEY_SECRET
  SLACK_APP_TOKEN
  SLACK_BOT_TOKEN
  TELEGRAM_BOT_TOKEN
  TWILIO_AUTH_TOKEN
  XAI_API_KEY
  XMTP_WALLET_KEY
  ZAI_API_KEY
)

usage() {
  cat <<'EOF'
Usage: scripts/test <lane> [args]

Canonical test lanes:
  fast       CI test lane: compile with warnings as errors, then ExUnit excluding integration (no coverage)
  changed    Affected apps + data readers: [--base REF] [--focused] [--narrow] [mix test args...]
             --focused is a quick pre-check only, not a substitute for the app run; --narrow limits
             downstream apps to test files naming a module defined in a changed file
  premerge   Stop-on-failure diff checks: [--base REF] (default: origin/main); runs `changed --narrow`:
             changed apps whole, downstream apps only tests naming a changed module
  quality    CI check lane: compile -Werror, format check, credo, skip-tag guard, shellcheck, launcher
             script tests, changelog guard, selector self-test, skill lint, mix lemon.quality, focused quality tests;
             [--base REF] (PR CI) limits format/credo to files changed since REF unless the diff is full scope
  clients    CI client lane: tui (typecheck, lint, bun test) and lemon-browser-node (typecheck, lint, build, vitest)
  coverage   Nightly lane: ExUnit excluding integration with --cover (per-app coverage thresholds)
  eval-fast  Small deterministic eval harness run: mix lemon.eval --iterations ${LEMON_EVAL_ITERATIONS:-3}
  live-eval  Opt-in provider-backed eval run: mix lemon.eval --live-model --iterations ${LEMON_EVAL_ITERATIONS:-3}
  smoke      Product-smoke pointer: run scripts/product_smoke_local locally; CI definition is .github/workflows/product-smoke.yml
  all        Useful local aggregate: fast, quality, eval-fast, smoke
  path       Pass-through to mix test for paths or ExUnit args: scripts/test path apps/foo/test --seed 1
  help       Show this message

Runner defaults:
  - Runs from the repository root.
  - Sets MIX_ENV=test for BEAM test lanes unless a lane intentionally overrides it.
  - Creates per-invocation temp LEMON_STORE_PATH and LEMON_TEST_TMPDIR when unset.
  - BEAM test lanes scrub ambient provider/platform credentials unless LEMON_TEST_ALLOW_LIVE_CREDENTIALS=1.
  - Client lanes install with npm ci or bun install --frozen-lockfile by default; set LEMON_TEST_REUSE_NODE_MODULES=1 to reuse existing installs.
EOF
}

ensure_repo_root() {
  cd "$ROOT"
}

setup_test_env() {
  export MIX_ENV="${MIX_ENV:-test}"
  scrub_live_credentials
  setup_tmp_env
}

setup_live_eval_env() {
  export MIX_ENV="${MIX_ENV:-test}"
  setup_tmp_env
}

resolve_live_eval_secret_ref() {
  local target_env="$1"
  local secret_env="$2"

  if [ -n "${!target_env:-}" ] || [ -z "${!secret_env:-}" ]; then
    return 0
  fi

  local resolved
  local secret_file
  secret_file="$(mktemp "${TMPDIR:-/tmp}/lemon-live-eval-secret.XXXXXX")"

  if ! LEMON_SECRET_NAME="${!secret_env}" LEMON_SECRET_OUTPUT="$secret_file" MIX_ENV=dev mix run --no-start -e '
      Logger.configure(level: :emergency)
      Logger.remove_backend(:console)

      {:ok, _} = Application.ensure_all_started(:lemon_core)
      name = System.fetch_env!("LEMON_SECRET_NAME")
      output = System.fetch_env!("LEMON_SECRET_OUTPUT")

      case LemonCore.Secrets.fetch_value(name) do
        value when is_binary(value) and value != "" ->
          File.write!(output, value)

        _ ->
          System.halt(66)
      end
    ' >/dev/null 2>&1; then
    rm -f "$secret_file"
    cat >&2 <<EOF
scripts/test live-eval could not resolve $secret_env from Lemon secrets.
EOF
    exit 66
  fi

  resolved="$(cat "$secret_file")"
  rm -f "$secret_file"

  export "$target_env=$resolved"
}

setup_tmp_env() {
  if [ -z "${LEMON_TEST_TMPDIR:-}" ]; then
    LEMON_TEST_TMPDIR="$(mktemp -d "${TMPDIR:-/tmp}/lemon-test.XXXXXX")"
    export LEMON_TEST_TMPDIR
    trap 'rm -rf "$LEMON_TEST_TMPDIR"' EXIT
  fi

  export LEMON_STORE_PATH="${LEMON_STORE_PATH:-$LEMON_TEST_TMPDIR/store}"
  mkdir -p "$LEMON_STORE_PATH"
}

scrub_live_credentials() {
  case "${LEMON_TEST_ALLOW_LIVE_CREDENTIALS:-}" in
    1|true|TRUE|yes|YES) return 0 ;;
  esac

  local key
  for key in "${SCRUB_CREDENTIAL_ENV_VARS[@]}"; do
    unset "$key"
  done
}

# lemon_control_plane's TUI wire tests run clients/tui scripts with
# `bun --no-install`, so a fresh worktree needs the lockfile-pinned install.
ensure_tui_deps() {
  if [ ! -d clients/tui/node_modules ] && command -v bun >/dev/null 2>&1; then
    (cd clients/tui && bun install --frozen-lockfile)
  fi
}

run_fast() {
  ensure_repo_root
  setup_test_env
  ensure_tui_deps
  mix compile --warnings-as-errors
  mix test --exclude integration "$@"
}

run_coverage() {
  ensure_repo_root
  setup_test_env
  mix compile --warnings-as-errors
  mix test --exclude integration --cover "$@"
}

# ExUnit skip tags hide tests forever. Tests that need an optional host tool
# use a named tag the app's test_helper excludes when the tool is missing.
check_skipped_tests() {
  local pattern='@(module|describe)?tag[[:space:]]+(:skip([^_[:alnum:]]|$)|skip:)'
  if git grep -nE "$pattern" -- 'apps/*.exs'; then
    echo "error: found skipped ExUnit tests (listed above). Fix and re-enable them, or tag them for a conditional exclude." >&2
    return 1
  fi
}

# --shell=sh on install.sh is load-bearing: the curl one-liner runs under
# whatever /bin/sh the user has, so the script must stay POSIX.
run_shellcheck() {
  if ! command -v shellcheck >/dev/null 2>&1; then
    echo "error: shellcheck is required for scripts/test quality (brew install shellcheck / apt-get install shellcheck)" >&2
    return 1
  fi
  shellcheck --shell=sh install.sh
  shellcheck scripts/verify_install_script
  shellcheck rel/overlays/bin/lemon
  shellcheck bin/lemonup scripts/test_lemonup.sh
  shellcheck scripts/test
}

# `quality --base REF` (pull requests) formats and credo-checks only the files
# changed since REF unless the diff selects full scope (formatter/Credo config,
# mix files, scripts, ...). Credo's cross-file checks (Consistency.*,
# DuplicatedCode) then only compare changed files, so main's full run remains
# the authority for those.
run_quality() {
  ensure_repo_root
  setup_test_env
  local base=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base)
        if [ "$#" -lt 2 ]; then
          echo "error: --base requires a ref" >&2
          return 64
        fi
        base="$2"; shift 2 ;;
      *) echo "error: quality accepts only --base REF" >&2; return 64 ;;
    esac
  done
  mix compile --warnings-as-errors
  if [ -n "$base" ]; then
    collect_changed_files "$base"
  fi
  if [ -z "$base" ] || [ "$CHANGED_SCOPE" = "full" ]; then
    mix format --check-formatted
    mix credo
  else
    echo "quality: format/credo on ${#CHANGED_FORMAT[@]}/${#CHANGED_ELIXIR[@]} changed files since $base"
    if [ "${#CHANGED_FORMAT[@]}" -gt 0 ]; then mix format --check-formatted "${CHANGED_FORMAT[@]}"; fi
    if [ "${#CHANGED_ELIXIR[@]}" -gt 0 ]; then mix credo "${CHANGED_ELIXIR[@]}"; fi
  fi
  check_skipped_tests
  scripts/check_changelog
  python3 scripts/test_changed_tests.py
  run_shellcheck
  bash scripts/test_lemon_tui_auth.sh
  bash scripts/test_lemon_launcher_reuse.sh
  bash scripts/test_lemonup.sh
  mix lemon.skill.lint
  mix lemon.quality
  mix test apps/lemon_core/test/lemon_core/quality apps/lemon_evals/test/lemon_evals/harness_test.exs
}

run_npm_ci_if_needed() {
  local dir="$1"
  if [ "${LEMON_TEST_REUSE_NODE_MODULES:-}" != "1" ] || [ ! -d "$dir/node_modules" ]; then
    (cd "$dir" && npm ci)
  fi
}

run_bun_install_if_needed() {
  local dir="$1"
  if [ "${LEMON_TEST_REUSE_NODE_MODULES:-}" != "1" ] || [ ! -d "$dir/node_modules" ]; then
    (cd "$dir" && bun install --frozen-lockfile)
  fi
}

run_clients() {
  ensure_repo_root

  run_bun_install_if_needed clients/tui
  (cd clients/tui && bun run check && bun run lint && bun test)

  run_npm_ci_if_needed clients/lemon-browser-node
  (cd clients/lemon-browser-node && npm run typecheck && npm run lint && npm run build && npm test)
}

run_eval_fast() {
  ensure_repo_root
  setup_test_env
  mix lemon.eval --iterations "${LEMON_EVAL_ITERATIONS:-3}" "$@"
}

run_live_eval() {
  ensure_repo_root
  resolve_live_eval_secret_ref LEMON_EVAL_API_KEY LEMON_EVAL_API_KEY_SECRET
  resolve_live_eval_secret_ref INTEGRATION_API_KEY INTEGRATION_API_KEY_SECRET
  setup_live_eval_env

  if [ -z "${LEMON_EVAL_API_KEY:-}" ] &&
     [ -z "${LEMON_EVAL_API_KEY_SECRET:-}" ] &&
     [ -z "${INTEGRATION_API_KEY:-}" ] &&
     [ -z "${INTEGRATION_API_KEY_SECRET:-}" ] &&
     [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    cat >&2 <<'EOF'
scripts/test live-eval requires a live model credential.

Set one of:
  LEMON_EVAL_API_KEY
  LEMON_EVAL_API_KEY_SECRET
  INTEGRATION_API_KEY
  INTEGRATION_API_KEY_SECRET
  ANTHROPIC_API_KEY

Optional live eval configuration:
  LEMON_EVAL_PROVIDER
  LEMON_EVAL_MODEL
  LEMON_EVAL_BASE_URL
  LEMON_EVAL_API_TYPE
EOF
    exit 66
  fi

  mix lemon.eval --live-model --iterations "${LEMON_EVAL_ITERATIONS:-3}" "$@"
}

run_smoke() {
  ensure_repo_root
  cat <<'EOF'
The product smoke has a local, isolated runner that mirrors the CI probe
sequence (fixture config, boot, control-plane HTTP/WebSocket health, echo
agent run, web health) without touching a running instance or ~/.lemon:

  scripts/product_smoke_local             # dev boot via bin/lemon (fast)
  scripts/product_smoke_local --release   # build + boot the prod release like CI

Canonical CI smoke definition: .github/workflows/product-smoke.yml
(run in CI via: gh workflow run product-smoke.yml)
EOF
}

run_path() {
  ensure_repo_root
  setup_test_env
  if [ "$#" -eq 0 ]; then
    echo "scripts/test path requires at least one mix test path or argument" >&2
    exit 64
  fi
  mix test "$@"
}

# Keep path transport NUL-delimited: local filenames may contain spaces.
selection_paths() {
  python3 -c 'import json, os, sys
for path in json.load(open(sys.argv[1]))[sys.argv[2]]:
    sys.stdout.buffer.write(os.fsencode(path) + b"\0")
' "$1" "$2"
}

run_changed() {
  ensure_repo_root
  setup_test_env
  local base="origin/main" focused=0 narrow=() arg scope clients docs selection
  local mix_args=() paths=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base)
        if [ "$#" -lt 2 ]; then
          echo "error: --base requires a ref" >&2
          return 64
        fi
        base="$2"; shift 2 ;;
      --focused) focused=1; shift ;;
      --narrow) narrow=(--narrow); shift ;;
      --) shift; mix_args+=("$@"); break ;;
      *) mix_args+=("$1"); shift ;;
    esac
  done
  selection="$(mktemp "$LEMON_TEST_TMPDIR/changed.XXXXXX")"
  scripts/changed_tests --base "$base" --focused ${narrow[@]+"${narrow[@]}"} --format json >"$selection"
  read -r scope clients docs < <(python3 -c 'import json, sys
s = json.load(open(sys.argv[1]))
print(s["scope"], str(s["lanes"]["clients"]).lower(), str(s["lanes"]["docs"]).lower())
' "$selection")
  if [ "$scope" = "full" ] || python3 -c 'import json, sys
sys.exit(0 if "lemon_control_plane" in json.load(open(sys.argv[1]))["apps"] else 1)' "$selection"; then
    ensure_tui_deps
  fi
  python3 -c 'import json, sys
s = json.load(open(sys.argv[1]))
print("Test scope: " + s["scope"])
if s["apps"]:
    print("Apps: " + " ".join(s["apps"]))
for reason in s["reasons"]:
    print("  - " + reason)
' "$selection"
  if [ "$focused" -eq 1 ]; then
    echo "Quick pre-check only: focused files are NOT a substitute for the affected-app run."
    while IFS= read -r -d '' arg; do paths+=("$arg"); done < <(selection_paths "$selection" focused_test_files)
    if [ "${#paths[@]}" -eq 0 ]; then
      echo "No matching focused test files; skipping ExUnit."
    else
      mix compile --warnings-as-errors
      mix test --exclude integration "${paths[@]}" ${mix_args[@]+"${mix_args[@]}"}
    fi
  elif [ "$scope" = "none" ]; then
    echo "No affected app tests; skipping ExUnit."
  elif [ "$scope" = "full" ]; then
    run_fast ${mix_args[@]+"${mix_args[@]}"}
  else
    while IFS= read -r -d '' arg; do paths+=("$arg"); done < <(selection_paths "$selection" test_paths)
    mix compile --warnings-as-errors
    mix test --exclude integration "${paths[@]}" ${mix_args[@]+"${mix_args[@]}"}
  fi
  if [ "$clients" = "true" ]; then
    run_clients
  fi
  if [ "$docs" = "true" ]; then
    scripts/verify_docs_site
  fi
  rm -f "$selection"
}

premerge_step() (
  set -E
  local name="$1" started=$SECONDS status
  shift
  echo "==> premerge: $name"
  trap 'status=$?; printf "error: premerge %s failed after %ss (exit %s)\n" "$name" "$((SECONDS - started))" "$status" >&2; exit "$status"' ERR
  "$@"
  printf 'premerge: %s passed (%ss)\n' "$name" "$((SECONDS - started))"
)

# Sets CHANGED_SCOPE (full|apps|none) and the existing changed files since the
# merge base with REF: CHANGED_FORMAT (.ex/.exs/.heex), CHANGED_ELIXIR
# (.ex/.exs) and CHANGED_CHANGELOGS (CHANGELOG.md, existing or deleted).
collect_changed_files() {
  local selection path
  CHANGED_FORMAT=() CHANGED_ELIXIR=() CHANGED_CHANGELOGS=()
  selection="$(mktemp "$LEMON_TEST_TMPDIR/changed-files.XXXXXX")"
  scripts/changed_tests --base "$1" --format json >"$selection"
  CHANGED_SCOPE="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["scope"])' "$selection")"
  while IFS= read -r -d '' path; do
    if [ -f "$path" ]; then
      case "$path" in *.ex|*.exs|*.heex) CHANGED_FORMAT+=("$path") ;; esac
      case "$path" in *.ex|*.exs) CHANGED_ELIXIR+=("$path") ;; esac
    fi
    case "$path" in CHANGELOG.md|*/CHANGELOG.md) CHANGED_CHANGELOGS+=("$path") ;; esac
  done < <(selection_paths "$selection" changed_files)
  rm -f "$selection"
}

run_premerge() {
  ensure_repo_root
  setup_test_env
  local base="origin/main"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base)
        if [ "$#" -lt 2 ]; then
          echo "error: --base requires a ref" >&2
          return 64
        fi
        base="$2"; shift 2 ;;
      *) echo "error: premerge accepts only --base REF" >&2; return 64 ;;
    esac
  done
  collect_changed_files "$base"
  if [ "${#CHANGED_FORMAT[@]}" -gt 0 ]; then
    premerge_step format mix format --check-formatted "${CHANGED_FORMAT[@]}"
  else
    echo "premerge: format skipped (no changed .ex/.exs/.heex files; 0s)"
  fi
  if [ "${#CHANGED_ELIXIR[@]}" -gt 0 ]; then
    premerge_step credo mix credo "${CHANGED_ELIXIR[@]}"
  else
    echo "premerge: credo skipped (no changed .ex/.exs files; 0s)"
  fi
  premerge_step skip-tag-guard check_skipped_tests
  if [ "${#CHANGED_CHANGELOGS[@]}" -gt 0 ]; then
    premerge_step changelog scripts/check_changelog "${CHANGED_CHANGELOGS[@]}"
  else
    echo "premerge: changelog skipped (no changed CHANGELOG.md; 0s)"
  fi
  premerge_step changed run_changed --base "$base" --narrow
  echo "Not covered: downstream tests that don't name a changed module (PR CI runs those apps whole),"
  echo "the full suite (main after merge), dialyzer/install/sim-bench (CI)."
}

# Under the factory, umbrella lanes that compile or run BEAM tests are gated by
# the shared heavy runner. The runner re-executes this script with the same lane
# and arguments once it holds a heavy lease. A process that inherited a lease
# (FACTORY_HEAVY_LEASE_FD and FACTORY_HEAVY_LEASE_TOKEN) proceeds only if the
# runner validates it; any validation failure is fatal. There is deliberately
# no unvalidated environment bypass; outside the factory nothing changes.
route_heavy_lane() {
  [ -n "${FACTORY_PROJECT:-}" ] || return 0
  local runner="${FACTORY_HEAVY_RUNNER:-}" python="${FACTORY_PYTHON:-python3}"
  if [ -z "$runner" ] || [ ! -f "$runner" ]; then
    cat >&2 <<EOF
error: scripts/test $LANE is a heavy lane and FACTORY_PROJECT is set, but the factory heavy runner is unavailable (FACTORY_HEAVY_RUNNER=${runner:-<unset>}).
Refusing to run unleased; launch through the factory supervisor, or unset FACTORY_PROJECT outside the factory.
EOF
    exit 70
  fi
  if [ -n "${FACTORY_HEAVY_LEASE_FD:-}" ] && [ -n "${FACTORY_HEAVY_LEASE_TOKEN:-}" ]; then
    if "$python" "$runner" validate >/dev/null; then
      return 0
    fi
    echo "error: scripts/test $LANE: inherited factory heavy lease failed validation; refusing to run." >&2
    exit 70
  fi
  exec "$python" "$runner" run -- "$ROOT/scripts/test" "$LANE" "$@"
}

case "$LANE" in
  fast|coverage|changed|premerge|quality|eval-fast|live-eval|path|all) route_heavy_lane "$@" ;;
esac

case "$LANE" in
  help|-h|--help) usage ;;
  fast) run_fast "$@" ;;
  changed) run_changed "$@" ;;
  premerge) run_premerge "$@" ;;
  quality) run_quality "$@" ;;
  clients) run_clients "$@" ;;
  coverage) run_coverage "$@" ;;
  eval-fast) run_eval_fast "$@" ;;
  live-eval) run_live_eval "$@" ;;
  smoke) run_smoke "$@" ;;
  all)
    run_fast
    run_quality
    run_eval_fast
    run_smoke
    ;;
  path) run_path "$@" ;;
  *)
    echo "Unknown test lane: $LANE" >&2
    usage >&2
    exit 64
    ;;
esac
