#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

node "$ROOT/scripts/check_docs_navigation.mjs"
node --test "$ROOT/scripts/check_docs_navigation.test.mjs"
bun "$ROOT/clients/tui/scripts/generate-commands-doc.ts" --check
WORK_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/lemon-docs-site.XXXXXX")"
DOCS_COPY="$WORK_ROOT/docs"

cleanup() {
  if [ "${LEMON_DOCS_VERIFY_KEEP_TMP:-}" = "1" ]; then
    echo "kept docs verification temp directory: $WORK_ROOT" >&2
  else
    rm -rf "$WORK_ROOT"
  fi
}
trap cleanup EXIT

mkdir -p "$DOCS_COPY"
cp -a "$ROOT/docs/." "$DOCS_COPY/"
rm -rf "$DOCS_COPY/node_modules" "$DOCS_COPY/.vitepress/dist"
mkdir -p "$WORK_ROOT/scripts"
cp "$ROOT/scripts/generate_docs_llms.py" "$WORK_ROOT/scripts/"

cd "$DOCS_COPY"

npm ci
npm test
npm run build

for asset in llms.txt llms-full.txt; do
  if [ ! -s "$DOCS_COPY/.vitepress/dist/$asset" ]; then
    echo "missing generated machine-readable docs asset: $asset" >&2
    exit 1
  fi
done

cd "$ROOT/docs"

LEMON_DOCS_LINK_CHECK_BIN="$DOCS_COPY/node_modules/.bin/markdown-link-check" npm run link-check

echo "docs site verification passed"
