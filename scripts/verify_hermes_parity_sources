#!/usr/bin/env python3
"""Verify Lemon's pinned Hermes comparison source and current audit references.

The default check is deterministic and network-free. Pass ``--remote`` when
refreshing the audit to verify that the pin still matches official ``main`` and
that its declared version matches the pinned upstream source.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import urllib.request
from datetime import datetime
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
BASELINE_PATH = ROOT / "docs/plans/hermes-upstream-baseline.json"
EXPECTED_REPOSITORY = "https://github.com/NousResearch/hermes-agent"
EXPECTED_DOCS = "https://hermes-agent.nousresearch.com/docs/"
EXPECTED_LLMS = "https://hermes-agent.nousresearch.com/docs/llms.txt"


def fail(message: str) -> None:
    print(f"Hermes parity source check failed: {message}", file=sys.stderr)
    raise SystemExit(1)


def read_text(relative_path: str) -> str:
    path = ROOT / relative_path
    if not path.is_file():
        fail(f"missing {relative_path}")
    return path.read_text(encoding="utf-8")


def validate_baseline() -> dict[str, object]:
    try:
        baseline = json.loads(BASELINE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read {BASELINE_PATH.relative_to(ROOT)}: {error}")

    required = {
        "schema_version",
        "observed_at",
        "repository",
        "branch",
        "commit",
        "commit_date",
        "version",
        "docs_url",
        "llms_url",
        "docs_files",
        "lemon_commit",
        "audit",
    }
    missing = sorted(required - baseline.keys())
    if missing:
        fail(f"baseline is missing fields: {', '.join(missing)}")

    if baseline["schema_version"] != 1:
        fail("unsupported baseline schema_version")
    if baseline["repository"] != EXPECTED_REPOSITORY or baseline["branch"] != "main":
        fail("baseline must pin the official NousResearch/hermes-agent main branch")
    if baseline["docs_url"] != EXPECTED_DOCS or baseline["llms_url"] != EXPECTED_LLMS:
        fail("baseline must use the official Hermes docs and llms.txt URLs")

    for field in ("commit", "lemon_commit"):
        if not re.fullmatch(r"[0-9a-f]{40}", str(baseline[field])):
            fail(f"{field} must be a full lowercase Git commit SHA")

    if not re.fullmatch(r"\d+\.\d+\.\d+", str(baseline["version"])):
        fail("version must be a semantic version such as 0.20.6")
    if not isinstance(baseline["docs_files"], int) or baseline["docs_files"] <= 0:
        fail("docs_files must be a positive integer")

    try:
        datetime.fromisoformat(str(baseline["commit_date"]))
        datetime.strptime(str(baseline["observed_at"]), "%Y-%m-%d")
    except ValueError as error:
        fail(f"invalid baseline date: {error}")

    audit_path = str(baseline["audit"])
    audit = read_text(audit_path)
    commit = str(baseline["commit"])
    must_appear = [
        commit,
        str(baseline["lemon_commit"]),
        str(baseline["commit_date"]),
        f"v{baseline['version']}",
        EXPECTED_DOCS,
        EXPECTED_LLMS,
        f"https://github.com/NousResearch/hermes-agent/blob/{commit}/",
    ]
    absent = [token for token in must_appear if token not in audit]
    if absent:
        fail(f"{audit_path} does not cite baseline token(s): {absent!r}")

    stale_claims = {
        "Lemon has no equivalent (bash + tools only)": "execute_code now exists",
        "but no redirect equivalent": "redirect now exists",
        "Lemon has single-credential resolution per provider": "credential pools now exist",
        "Lemon sends registered tool schemas directly": "progressive disclosure now exists",
        "Monitor mode, job chaining, model drift guard, preflight": "these cron features now exist",
    }
    for claim, correction in stale_claims.items():
        if claim.lower() in audit.lower():
            fail(f"stale claim remains in current audit ({correction}): {claim!r}")

    gap_link = "/plans/lemon-hermes-gap-audit-2026-08-11"
    site_config = read_text("docs/.vitepress/config.js")
    index = read_text("docs/index.md")
    compare = read_text("docs/compare.md")
    if gap_link not in site_config:
        fail("VitePress navigation does not expose the current Hermes gap audit")
    if "lemon-hermes-gap-audit-2026-08-11.md" not in index:
        fail("docs index does not link to the current Hermes gap audit")
    if "lemon-hermes-gap-audit-2026-08-11.md" not in compare:
        fail("compare page does not link to the current Hermes gap audit")
    if "Hermes Feature Matrix (historical)" not in site_config:
        fail("VitePress must label the May feature matrix as historical")

    return baseline


def verify_remote(baseline: dict[str, object]) -> None:
    try:
        result = subprocess.run(
            ["git", "ls-remote", str(baseline["repository"]), "refs/heads/main"],
            check=True,
            capture_output=True,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
        fail(f"could not query official Hermes main: {error}")

    fields = result.stdout.strip().split()
    if len(fields) != 2 or fields[1] != "refs/heads/main":
        fail(f"unexpected git ls-remote response: {result.stdout!r}")
    if fields[0] != baseline["commit"]:
        fail(
            "official Hermes main moved: "
            f"pinned {baseline['commit']}, current {fields[0]}; refresh the audit"
        )

    raw_pyproject = (
        "https://raw.githubusercontent.com/NousResearch/hermes-agent/"
        f"{baseline['commit']}/pyproject.toml"
    )
    try:
        request = urllib.request.Request(
            raw_pyproject,
            headers={"User-Agent": "lemon-hermes-parity-verifier/1"},
        )
        with urllib.request.urlopen(request, timeout=30) as response:
            pyproject = response.read().decode("utf-8")
    except (OSError, UnicodeError) as error:
        fail(f"could not read pinned upstream pyproject.toml: {error}")

    match = re.search(r'^version\s*=\s*"([^"]+)"', pyproject, flags=re.MULTILINE)
    if not match:
        fail("pinned upstream pyproject.toml has no project version")
    if match.group(1) != baseline["version"]:
        fail(
            "upstream version mismatch: "
            f"baseline {baseline['version']}, pyproject.toml {match.group(1)}"
        )


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--remote",
        action="store_true",
        help="also require the pin to equal current official main",
    )
    args = parser.parse_args()

    baseline = validate_baseline()
    if args.remote:
        verify_remote(baseline)

    suffix = " plus live official main" if args.remote else ""
    print(
        "Hermes parity source verified: "
        f"{baseline['commit']} (v{baseline['version']}){suffix}"
    )


if __name__ == "__main__":
    main()
