#!/usr/bin/env bash
# verify_packages — prove the published Hex packages work for someone who is
# not inside this repository.
#
# Usage:
#   scripts/verify_packages [--keep] [--tmp <dir>] [--no-generator]
#   scripts/verify_packages --list
#
# Options:
#   --keep          Leave the unpacked packages and projects in place.
#   --tmp <dir>     Work directory (default: a mktemp directory). Must not be
#                   inside the repository.
#   --no-generator  Stop after the consumer project; skip `mix lemon.new`.
#   --list          Print the published packages in dependency order and exit.
#
# Every other check builds from inside the umbrella, where sibling apps and the
# umbrella's own files are always present. The 0.1.0 releases shipped a mix.exs
# that required a file outside the tarball and failed to load for every
# consumer; nothing caught it because nothing built from the tarball. This
# script builds from nothing but the tarballs:
#
#   1. `LEMON_HEX_PUBLISH=1 mix hex.build --unpack` each package into
#      <tmp>/packages/<package> — exactly the files hex.pm would receive —
#      then inspect the tarballs: no packaged source names a module a tarball
#      excludes, lemon_platform_test never names the unpublished
#      lemon_channels, and every sibling requirement admits its sibling's 0.x
#      minor and no other.
#   2. A scratch consumer project depends on those directories by path (the
#      packages' own sibling requirements are hex requirements, so the path deps
#      carry `override: true`), fetches the rest from hex.pm, compiles, boots
#      :lemon_agent, checks the repo-only tooling stayed out of lemon_core and
#      that no packaged module calls an undefined module of a published
#      package (xref), and runs the packaged doctor: the runtime check must
#      pass on this toolchain and no doctor check may crash.
#   3. The installer generates the base and --memory project shapes against the
#      same unpacked packages (`--packages-path`), compiles them with
#      --warnings-as-errors and runs their tests.
#
# Consumer commands run with HOME pointed into <tmp>, so nothing a package
# writes under ~ touches your real home; MIX_HOME/HEX_HOME keep their usual
# locations so the installed Hex and fetched packages are reused.
#
# Requires Hex (`mix local.hex`) and network access to hex.pm.
# See docs/release/hex-packages.md.

set -euo pipefail

# The published set, in dependency order: each package depends only on
# packages listed before it. scripts/release_package reads this via --list.
PACKAGES=(lemon_ai lemon_core lemon_agent lemon_memory lemon_platform_test)

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
KEEP=0
TMP=""
GENERATOR=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --list) printf '%s\n' "${PACKAGES[@]}"; exit 0 ;;
    --keep) KEEP=1; shift ;;
    --tmp) TMP="$2"; shift 2 ;;
    --no-generator) GENERATOR=0; shift ;;
    -h|--help) sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

if [[ -z "$TMP" ]]; then
  TMP="$(mktemp -d "${TMPDIR:-/tmp}/lemon_verify_packages.XXXXXX")"
fi
mkdir -p "$TMP"
# Resolve symlinks (macOS /tmp -> /private/tmp) so every path Mix compares is
# spelled the same way.
TMP="$(cd "$TMP" && pwd -P)"

case "$TMP/" in
  "$REPO_ROOT"/*)
    echo "--tmp must be outside the repository: an unpacked package under apps/" >&2
    echo "would be mistaken for an umbrella app." >&2
    exit 2
    ;;
esac

cleanup() {
  if [[ $KEEP -eq 0 ]]; then
    rm -rf "$TMP"
  else
    echo "work directory left in $TMP"
  fi
}
trap cleanup EXIT

PKG_DIR="$TMP/packages"
CONSUMER_HOME="$TMP/home"
mkdir -p "$PKG_DIR" "$CONSUMER_HOME"

# Runs a command as a consumer machine would: fresh HOME, shared Mix/Hex caches.
consumer() {
  env HOME="$CONSUMER_HOME" \
    MIX_HOME="${MIX_HOME:-$HOME/.mix}" \
    HEX_HOME="${HEX_HOME:-$HOME/.hex}" \
    LEMON_HEX_PUBLISH= \
    "$@"
}

# ── 1. Build and unpack each tarball ────────────────────────────────────────

for pkg in "${PACKAGES[@]}"; do
  echo "==> $pkg: hex.build --unpack"
  (cd "$REPO_ROOT/apps/$pkg" &&
    LEMON_HEX_PUBLISH=1 mix hex.build --unpack --output "$PKG_DIR/$pkg" >/dev/null)
  [[ -f "$PKG_DIR/$pkg/mix.exs" ]] || {
    echo "hex.build produced no mix.exs for $pkg" >&2
    exit 1
  }
done

echo
echo "==> packages: no packaged source names an excluded or unpublished module"
# A module is excluded when its repo file is missing from the tarball (each
# mix.exs's package exclude_patterns). Only top-level defmodules are taken:
# nested ones are declared relative to their parent.
EXCLUDED_LIST="$TMP/excluded_modules"
: >"$EXCLUDED_LIST"
for pkg in "${PACKAGES[@]}"; do
  while IFS= read -r file; do
    rel="${file#"$REPO_ROOT/apps/$pkg/"}"
    [[ -f "$PKG_DIR/$pkg/$rel" ]] && continue
    sed -n 's/^defmodule[[:space:]]\{1,\}\([A-Za-z0-9_.]*\).*/\1/p' "$file" >>"$EXCLUDED_LIST"
  done < <(find "$REPO_ROOT/apps/$pkg/lib" -name '*.ex')
done
echo "excluded from the tarballs: $(wc -l <"$EXCLUDED_LIST" | tr -d ' ') modules"
if grep -rnwF -f "$EXCLUDED_LIST" "${PACKAGES[@]/#/$PKG_DIR/}" --include='*.ex'; then
  echo "packaged sources above name a module that no published package contains" >&2
  exit 1
fi
# lemon_channels is not published, so the contract-test kit (whose modules
# consumers compile into their own tests) must not name it at all.
if grep -rnw 'LemonChannels' "$PKG_DIR/lemon_platform_test/lib"; then
  echo "lemon_platform_test's package names the unpublished lemon_channels" >&2
  exit 1
fi

echo "==> packages: sibling requirements stay on the sibling's 0.x minor"
# Each 0.x minor may break, so `~> 0.3` (which admits 0.4) is refused; the
# requirement must admit the sibling's patch releases and nothing else.
PKG_DIR="$PKG_DIR" PACKAGES="${PACKAGES[*]}" elixir -e '
  dir = System.fetch_env!("PKG_DIR")
  packages = String.split(System.fetch_env!("PACKAGES"))

  metadata =
    Map.new(packages, fn pkg ->
      {:ok, terms} = :file.consult(String.to_charlist(Path.join([dir, pkg, "hex_metadata.config"])))
      {pkg, Map.new(terms)}
    end)

  errors =
    for {pkg, meta} <- metadata,
        req <- meta["requirements"],
        req = Map.new(req),
        req["name"] in packages do
      sibling = Version.parse!(metadata[req["name"]]["version"])
      %Version{major: major, minor: minor} = sibling
      requirement = req["requirement"]

      admits =
        Enum.all?([sibling, "#{major}.#{minor}.99"], &Version.match?(&1, requirement))

      others = ["#{major}.#{minor + 1}.0", "#{major + 1}.0.0"] ++
        if(minor > 0, do: ["#{major}.#{minor - 1}.99"], else: [])

      if admits and not Enum.any?(others, &Version.match?(&1, requirement)),
        do: [],
        else: ["#{pkg} requires #{req["name"]} #{requirement}; #{req["name"]} is #{sibling}"]
    end
    |> List.flatten()

  errors == [] || raise Enum.join(["sibling requirements cross a 0.x minor:" | errors], "\n  ")
  IO.puts("sibling requirements ok")
'

# ── 2. A consumer that depends on nothing but the tarballs ──────────────────

CONSUMER="$TMP/consumer"
mkdir -p "$CONSUMER/lib"

{
  cat <<'EOF'
defmodule PackagesConsumer.MixProject do
  use Mix.Project

  def project do
    [app: :packages_consumer, version: "0.1.0", elixir: "~> 1.15", deps: deps()]
  end

  # :tools provides :xref for the inspection below.
  def application, do: [extra_applications: [:logger, :tools]]

  defp deps do
    [
EOF
  for pkg in "${PACKAGES[@]}"; do
    printf '      {:%s, path: "%s", override: true},\n' "$pkg" "$PKG_DIR/$pkg"
  done
  cat <<'EOF'
    ]
  end
end
EOF
} >"$CONSUMER/mix.exs"

echo
echo "==> consumer: deps.get"
(cd "$CONSUMER" && consumer mix deps.get >/dev/null)

echo "==> consumer: compile"
(cd "$CONSUMER" && consumer mix compile)

echo "==> consumer: boot and inspect"
(cd "$CONSUMER" && consumer mix run -e '
  {:ok, _} = Application.ensure_all_started(:lemon_agent)

  for module <- [LemonAi, LemonCore.Store, LemonAgent, LemonMemory.Store, LemonPlatformTest.BackendCase] do
    Code.ensure_loaded?(module) || raise "#{inspect(module)} is missing from the packages"
  end

  # Repo-only tooling and the in-repo test harness are excluded from the
  # lemon_core tarball (apps/lemon_core/mix.exs); PluginCase, whose target is
  # unpublished, from lemon_platform_test.
  for module <- [
        LemonCore.Quality.ArchitectureCheck,
        LemonCore.Update.Version,
        Mix.Tasks.Lemon.Quality,
        Mix.Tasks.Lemon.Store.MigrateJsonlToSqlite,
        LemonCore.Testing,
        LemonCore.Testing.Case,
        LemonCore.Testing.HermeticEnv,
        LemonCore.Testing.AsyncHelpers,
        LemonPlatformTest.PluginCase
      ] do
    Code.ensure_loaded?(module) && raise "#{inspect(module)} leaked into the packages"
  end

  # No packaged module may call a module or function of a published package
  # that the packages do not contain: that is a raise waiting for a consumer.
  published = [:lemon_ai, :lemon_core, :lemon_agent, :lemon_memory, :lemon_platform_test]
  namespaces = ~w(LemonAi LemonCore LemonAgent LemonMemory LemonPlatformTest Mix.Tasks.Lemon)

  {:ok, xref} = :xref.start(xref_mode: :functions)
  :ok = :xref.set_default(xref, verbose: false, warnings: false)
  :ok = :xref.set_library_path(xref, :code.get_path())
  for app <- published, do: {:ok, ^app} = :xref.add_application(xref, :code.lib_dir(app))
  {:ok, calls} = :xref.analyze(xref, :undefined_function_calls)
  :xref.stop(xref)

  ours? = fn module ->
    name = inspect(module)
    Enum.any?(namespaces, &(name == &1 or String.starts_with?(name, &1 <> ".")))
  end

  case for({from, {module, _, _} = to} <- calls, ours?.(module), do: {from, to}) do
    [] -> :ok
    broken -> raise "packaged code calls what the packages do not contain:\n#{inspect(broken, pretty: true)}"
  end

  # The packaged doctor runs: its runtime check must pass on this toolchain
  # (whatever Elixir the packages admit), and no doctor check may crash. A
  # free port keeps a local Lemon runtime out of the control-port check.
  {:ok, socket} = :gen_tcp.listen(0, [])
  {:ok, port} = :inet.port(socket)
  :ok = :gen_tcp.close(socket)
  System.put_env("LEMON_CONTROL_PLANE_PORT", Integer.to_string(port))

  runtime = LemonCore.Doctor.Checks.Runtime.run([])
  for check <- runtime, do: IO.puts("  #{check.name}: #{check.status} — #{check.message}")

  Enum.any?(runtime, &(&1.name == "runtime.build" and &1.status == :pass)) ||
    raise "packaged doctor reported no build identity"

  case Enum.filter(runtime, &(&1.status == :fail)) do
    [] -> :ok
    failed -> raise "packaged doctor runtime check failed on Elixir #{System.version()}: #{inspect(failed)}"
  end

  case Enum.filter(LemonCore.Doctor.checks(), &(&1.name == "doctor.check_failed")) do
    [] -> :ok
    crashed -> raise "packaged doctor checks crashed: #{inspect(crashed)}"
  end

  IO.puts("consumer ok: packages compile, :lemon_agent boots, repo tooling excluded, doctor runs")
')

if [[ $GENERATOR -eq 0 ]]; then
  echo
  echo "packages verified (generator skipped)."
  exit 0
fi

# ── 3. mix lemon.new against the tarballs ───────────────────────────────────

generate_and_check() {
  local name="$1"; shift
  local dir="$TMP/$name"

  echo
  echo "==> generating $name ${*:-(no flags)} against the unpacked packages"
  (cd "$REPO_ROOT/installer" && mix run -e \
    "Mix.Task.run(\"lemon.new\", [\"$dir\", \"--packages-path\", \"$PKG_DIR\", \"--no-install\"] ++ System.argv())" \
    -- "$@")

  echo "==> $name: deps.get"
  (cd "$dir" && consumer mix deps.get >/dev/null)

  echo "==> $name: compile --warnings-as-errors"
  # Dependencies compile first and separately: a warning inside a package is
  # not the generated project's problem, and --warnings-as-errors does not
  # distinguish. The forced recompile covers only the generated app.
  (cd "$dir" && consumer env MIX_ENV=test mix compile >/dev/null 2>&1 || true)
  (cd "$dir" && consumer env MIX_ENV=test mix compile --force --warnings-as-errors)

  echo "==> $name: test"
  (cd "$dir" && consumer mix test)
}

generate_and_check base_agent
generate_and_check memory_agent --memory

echo
echo "packages verified: ${PACKAGES[*]} build from their tarballs, and generated projects pass."
