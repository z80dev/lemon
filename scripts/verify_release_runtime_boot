#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: scripts/verify_release_runtime_boot [--platform <tag>] <artifact-directory>
       scripts/verify_release_runtime_boot --single <tarball> --profile <profile>

Verifies Lemon release artifacts beyond checksums:
  - validates manifest and artifact checksums (manifest mode)
  - extracts release profile(s) into clean temp dirs
  - evaluates MCP library composition in packaged min/full releases
  - starts each release daemon without Mix (min/full through the packaged
    `lemon daemon` launcher, which records the pidfile and waits for health)
  - checks control-plane /healthz or sim broadcast /readyz
  - checks `lemon status`, the unified `lemon --help` registry, `lemon version`,
    and the read-only `lemon migrate hermes audit --json` (non-sim profiles)
  - exercises Mix-free models/media/usage JSON, notification dry-run, policy,
    and skill commands in the packaged CLI
  - checks Web /healthz for lemon_runtime_full
  - checks `lemon web --no-open` reports the healthy packaged Web URL
  - checks lemon_runtime_full asset-digest artifacts and daemon log
  - stops the daemon (`lemon stop` for non-sim profiles)
  - generates a release-runtime support bundle with release eval (non-sim profiles)
  - boots standalone lemon_bot with a clean HOME/private token, validates its
    executable and setup version, and fetches the complete packaged web build

Manifest mode boots every artifact for the target platform (default:
detected from `uname`); --single mode boots exactly one given tarball
without a manifest, for pre-upload verification in CI build jobs.

Platform tags: linux-x86_64, linux-arm64, darwin-arm64.
EOF
  exit 2
}

MODE="manifest"
ARTIFACT_DIR=""
SINGLE_TARBALL=""
SINGLE_PROFILE=""
PLATFORM_FILTER=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --single)
      [ "$#" -ge 2 ] || usage
      MODE="single"
      SINGLE_TARBALL="$2"
      shift 2
      ;;
    --profile)
      [ "$#" -ge 2 ] || usage
      SINGLE_PROFILE="$2"
      shift 2
      ;;
    --platform)
      [ "$#" -ge 2 ] || usage
      PLATFORM_FILTER="$2"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    --*)
      usage
      ;;
    *)
      if [ -n "$ARTIFACT_DIR" ]; then
        usage
      fi
      ARTIFACT_DIR="$1"
      shift
      ;;
  esac
done

if [ "$MODE" = "single" ]; then
  case "$SINGLE_PROFILE" in
    lemon_runtime_min|lemon_runtime_full|sim_broadcast_platform|lemon_bot) ;;
    *)
      echo "error: --single requires --profile <lemon_runtime_min|lemon_runtime_full|sim_broadcast_platform|lemon_bot>" >&2
      exit 2
      ;;
  esac

  if [ -n "$ARTIFACT_DIR" ]; then
    echo "error: --single does not take a directory argument" >&2
    exit 2
  fi

  if [ ! -f "$SINGLE_TARBALL" ]; then
    echo "artifact not found: $SINGLE_TARBALL" >&2
    exit 2
  fi
else
  [ -n "$ARTIFACT_DIR" ] || usage

  if [ ! -d "$ARTIFACT_DIR" ]; then
    echo "artifact directory not found: $ARTIFACT_DIR" >&2
    exit 2
  fi
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

detect_platform() {
  case "$(uname -s)" in
    Linux)
      case "$(uname -m)" in
        x86_64) echo "linux-x86_64" ;;
        aarch64|arm64) echo "linux-arm64" ;;
        *) echo "unknown-linux-$(uname -m)" ;;
      esac
      ;;
    Darwin)
      case "$(uname -m)" in
        arm64) echo "darwin-arm64" ;;
        *) echo "unknown-darwin-$(uname -m)" ;;
      esac
      ;;
    *)
      echo "unknown-$(uname -s)"
      ;;
  esac
}

# Profile counts mirror scripts/verify_release_artifacts, excluding only the
# terminal client. The standalone backend uses its own real HTTP boot path.
expected_profile_count() {
  case "$1" in
    linux-x86_64|linux-arm64) echo 4 ;;
    darwin-arm64) echo 3 ;;
    *) echo 0 ;;
  esac
}

if [ -z "$PLATFORM_FILTER" ]; then
  PLATFORM_FILTER="$(detect_platform)"
fi

free_port() {
  python3 - <<'PY'
import socket

sock = socket.socket()
sock.bind(("127.0.0.1", 0))
print(sock.getsockname()[1])
sock.close()
PY
}

manifest_entries() {
  ARTIFACT_DIR="$ARTIFACT_DIR" PLATFORM_FILTER="$PLATFORM_FILTER" python3 - <<'PY'
import json
import os
import re

manifest_path = os.path.join(os.environ["ARTIFACT_DIR"], "manifest.json")
platform_filter = os.environ["PLATFORM_FILTER"]

with open(manifest_path, "r", encoding="utf-8") as handle:
    manifest = json.load(handle)

entries = []
for artifact in manifest["artifacts"]:
    filename = artifact["file"]
    match = re.search(
        r"-(linux-x86_64|linux-arm64|darwin-arm64)-"
        r"(lemon_runtime_min|lemon_runtime_full|sim_broadcast_platform|lemon_bot)\.tar\.gz$",
        filename,
    )
    if not match:
        continue

    platform, profile = match.group(1), match.group(2)
    if platform != platform_filter:
        continue

    entries.append((profile, filename))

for profile, filename in sorted(entries):
    print(f"{profile}\t{filename}")
PY
}

manifest_commit() {
  ARTIFACT_DIR="$ARTIFACT_DIR" python3 - <<'PY'
import json
import os

with open(os.path.join(os.environ["ARTIFACT_DIR"], "manifest.json"), "r", encoding="utf-8") as handle:
    print(json.load(handle)["commit"])
PY
}

write_fixture_config() {
  local home="$1"

  mkdir -p "$home/.lemon"
  cat > "$home/.lemon/config.toml" <<'EOF'
[defaults]
provider = "anthropic"
model = "claude-sonnet-4-20250514"

[gateway]
max_concurrent_runs = 1
auto_resume = false
enable_telegram = false

[features]
routing_feedback       = "opt-in"
skill_synthesis_drafts = "opt-in"
EOF
}

wait_for_health() {
  local url="$1"
  local label="$2"

  for _attempt in $(seq 1 20); do
    if response="$(curl -sS --max-time 2 "$url" 2>/dev/null)"; then
      if [ "$response" = "ok" ]; then
        echo "ok $label healthz: $response"
        return 0
      fi

      if printf '%s' "$response" | python3 -c 'import json,sys; data=json.load(sys.stdin); sys.exit(0 if data.get("ok") is True or data.get("status") in ("ok", "degraded") else 1)' 2>/dev/null; then
        echo "ok $label healthz: $response"
        return 0
      fi
    fi

    sleep 2
  done

  echo "health check failed for $label at $url" >&2
  return 1
}

# lemon_runtime_full bundles both lemon_web (digest-only, no asset pipeline)
# and lemon_sim_ui (npm build + digest); both must have produced a
# cache_manifest.json or the release serves undigested/missing assets.
assert_full_profile_static_files() {
  local profile="$1"
  local extract_dir="$2"

  if ! compgen -G "$extract_dir/lib/lemon_web-*/priv/static/cache_manifest.json" > /dev/null; then
    echo "$profile: missing lemon_web cache_manifest.json (asset digest step likely skipped)" >&2
    exit 1
  fi

  if ! compgen -G "$extract_dir/lib/lemon_web-*/priv/static/assets/app*.css" > /dev/null; then
    echo "$profile: missing bundled lemon_web CSS (runtime CDN fallback is forbidden)" >&2
    exit 1
  fi

  if ! compgen -G "$extract_dir/lib/lemon_sim_ui-*/priv/static/cache_manifest.json" > /dev/null; then
    echo "$profile: missing lemon_sim_ui cache_manifest.json (asset digest step likely skipped)" >&2
    exit 1
  fi
}

# Runtime profiles bundle the local browser driver with its production
# dependencies. Loading it through the release's own inspection helper proves
# the exports and playwright-core resolve; it never launches a browser.
assert_bundled_browser_driver() {
  local profile="$1"
  local extract_dir="$2"
  local priv

  priv="$(compgen -G "$extract_dir/lib/lemon_browser-*/priv" | head -n 1)"
  if [ -z "$priv" ] || [ ! -f "$priv/driver/local-driver.js" ] ||
    [ ! -f "$priv/driver/node_modules/playwright-core/package.json" ]; then
    echo "$profile: missing bundled browser driver under lemon_browser priv/driver" >&2
    exit 1
  fi

  if ! command -v node > /dev/null 2>&1; then
    echo "$profile: node not on PATH; skipped loading the bundled browser driver"
    return
  fi

  local result
  result="$(printf '{"driverPath":"%s","endpoint":"","port":9,"launchesBrowser":true,"attachOnly":false}\n' \
    "$priv/driver/local-driver.js" | node "$priv/node_browser_inspect.mjs")"

  case "$result" in
    *'"supported"'*) ;;
    *)
      echo "$profile: bundled browser driver failed to load: $result" >&2
      exit 1
      ;;
  esac
}

assert_no_asset_warmup_failure() {
  local profile="$1"
  local extract_dir="$2"

  if grep -rq "Could not warm up static assets" "$extract_dir/tmp/log" 2>/dev/null; then
    echo "$profile: daemon log reports failure warming up static assets" >&2
    exit 1
  fi
}

verify_support_bundle() {
  local profile="$1"
  local bundle_path="$2"

  python3 - "$profile" "$bundle_path" <<'PY'
import sys
import zipfile

profile, bundle_path = sys.argv[1:]
required_entries = {
    "README.txt",
    "doctor_report.json",
    "channel_diagnostics.json",
}

try:
    with zipfile.ZipFile(bundle_path) as archive:
        names = set(archive.namelist())
        missing = sorted(required_entries - names)
except zipfile.BadZipFile:
    print(f"{profile}: support bundle is not a valid zip: {bundle_path}", file=sys.stderr)
    sys.exit(1)

if missing:
    print(
        f"{profile}: support bundle missing required entries: {', '.join(missing)}",
        file=sys.stderr,
    )
    sys.exit(1)
PY
}

CLEANUP_RELEASE=""
CLEANUP_ENV=()

cleanup_work_dir() {
  local work_dir="$1"
  # Cleanup must use the same isolated HOME, node and cookie as the boot.
  # A bare release stop could address an unrelated installed runtime instead.
  if [[ "$CLEANUP_RELEASE" == "$work_dir"/*/extract/bin/* ]] && [ -x "$CLEANUP_RELEASE" ]; then
    env "${CLEANUP_ENV[@]}" "$CLEANUP_RELEASE" stop >/dev/null 2>&1 || true
  fi

  rm -rf "$work_dir"
}


boot_bot_profile() {
  python3 - "$1" "$2" <<'PY'
import json
import os
from pathlib import Path
import re
import pty
import select
import secrets
import socket
import struct
import subprocess
import sys
import tarfile
import time
import zlib
from urllib.parse import quote
from urllib.error import HTTPError
from urllib.request import Request, urlopen

tarball, work_dir = sys.argv[1:]
match = re.fullmatch(r"lemon-(\d{4}\.\d{1,2}\.\d+)-[A-Za-z0-9._-]+-(linux-x86_64|linux-arm64|darwin-arm64)-lemon_bot\.tar\.gz", Path(tarball).name)
if not match:
    raise SystemExit("lemon_bot: invalid versioned artifact filename")
version = match[1]
root = Path(work_dir) / "lemon_bot"
root.mkdir(mode=0o700)
extract = root / "extract"
extract.mkdir()
with tarfile.open(tarball) as archive:
    archive.extractall(extract, filter="data")
binary = extract / "bot/bin/lemon-bot"
web = extract / "bot/web"
if not binary.is_file() or not os.access(binary, os.X_OK) or not (web / "index.html").is_file():
    raise SystemExit("lemon_bot: missing executable or complete web build")
home = root / "home"
home.mkdir(mode=0o700)
def port():
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]
http_port, control_port = port(), port()
base = f"http://127.0.0.1:{http_port}"
token = secrets.token_urlsafe(48)
environment = {
    "PATH": "/usr/bin:/bin",
    "HOME": str(home),
    "TMPDIR": str(root),
    "LEMON_BOT_HOST": "127.0.0.1",
    "LEMON_BOT_PORT": str(http_port),
    "LEMON_BOT_CONTROL_URL": f"ws://127.0.0.1:{control_port}/ws",
    "LEMON_BOT_OPERATOR_TOKEN": token,
    "LEMON_BOT_PUBLIC_URL": base,
    "LEMON_BOT_DATA_DIR": str(home / ".lemon/lemon_bot"),
}
reported = subprocess.check_output([str(binary), "--version"], env=environment, cwd=home, text=True, timeout=30).strip()
if reported != f"lemon-bot {version}":
    raise SystemExit(f"lemon_bot: executable version mismatch: {reported!r}")
def get(path):
    with urlopen(base + path, timeout=2) as response:
        return response.read(), response.headers.get_content_type()
# Backend logs must never contain an owner proof; setup uses a private PTY below.
log_path = root / "boot.log"
def report_image_diagnostics():
    with log_path.open("rb") as private_log:
        private_log.seek(max(0, log_path.stat().st_size - 4096))
        lines = private_log.read(4096).decode("utf-8", errors="replace").splitlines()
    diagnostics = [line.removeprefix("LEMON_BOT_IMAGE_DIAGNOSTIC ") for line in lines
                   if line.startswith("LEMON_BOT_IMAGE_DIAGNOSTIC ")]
    for line in diagnostics[-3:]:
        try:
            diagnostic = json.loads(line)
            phase = diagnostic.get("phase")
            reason = diagnostic.get("classification")
            dependency = diagnostic.get("dependency")
            if phase not in ("load", "decode") or not isinstance(reason, str) or not re.fullmatch(r"[a-z-]{1,64}", reason):
                continue
            if dependency is not None and (not isinstance(dependency, str) or not re.fullmatch(
                r"(?:sharp|detect-libc|semver|@img/(?:colour|sharp-(?:libvips-)?(?:darwin|linux|linuxmusl)-(?:arm64|x64)))", dependency
            )):
                continue
            print(f"lemon_bot image: phase={phase}, classification={reason}, dependency={dependency or 'unspecified'}", file=sys.stderr)
        except (ValueError, AttributeError):
            continue
with log_path.open("xb") as log:
    log_path.chmod(0o600)
    process = subprocess.Popen([str(binary)], env=environment, cwd=home, stdout=log, stderr=log)
    try:
        for attempt in range(60):
            if process.poll() is not None:
                report_image_diagnostics()
                raise SystemExit("lemon_bot: backend exited before HTTP readiness (private logs removed on exit)")
            try:
                body, content_type = get("/v1/setup")
                break
            except OSError:
                time.sleep(1)
        else:
            raise SystemExit("lemon_bot: /v1/setup never became ready")
        setup = json.loads(body)
        # API responses carry the standard data envelope.
        setup = setup.get("data", setup)
        if setup.get("setupRequired") is not True or setup.get("version") != version:
            raise SystemExit("lemon_bot: setup/version response does not match a clean release boot")
        if token.encode() in body or b"setupCode" in body:
            raise SystemExit("lemon_bot: public setup response exposed private bootstrap material")
        for route in ("/", "/setup"):
            body, content_type = get(route)
            if content_type != "text/html" or body != (web / "index.html").read_bytes():
                raise SystemExit(f"lemon_bot: {route} did not serve the packaged web application")
        assets = [path for path in web.rglob("*") if path.is_file() and path.name != "index.html"]
        if not any(path.suffix == ".js" for path in assets):
            raise SystemExit("lemon_bot: packaged web build has no JavaScript assets")
        for path in assets:
            body, _ = get("/" + quote(path.relative_to(web).as_posix()))
            if body != path.read_bytes():
                raise SystemExit("lemon_bot: web asset missing or replaced by SPA fallback")
        origin_probe = subprocess.run(
            [str(binary), "setup", "--same-machine", "--print-origin"],
            env=environment, cwd=home, capture_output=True, timeout=30,
        )
        if origin_probe.returncode != 0 or origin_probe.stdout != (base + "\n").encode() or origin_probe.stderr:
            raise SystemExit("lemon_bot: read-only verified same-machine origin failed")
        # Explicit same-machine setup; the proof stays in private process memory.
        # pty.fork establishes /dev/tty even on a headless release runner.
        pid, master = pty.fork()
        if pid == 0:
            os.chdir(home)
            os.execve(str(binary), [str(binary), "setup", "--same-machine"], environment)
        private_output = bytearray()
        deadline = time.monotonic() + 30
        status = None
        try:
            while time.monotonic() < deadline:
                if select.select([master], [], [], 0.1)[0]:
                    try:
                        chunk = os.read(master, 4096)
                    except OSError:
                        chunk = b""
                    if not chunk:
                        done, child_status = os.waitpid(pid, os.WNOHANG)
                        if done:
                            status = child_status
                            break
                        time.sleep(0.01)
                        continue
                    private_output.extend(chunk)
                    if len(private_output) > 16384:
                        break
                done, child_status = os.waitpid(pid, os.WNOHANG)
                if done:
                    status = child_status
                    # Drain buffered PTY bytes before checking the private proof.
                    while select.select([master], [], [], 0)[0]:
                        try:
                            chunk = os.read(master, 4096)
                        except OSError:
                            break
                        if not chunk:
                            break
                        private_output.extend(chunk)
                    break
        finally:
            os.close(master)
            if status is None:
                done, child_status = os.waitpid(pid, os.WNOHANG)
                if done:
                    status = child_status
                else:
                    os.kill(pid, 9)
                    os.waitpid(pid, 0)
        code = re.search(rb"Lemon Bot one-use setup code: (\S+)", private_output)
        if status != 0 or code is None:
            raise SystemExit("lemon_bot: explicit private same-machine setup failed")
        bootstrap = json.dumps({
            "clientNonce": secrets.token_hex(24), "setupCode": code[1].decode(),
            "email": "release-smoke@example.com", "password": secrets.token_urlsafe(32),
            "displayName": "Release smoke", "workspaceName": "Release smoke",
        }).encode()
        with urlopen(Request(base + "/v1/setup", data=bootstrap,
                             headers={"Content-Type": "application/json"}), timeout=30) as response:
            account = json.load(response)
        account = account.get("data", account)
        session = account.get("token")
        if not isinstance(session, str) or not session:
            raise SystemExit("lemon_bot: real setup did not return an owner session")
        def png_chunk(kind, content):
            return struct.pack(">I", len(content)) + kind + content + struct.pack(">I", zlib.crc32(kind + content) & 0xffffffff)
        png = (b"\x89PNG\r\n\x1a\n"
               + png_chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0))
               + png_chunk(b"IDAT", zlib.compress(b"\x00\x20\x80\xe0"))
               + png_chunk(b"IEND", b""))
        boundary = secrets.token_hex(24)
        metadata = json.dumps({"clientNonce": secrets.token_hex(24), "purpose": "avatar"})
        multipart = (
            f"--{boundary}\r\nContent-Disposition: form-data; name=\"metadata\"\r\n\r\n{metadata}\r\n"
            f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"native-smoke.png\"\r\n"
            "Content-Type: image/png\r\n\r\n"
        ).encode() + png + f"\r\n--{boundary}--\r\n".encode()
        with urlopen(Request(base + "/v1/attachments", data=multipart, headers={
            "Content-Type": f"multipart/form-data; boundary={boundary}",
            "Authorization": f"Bearer {session}",
        }), timeout=30) as response:
            attachment = json.load(response)
        attachment = attachment.get("data", attachment)
        if (attachment.get("state") != "ready" or attachment.get("mime") != "image/png"
                or attachment.get("width") != 1 or attachment.get("height") != 1):
            raise SystemExit("lemon_bot: packaged native image pipeline did not decode the uploaded PNG")
    except HTTPError as error:
        # Only report the API classification, not arbitrary response messages,
        # sessions, bootstrap credentials or the raw private backend log.
        classification = "unknown"
        try:
            failure = json.loads(error.read(4096))
            candidate = failure.get("error", {}).get("code")
            if isinstance(candidate, str) and re.fullmatch(r"[a-z_]{1,64}", candidate):
                classification = candidate
        except (ValueError, AttributeError):
            pass
        print(f"lemon_bot: HTTP {error.code}, classification={classification}", file=sys.stderr)
        report_image_diagnostics()
        raise SystemExit("lemon_bot: authenticated native image smoke failed; private logs removed")
    finally:
        process.terminate()
        try:
            process.wait(timeout=15)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
print(f"ok lemon_bot {version}: native executable, clean setup, web assets and authenticated native image decode")
PY
}
# Boots one release tarball end to end. `expected_commit` may be empty
# (single mode has no manifest to compare an embedded commit against).
boot_one_profile() {
  local profile="$1"
  local tarball_path="$2"
  local work_dir="$3"
  local expected_commit="$4"

  if [ "$profile" = "lemon_bot" ]; then
    boot_bot_profile "$tarball_path" "$work_dir"
    return
  fi

  local profile_dir="$work_dir/$profile"
  local extract_dir="$profile_dir/extract"
  local home_dir="$profile_dir/home"
  local store_dir="$profile_dir/store"
  local bundle_path="$profile_dir/support-bundle.zip"
  local control_port web_port sim_port
  control_port="$(free_port)"
  web_port="$(free_port)"
  sim_port="$(free_port)"

  mkdir -p "$extract_dir" "$store_dir"
  write_fixture_config "$home_dir"

  tar -xzf "$tarball_path" -C "$extract_dir"

  local release_bin="$extract_dir/bin/$profile"
  if [ ! -x "$release_bin" ]; then
    echo "$profile: release bin missing or not executable: $release_bin" >&2
    exit 1
  fi

  case "$profile" in
    lemon_runtime_min | lemon_runtime_full)
      assert_bundled_browser_driver "$profile" "$extract_dir"
      ;;
  esac

  if [ "$profile" = "lemon_runtime_full" ]; then
    assert_full_profile_static_files "$profile" "$extract_dir"
  fi

  local env_vars=(
    "HOME=$home_dir"
    "LEMON_STORE_PATH=$store_dir"
    "LEMON_SECRETS_MASTER_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
    "LEMON_CONTROL_PLANE_PORT=$control_port"
    "LEMON_WEB_PORT=$web_port"
    "LEMON_SIM_UI_PORT=$sim_port"
    "LEMON_ROUTER_HEALTH_PORT=0"
    "LEMON_GATEWAY_HEALTH_PORT=0"
    "RELEASE_NODE=lemon_release_boot_$control_port"
    "RELEASE_DISTRIBUTION=sname"
    "RELEASE_COOKIE=runtime-boot-cookie-$profile"
    "LEMON_WEB_SECRET_KEY_BASE=runtime_boot_secret_key_base_runtime_boot_secret_key_base_runtime_boot"
    "LEMON_GATEWAY_NODE_COOKIE=runtime-boot-cookie-$profile"
    "PHX_SERVER=true"
  )

  if [ "$profile" = "sim_broadcast_platform" ]; then
    env_vars+=(
      "LEMON_SIM_UI_HOST=localhost"
      "LEMON_SIM_UI_SECRET_KEY_BASE=runtime_boot_sim_secret_key_base_runtime_boot_sim_secret_key_base_runtime"
      "LEMON_SIM_UI_ACCESS_TOKEN=runtime-boot-sim-access-token-32-bytes-minimum"
      "LEMON_ARENA_LEAGUE_ROOT=$profile_dir/leagues"
    )
  fi
  CLEANUP_RELEASE="$release_bin"
  CLEANUP_ENV=("${env_vars[@]}")

  run_with_env() {
    (
      cd "$extract_dir"
      env \
        -u LEMON_GIT_SHA \
        -u LEMON_GIT_BRANCH \
        -u GITHUB_SHA \
        -u SOURCE_VERSION \
        -u VERCEL_GIT_COMMIT_SHA \
        -u GITHUB_REF_NAME \
        -u VERCEL_GIT_COMMIT_REF \
        -u LEMON_MCP_DISABLED \
        "${env_vars[@]}" \
        "$@"
    )
  }
  run_release() { run_with_env "$release_bin" "$@"; }
  run_launcher() { run_with_env "$extract_dir/bin/lemon" "$@"; }

  if [ "$profile" = "lemon_runtime_min" ] || [ "$profile" = "lemon_runtime_full" ]; then
    run_release eval '
      checks = %{
        client_loaded: Code.ensure_loaded?(LemonMCP.Client),
        source_loaded: Code.ensure_loaded?(LemonSkills.McpSource),
        source_enabled: LemonSkills.McpSource.mcp_enabled?(),
        application_loaded:
          Enum.any?(Application.loaded_applications(), fn {app, _, _} ->
            app == :lemon_mcp
          end),
        application_not_started:
          not Enum.any?(Application.started_applications(), fn {app, _, _} ->
            app == :lemon_mcp
          end),
        no_application_callback: Application.spec(:lemon_mcp, :mod) == [],
        no_application_module: not Code.ensure_loaded?(LemonMCP.Application)
      }

      failures = for {name, false} <- checks, do: name

      if failures != [] do
        raise "packaged MCP library contract failed: #{inspect(failures)}"
      end

      IO.puts("packaged MCP library contract passed: #{inspect(checks)}")
    '
  fi

  if [ -n "$expected_commit" ]; then
    local build_info_output reported_commit
    build_info_output="$(run_release eval 'IO.puts("BUILD_COMMIT=" <> (LemonCore.BuildInfo.current().git.commit || ""))')"
    reported_commit="$(printf '%s\n' "$build_info_output" | sed -n 's/^BUILD_COMMIT=//p' | tail -1)"

    if [ "$reported_commit" != "$expected_commit" ]; then
      echo "$profile: embedded commit mismatch expected $expected_commit got ${reported_commit:-missing}" >&2
      exit 1
    fi
  fi

  if [ "$profile" = "sim_broadcast_platform" ]; then
    run_release daemon
  else
    run_launcher daemon
  fi

  if [ "$profile" = "sim_broadcast_platform" ]; then
    wait_for_health "http://127.0.0.1:$sim_port/readyz" "$profile sim-ui"
    # grep without -q reads all input: -q exits on the first match, and the
    # resulting EPIPE makes curl fail (exit 23) under pipefail.
    curl -fsS "http://127.0.0.1:$sim_port/" | grep '/assets/app-' >/dev/null

    # Unauthenticated operator surfaces: the browser route bounces to the
    # admin login form (RequireAccessToken on_failure: redirect), while the
    # JSON API rejects outright with 401.
    admin_headers=$(curl -sS -o /dev/null -D - "http://127.0.0.1:$sim_port/admin")
    admin_status=$(printf '%s' "$admin_headers" | head -1 | awk '{print $2}')
    case "$admin_status" in
      30[123578]) ;;
      *)
        echo "$profile: unauthenticated /admin returned $admin_status, expected a redirect to the login form" >&2
        exit 1
        ;;
    esac
    if ! printf '%s' "$admin_headers" | grep -qi '^location:.*/admin/login'; then
      echo "$profile: unauthenticated /admin did not redirect to /admin/login" >&2
      exit 1
    fi
    api_status=$(curl -sS -o /dev/null -w '%{http_code}' "http://127.0.0.1:$sim_port/api/admin/metrics")
    if [ "$api_status" != "401" ]; then
      echo "$profile: unauthenticated /api/admin/metrics returned $api_status, expected 401" >&2
      exit 1
    fi

    run_release rpc \
      'state = LemonSim.Examples.Werewolf.initial_state(sim_id: "artifact_werewolf", player_count: 5, seed: 7); state = LemonSim.Kernel.State.put_world(state, %{phase: "game_over", status: "game_over", winner: "villagers"}); LemonSim.Kernel.Store.put_state(state)'
    curl -fsS "http://127.0.0.1:$sim_port/watch/artifact_werewolf" | grep 'VILLAGERS WIN' >/dev/null

    run_release stop
    # `stop` returns as soon as the shutdown rpc is accepted, but the node
    # needs a moment to exit and release its epmd name registration; starting
    # the next daemon before that kills it with "name … seems to be in use".
    for _ in $(seq 1 30); do
      if ! run_release pid >/dev/null 2>&1; then
        break
      fi
      sleep 1
    done
    if run_release pid >/dev/null 2>&1; then
      echo "$profile: node did not exit within 30s of stop" >&2
      exit 1
    fi
    run_release daemon
    wait_for_health "http://127.0.0.1:$sim_port/readyz" "$profile restarted sim-ui"
    curl -fsS "http://127.0.0.1:$sim_port/watch/artifact_werewolf" | grep 'VILLAGERS WIN' >/dev/null
    run_release stop

    echo "ok $profile booted, enforced auth, served assets, and preserved spectator state"
  else
    wait_for_health "http://127.0.0.1:$control_port/healthz" "$profile control-plane"
    run_launcher status

    local help_output command
    help_output="$(run_launcher --help)"
    for command in tui web start run daemon stop restart status remote eval rpc setup model \
      gateway doctor config secrets channels providers blueprints profile backup context \
      sessions learn update completion migrate node version send media models policy skill usage; do
      if ! printf '%s\n' "$help_output" | grep -Eq "^  $command( |$)"; then
        echo "$profile: packaged 'lemon --help' did not list $command" >&2
        exit 1
      fi
    done

    # Help and version must work before setup and must not create secrets: a
    # fresh HOME has no persisted web secret for lemon_runtime_full's runtime.exs.
    local fresh_home="$profile_dir/fresh-home" args
    mkdir -p "$fresh_home"
    for args in "--help" "help doctor" "daemon --help" "acp --help" "--version"; do
      # shellcheck disable=SC2086 # word-split the argument list
      if ! run_with_env env -u LEMON_WEB_SECRET_KEY_BASE "HOME=$fresh_home" \
        "$extract_dir/bin/lemon" $args > /dev/null; then
        echo "$profile: packaged 'lemon $args' failed before setup" >&2
        exit 1
      fi
    done
    if [ -e "$fresh_home/.lemon/env" ]; then
      echo "$profile: help or version persisted $fresh_home/.lemon/env" >&2
      exit 1
    fi

    if [ -z "$(run_launcher version)" ]; then
      echo "$profile: packaged 'lemon version' printed nothing" >&2
      exit 1
    fi

    run_launcher models --provider anthropic --limit 1 --json > "$profile_dir/models.json"
    run_launcher usage --json > "$profile_dir/usage.json"
    run_launcher media --project-dir "$profile_dir" --limit 1 --json > "$profile_dir/media.json"
    run_launcher send --dry-run --to telegram:123 --json "release dispatch probe" \
      > "$profile_dir/send.json"
    run_launcher policy list
    run_launcher skill list
    python3 - "$profile_dir" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
def report(name):
    return json.loads((root / f"{name}.json").read_text(encoding="utf-8"))

models = report("models")
assert len(models["models"]) == 1
assert models["models"][0]["provider"] == "anthropic"
assert models["summary"]["includes_credentials"] is False
assert report("usage")["cleanup"]["includes_prompts"] is False
assert report("media")["cleanup"]["includes_prompts"] is False
sent = report("send")
assert sent["dry_run"] is True
assert sent["target"] == "123"
assert sent["content_bytes"] == len("release dispatch probe")
PY

    mkdir -p "$profile_dir/hermes"
    run_launcher migrate hermes audit --json --source "$profile_dir/hermes" \
      --target "$home_dir/.lemon" > "$profile_dir/hermes-audit.json"
    python3 - "$profile" "$profile_dir/hermes-audit.json" <<'PY'
import json
import sys

profile, path = sys.argv[1:]
text = open(path, encoding="utf-8").read()
start = text.find("{")
report = json.loads(text[start:]) if start >= 0 else {}
if "summary" not in report or not isinstance(report.get("items"), list):
    print(f"{profile}: packaged 'lemon migrate hermes audit --json' emitted no report", file=sys.stderr)
    sys.exit(1)
PY

    if [ "$profile" = "lemon_runtime_full" ]; then
      wait_for_health "http://127.0.0.1:$web_port/healthz" "$profile web"

      launcher_output="$(run_launcher web --no-open 2>&1)"
      if ! printf '%s\n' "$launcher_output" | grep -q "Lemon Web: http://127.0.0.1:$web_port/"; then
        echo "$profile: packaged 'lemon web --no-open' did not report the healthy Web URL" >&2
        printf '%s\n' "$launcher_output" >&2
        exit 1
      fi

      assert_no_asset_warmup_failure "$profile" "$extract_dir"
    fi

    run_launcher stop
    if run_launcher status; then
      echo "$profile: status succeeded after stop" >&2
      exit 1
    fi

    # Foreground start must be observable and stoppable from another launcher.
    run_launcher start > "$profile_dir/foreground.log" 2>&1 &
    local foreground_pid=$!
    wait_for_health "http://127.0.0.1:$control_port/healthz" "$profile foreground control-plane"
    run_launcher status
    run_launcher stop
    wait "$foreground_pid" || true
    if run_launcher status; then
      echo "$profile: status succeeded after foreground stop" >&2
      exit 1
    fi
    run_release eval "LemonCore.Doctor.CLI.bundle!(bundle_path: \"$bundle_path\")"

    if [ ! -f "$bundle_path" ]; then
      echo "$profile: support bundle was not created at $bundle_path" >&2
      exit 1
    fi

    verify_support_bundle "$profile" "$bundle_path"

    echo "ok $profile booted, health checked, and generated support bundle"
  fi
}

if [ "$MODE" = "single" ]; then
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/lemon-release-boot.XXXXXX")"
  trap 'cleanup_work_dir "$work_dir"' EXIT

  boot_one_profile "$SINGLE_PROFILE" "$SINGLE_TARBALL" "$work_dir" ""

  echo "verified release runtime boot for 1 profile (single mode: $SINGLE_PROFILE)"
  exit 0
fi

"$ROOT/scripts/verify_release_artifacts" --platform "$PLATFORM_FILTER" "$ARTIFACT_DIR"

work_dir="$(mktemp -d "${TMPDIR:-/tmp}/lemon-release-boot.XXXXXX")"
trap 'cleanup_work_dir "$work_dir"' EXIT

verified_profiles=0
expected_commit="$(manifest_commit)"

while IFS=$'\t' read -r profile filename; do
  [ -n "$profile" ] || continue
  boot_one_profile "$profile" "$ARTIFACT_DIR/$filename" "$work_dir" "$expected_commit"
  verified_profiles=$((verified_profiles + 1))
done < <(manifest_entries)

expected_count="$(expected_profile_count "$PLATFORM_FILTER")"
if [ "$verified_profiles" -ne "$expected_count" ]; then
  echo "expected to boot $expected_count release profile(s) for $PLATFORM_FILTER, verified $verified_profiles" >&2
  exit 1
fi

echo "verified release runtime boot for $verified_profiles profile(s) on $PLATFORM_FILTER"
