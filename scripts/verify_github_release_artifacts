#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: scripts/verify_github_release_artifacts [--platform <tag>] <tag-or-version> [download-directory]

Downloads a GitHub Release's manifest.json plus the tarballs for one
platform, then verifies file size, SHA-256, release boot, health, and
support-bundle generation with scripts/verify_release_runtime_boot.
The release lookup and asset download retry by default; override with
LEMON_RELEASE_VERIFY_ATTEMPTS and LEMON_RELEASE_VERIFY_SLEEP_SECONDS.

Platform tags: linux-x86_64, linux-arm64, darwin-arm64 (default: detected
from `uname`, i.e. the platform this script is running on).

Examples:
  scripts/verify_github_release_artifacts v2026.05.0
  scripts/verify_github_release_artifacts --platform linux-arm64 2026.05.0 /tmp/lemon-release-download
EOF
  exit 2
}

detect_platform() {
  case "$(uname -s)" in
    Linux)
      case "$(uname -m)" in
        x86_64) echo "linux-x86_64" ;;
        aarch64|arm64) echo "linux-arm64" ;;
        *) echo "unknown-linux-$(uname -m)" ;;
      esac
      ;;
    Darwin)
      case "$(uname -m)" in
        arm64) echo "darwin-arm64" ;;
        *) echo "unknown-darwin-$(uname -m)" ;;
      esac
      ;;
    *)
      echo "unknown-$(uname -s)"
      ;;
  esac
}

# Platform -> release profiles, duplicated (with this cross-reference) from
# the EXPECTED table in scripts/verify_release_artifacts: min+full+lemon_tui
# on every platform.
platform_profiles() {
  case "$1" in
    linux-x86_64|linux-arm64|darwin-arm64)
      echo "lemon_runtime_min lemon_runtime_full lemon_tui"
      ;;
    *)
      echo ""
      ;;
  esac
}

PLATFORM=""
POSITIONAL=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --platform)
      [ "$#" -ge 2 ] || usage
      PLATFORM="$2"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    --*)
      usage
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [ "${#POSITIONAL[@]}" -lt 1 ] || [ "${#POSITIONAL[@]}" -gt 2 ]; then
  usage
fi

if [ -z "$PLATFORM" ]; then
  PLATFORM="$(detect_platform)"
fi

PROFILES="$(platform_profiles "$PLATFORM")"
if [ -z "$PROFILES" ]; then
  echo "unsupported platform: $PLATFORM (expected linux-x86_64, linux-arm64, or darwin-arm64)" >&2
  exit 2
fi

TAG="${POSITIONAL[0]}"
case "$TAG" in
  v*) ;;
  *) TAG="v$TAG" ;;
esac

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DOWNLOAD_DIR="${POSITIONAL[1]:-${TMPDIR:-/tmp}/lemon-release-download-${TAG#v}}"
CALLER_PROVIDED_DIR=false
if [ "${#POSITIONAL[@]}" -eq 2 ]; then
  CALLER_PROVIDED_DIR=true
fi
ATTEMPTS="${LEMON_RELEASE_VERIFY_ATTEMPTS:-10}"
SLEEP_SECONDS="${LEMON_RELEASE_VERIFY_SLEEP_SECONDS:-6}"

if ! command -v gh >/dev/null 2>&1; then
  echo "gh CLI is required to download GitHub Release artifacts" >&2
  exit 2
fi

case "$ATTEMPTS" in
  ''|*[!0-9]*|0)
    echo "LEMON_RELEASE_VERIFY_ATTEMPTS must be a positive integer" >&2
    exit 2
    ;;
esac

case "$SLEEP_SECONDS" in
  ''|*[!0-9]*)
    echo "LEMON_RELEASE_VERIFY_SLEEP_SECONDS must be a non-negative integer" >&2
    exit 2
    ;;
esac

release_found=false
for attempt in $(seq 1 "$ATTEMPTS"); do
  if gh release view "$TAG" >/dev/null 2>&1; then
    release_found=true
    break
  fi

  if [ "$attempt" -lt "$ATTEMPTS" ]; then
    echo "GitHub Release not found yet: $TAG (attempt $attempt/$ATTEMPTS); retrying in ${SLEEP_SECONDS}s" >&2
    sleep "$SLEEP_SECONDS"
  fi
done

if ! $release_found; then
  echo "GitHub Release not found: $TAG" >&2
  exit 66
fi

if [ -z "$DOWNLOAD_DIR" ] || [ "$DOWNLOAD_DIR" = "/" ]; then
  echo "invalid download directory: $DOWNLOAD_DIR" >&2
  exit 2
fi

if $CALLER_PROVIDED_DIR; then
  mkdir -p "$DOWNLOAD_DIR"
  if [ -n "$(find "$DOWNLOAD_DIR" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    echo "download directory must be empty: $DOWNLOAD_DIR" >&2
    exit 2
  fi
else
  rm -rf "$DOWNLOAD_DIR"
  mkdir -p "$DOWNLOAD_DIR"
fi

download_patterns=(--pattern "manifest.json")
for profile in $PROFILES; do
  download_patterns+=(--pattern "lemon-*-${PLATFORM}-${profile}.tar.gz")
done

downloaded=false
for attempt in $(seq 1 "$ATTEMPTS"); do
  find "$DOWNLOAD_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} +

  if gh release download "$TAG" \
    --dir "$DOWNLOAD_DIR" \
    "${download_patterns[@]}"; then
    downloaded=true
    break
  fi

  if [ "$attempt" -lt "$ATTEMPTS" ]; then
    echo "GitHub Release assets not ready for $TAG (attempt $attempt/$ATTEMPTS); retrying in ${SLEEP_SECONDS}s" >&2
    sleep "$SLEEP_SECONDS"
  fi
done

if ! $downloaded; then
  echo "failed to download GitHub Release artifacts for $TAG" >&2
  exit 66
fi

"$ROOT/scripts/verify_release_runtime_boot" --platform "$PLATFORM" "$DOWNLOAD_DIR"

echo "downloaded and verified GitHub Release artifacts, and booted BEAM releases, for $TAG ($PLATFORM) in $DOWNLOAD_DIR"
