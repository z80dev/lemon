#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: scripts/verify_source_install [--project-dir PATH] [--skip-compile] [--skip-doctor]

Verifies the supported source-install path:
  - checks Elixir and Erlang/OTP toolchain availability
  - checks the unified command registry help lists every launcher and CLI command
  - checks locked dependency resolution
  - checks source-wrapper setup readiness is required before fixture onboarding,
    then satisfied by a locally stored fixture credential and default model,
    and that `setup --if-required` is then a no-op
  - checks source-wrapper non-interactive setup runtime dispatch
  - checks source-wrapper channel configuration status
  - checks source-wrapper config validation
  - checks source-wrapper media diagnostics
  - checks source-wrapper model catalog listing
  - checks source-wrapper provider readiness listing
  - checks source-wrapper model policy listing
  - checks source-wrapper secrets status
  - checks source-wrapper skill listing
  - checks source-wrapper usage diagnostics
  - checks source-checkout `update plan` fails closed before mutation
  - checks `version` and the read-only Hermes migration audit
  - runs source-wrapper doctor JSON diagnostics and support-bundle generation unless --skip-doctor is set
EOF
  exit 2
}

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PROJECT_DIR="$ROOT"
SKIP_COMPILE=false
# asdf shims resolve their tool installations relative to HOME unless this is
# explicit. Fixture commands replace HOME to isolate Lemon state, so retain the
# invoking shell's asdf data directory when it is available. Plain system/Mise
# installs keep this empty and are unaffected.
toolchain_asdf_data_dir="${ASDF_DATA_DIR:-}"
if [ -z "$toolchain_asdf_data_dir" ] && [ -n "${HOME:-}" ] && [ -d "$HOME/.asdf" ]; then
  toolchain_asdf_data_dir="$HOME/.asdf"
fi

# Fixture commands replace HOME to isolate Lemon state. Keep Mix/Hex tooling
# discoverable without copying or initializing package-manager state inside the
# fixture home.
toolchain_mix_home="${MIX_HOME:-}"
toolchain_hex_home="${HEX_HOME:-}"
if [ -n "${HOME:-}" ]; then
  [ -n "$toolchain_mix_home" ] || toolchain_mix_home="$HOME/.mix"
  [ -n "$toolchain_hex_home" ] || toolchain_hex_home="$HOME/.hex"
fi

SKIP_DOCTOR=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --project-dir)
      [ "$#" -ge 2 ] || usage
      PROJECT_DIR="$2"
      shift 2
      ;;
    --skip-compile)
      SKIP_COMPILE=true
      shift
      ;;
    --skip-doctor)
      SKIP_DOCTOR=true
      shift
      ;;
    -h|--help)
      usage
      ;;
    *)
      usage
      ;;
  esac
done

cd "$ROOT"

fail() {
  echo "error $*" >&2
  exit 1
}

ok() {
  echo "ok $*"
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "$1 not found on PATH"
  fi

  ok "$1 found: $(command -v "$1")"
}

require_command elixir
require_command mix

elixir -e '
required = Version.parse!("1.19.5")
current = Version.parse!(System.version())
if Version.compare(current, required) == :lt do
  IO.puts(:stderr, "error Elixir #{System.version()} is below required 1.19.5")
  System.halt(1)
end
IO.puts("ok Elixir #{System.version()} >= 1.19.5")
'

elixir -e '
otp =
  :erlang.system_info(:otp_release)
  |> List.to_string()
  |> String.to_integer()

if otp < 28 do
  IO.puts(:stderr, "error Erlang/OTP #{otp} is below required major 28")
  System.halt(1)
end

IO.puts("ok Erlang/OTP #{otp} >= 28")
'

mix deps.get --check-locked
ok "dependencies resolve without lockfile drift"

# Every wrapper probe below runs in the dev environment, so this is the only
# umbrella compile; later wrapper calls find the build current.
if ! $SKIP_COMPILE; then
  MIX_ENV=dev mix compile --warnings-as-errors
  ok "dev compile passes with warnings as errors"
fi

onboarding_home="$(mktemp -d "${TMPDIR:-/tmp}/lemon-source-install-onboarding.XXXXXX")"
onboarding_project="$(mktemp -d "${TMPDIR:-/tmp}/lemon-source-install-project.XXXXXX")"
onboarding_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-onboarding.XXXXXX")"
onboarding_master_key="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
setup_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-runtime.XXXXXX")"
setup_required_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-setup-required.XXXXXX")"
channels_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-channels.XXXXXX")"
config_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-config.XXXXXX")"
media_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-media.XXXXXX")"
models_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-models.XXXXXX")"
providers_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-providers.XXXXXX")"
policy_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-policy.XXXXXX")"
secrets_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-secrets.XXXXXX")"
skill_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-skill.XXXXXX")"
usage_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-usage.XXXXXX")"
update_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-update.XXXXXX")"
version_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-version.XXXXXX")"
help_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-help.XXXXXX")"
migrate_output="$(mktemp "${TMPDIR:-/tmp}/lemon-source-install-migrate.XXXXXX")"
hermes_home="$(mktemp -d "${TMPDIR:-/tmp}/lemon-source-install-hermes.XXXXXX")"
cleanup_setup_output() {
  rm -rf "$onboarding_home"
  rm -rf "$onboarding_project"
  rm -f "$onboarding_output"
  rm -f "$setup_output"
  rm -f "$setup_required_output"
  rm -f "$channels_output"
  rm -f "$config_output"
  rm -f "$media_output"
  rm -f "$models_output"
  rm -f "$providers_output"
  rm -f "$policy_output"
  rm -f "$secrets_output"
  rm -f "$skill_output"
  rm -f "$usage_output"
  rm -f "$update_output"
  rm -f "$version_output"
  rm -f "$help_output"
  rm -f "$migrate_output"
  rm -rf "$hermes_home"
}
preserve_toolchain() {
  if [ -n "$toolchain_asdf_data_dir" ]; then
    export ASDF_DATA_DIR="$toolchain_asdf_data_dir"
  fi
  if [ -n "$toolchain_mix_home" ]; then
    export MIX_HOME="$toolchain_mix_home"
  fi
  if [ -n "$toolchain_hex_home" ]; then
    export HEX_HOME="$toolchain_hex_home"
  fi
}

# Keep fixture readiness independent of any developer or CI credential that
# could otherwise satisfy a configured default provider through env fallback.
clear_provider_credentials() {
  unset \
    ANTHROPIC_API_KEY ANTHROPIC_TOKEN CLAUDE_CODE_OAUTH_TOKEN \
    OPENAI_API_KEY OPENAI_CODEX_API_KEY CHATGPT_TOKEN \
    GITHUB_TOKEN GH_TOKEN \
    GOOGLE_GENERATIVE_AI_API_KEY GOOGLE_API_KEY GEMINI_API_KEY \
    AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN \
    AZURE_OPENAI_API_KEY GROQ_API_KEY MISTRAL_API_KEY XAI_API_KEY \
    CEREBRAS_API_KEY KIMI_API_KEY MOONSHOT_API_KEY OPENCODE_API_KEY \
    OPENROUTER_API_KEY PERPLEXITY_API_KEY
}
# Every probe uses the dev environment. config/test.exs replaces HOME with a
# fresh temporary directory and keeps the store in ETS, so a test-mode probe
# would see neither the fixture home nor a credential an earlier process wrote.
# Dev uses the durable encrypted store at LEMON_STORE_PATH.
run_onboarding() {
  local output="$1"
  shift

  (
    cd "$onboarding_project"
    clear_provider_credentials
    preserve_toolchain

    HOME="$onboarding_home" \
      XDG_CONFIG_HOME="$onboarding_home/.config" \
      XDG_DATA_HOME="$onboarding_home/.local/share" \
      XDG_CACHE_HOME="$onboarding_home/.cache" \
      LEMON_STORE_PATH="$onboarding_home/.lemon/store" \
      LEMON_SECRETS_MASTER_KEY="$onboarding_master_key" \
      MIX_ENV=dev \
      "$ROOT/bin/lemon" "$@"
  ) >"$output" 2>&1
}

# Doctor JSON goes to stdout and diagnostics to stderr; keep them apart so the
# JSON parses.
run_onboarding_split_output() {
  local output="$1" error_output="$2"
  shift 2

  (
    cd "$onboarding_project"
    clear_provider_credentials
    preserve_toolchain

    HOME="$onboarding_home" \
      XDG_CONFIG_HOME="$onboarding_home/.config" \
      XDG_DATA_HOME="$onboarding_home/.local/share" \
      XDG_CACHE_HOME="$onboarding_home/.cache" \
      LEMON_STORE_PATH="$onboarding_home/.lemon/store" \
      LEMON_SECRETS_MASTER_KEY="$onboarding_master_key" \
      MIX_ENV=dev \
      "$ROOT/bin/lemon" "$@"
  ) >"$output" 2>"$error_output"
}

run_onboarding_help() {
  run_onboarding "$onboarding_output" "$@"
}

assert_setup_required() {
  local expected="$1"

  if (
    clear_provider_credentials
    preserve_toolchain


    HOME="$onboarding_home" \
      XDG_CONFIG_HOME="$onboarding_home/.config" \
      XDG_DATA_HOME="$onboarding_home/.local/share" \
      XDG_CACHE_HOME="$onboarding_home/.cache" \
      LEMON_STORE_PATH="$onboarding_home/.lemon/store" \
      LEMON_SECRETS_MASTER_KEY="$onboarding_master_key" \
      LEMON_EXPECT_SETUP_REQUIRED="$expected" \
      LEMON_ONBOARDING_PROJECT="$onboarding_project" \
      MIX_ENV=dev \
      mix run --no-start -e '
        expected = System.fetch_env!("LEMON_EXPECT_SETUP_REQUIRED") == "true"

        actual =
          File.cd!(System.fetch_env!("LEMON_ONBOARDING_PROJECT"), fn ->
            LemonCli.CLI.setup_required?()
          end)

        if actual != expected do
          IO.puts(:stderr, "expected setup_required?=#{expected}, got #{actual}")
          System.halt(1)
        end
      '
  ) >"$setup_required_output" 2>&1; then
    ok "source-wrapper setup_required? is $expected"
  else
    cat "$setup_required_output" >&2
    fail "source-wrapper setup_required? was not $expected"
  fi
}

assert_setup_required true

run_onboarding "$onboarding_output" model \
  --non-interactive \
  --provider openai \
  --token source-install-fixture-token \
  --secret-name source_install_fixture_openai \
  --set-default \
  --model gpt-5

grep -q "OpenAI onboarding complete." "$onboarding_output" ||
  fail "fixture provider onboarding did not complete"

assert_setup_required false
run_onboarding "$onboarding_output" setup --if-required || {
  cat "$onboarding_output" >&2
  fail "setup --if-required failed on a configured fixture"
}
if grep -q "Setup is required" "$onboarding_output"; then
  fail "setup --if-required re-ran setup on a configured fixture"
fi
ok "setup --if-required is a no-op once setup is complete"

run_onboarding_help setup --help
grep -qi "setup" "$onboarding_output" ||
  fail "installed-style setup help did not identify the setup command"

run_onboarding_help model --help
grep -qi "model" "$onboarding_output" ||
  fail "installed-style model help did not identify the model command"

run_onboarding_help gateway setup --help
grep -qi "gateway" "$onboarding_output" ||
  fail "installed-style gateway setup help did not identify the gateway command"

ok "installed-style onboarding commands are discoverable without provider credentials"

run_onboarding "$help_output" --help
for command in tui web start run daemon stop restart status setup model gateway doctor \
  config secrets channels providers blueprints profile backup context sessions learn update \
  completion migrate node version send media models policy skill usage; do
  grep -Eq "^  $command( |$)" "$help_output" ||
    fail "source help did not list $command"
done
if grep -Eq "^  (remote|eval|rpc) " "$help_output"; then
  fail "source help advertised a packaged-release-only command"
fi
ok "source-wrapper help lists the unified command registry"

run_onboarding_help web --help
grep -Fq 'Usage: lemon web [--no-open]' "$onboarding_output" ||
  fail "source wrapper web help did not document --no-open"
ok "launcher command help comes from the shared registry"

run_onboarding "$setup_output" setup runtime --profile runtime_min --non-interactive
grep -q "mix release lemon_runtime_min" "$setup_output" ||
  fail "setup runtime output did not include lemon_runtime_min release command"
ok "non-interactive setup runtime dispatch works"

# The remaining probes are read-only and independent, so each runs concurrently
# in its own cold VM. A cold VM per command is the point: it catches a command
# that does not start an application it needs under `--no-start`. The dev build
# is current, so skip the wrapper's per-call `mix compile` rather than racing a
# dozen no-op compiles for the build lock.
probe_pids=()
probe_expect=()
probe_labels=()
probe_outputs=()

start_probe() {
  local expect="$1" label="$2" output="$3"
  shift 3

  (
    export SOURCE_COMPILED=1
    run_onboarding "$output" "$@"
  ) &
  probe_pids+=("$!")
  probe_expect+=("$expect")
  probe_labels+=("$label")
  probe_outputs+=("$output")
}

start_probe success channels "$channels_output" channels --project-dir "$PROJECT_DIR"
start_probe success "config validate" "$config_output" config validate --project-dir "$PROJECT_DIR"
start_probe success media "$media_output" media --project-dir "$PROJECT_DIR" --limit 1
start_probe success models "$models_output" models --provider anthropic --limit 1
start_probe success providers "$providers_output" providers --provider anthropic --project-dir "$PROJECT_DIR"
start_probe success "policy list" "$policy_output" policy list
start_probe success "secrets status" "$secrets_output" secrets status
start_probe success "skill list" "$skill_output" skill list
start_probe success usage "$usage_output" usage
start_probe failure "update plan" "$update_output" update plan
start_probe success version "$version_output" version
start_probe success "migrate hermes audit" "$migrate_output" migrate hermes audit --json \
  --source "$hermes_home" --target "$onboarding_home/.lemon"

probe_failures=0
for i in "${!probe_pids[@]}"; do
  status=0
  wait "${probe_pids[$i]}" || status=$?
  case "${probe_expect[$i]}:$status" in
    success:0 | failure:[1-9]*) ;;
    success:*)
      cat "${probe_outputs[$i]}" >&2
      echo "error ${probe_labels[$i]} exited $status" >&2
      probe_failures=$((probe_failures + 1))
      ;;
    *)
      echo "error ${probe_labels[$i]} unexpectedly succeeded" >&2
      probe_failures=$((probe_failures + 1))
      ;;
  esac
done
[ "$probe_failures" -eq 0 ] || fail "$probe_failures concurrent CLI probe(s) failed"

grep -q "Lemon Channels" "$channels_output" ||
  fail "channels output did not include channels heading"
grep -q "^telegram: enabled=" "$channels_output" ||
  fail "channels output did not report Telegram configuration"
grep -q "^discord: enabled=" "$channels_output" ||
  fail "channels output did not report Discord configuration"
ok "source-wrapper channel configuration status works"

grep -q "Configuration is valid" "$config_output" ||
  fail "config validation output did not report a valid configuration"
ok "source-wrapper config validation works"

grep -q "Lemon Media" "$media_output" ||
  fail "media output did not include media heading"
grep -q "Includes prompts: false" "$media_output" ||
  fail "media output did not document prompt cleanup"
grep -q "Includes provider responses: false" "$media_output" ||
  fail "media output did not document provider-response cleanup"
ok "source-wrapper media diagnostics work"

grep -q "Lemon Models" "$models_output" ||
  fail "models output did not include catalog heading"
grep -q "Includes credentials: false" "$models_output" ||
  fail "models output did not document credential cleanup"
ok "source-wrapper model catalog listing works"

grep -q "Lemon Providers" "$providers_output" ||
  fail "providers output did not include readiness heading"
ok "source-wrapper provider readiness listing works"

grep -Eq "No model policies set\.|Model Policies:" "$policy_output" ||
  fail "policy list output did not report model policy state"
ok "source-wrapper model policy listing works"

grep -q "configured:" "$secrets_output" ||
  fail "secrets status output did not include configured state"
grep -q "count:" "$secrets_output" ||
  fail "secrets status output did not include secret count"
ok "source-wrapper secrets status works"

grep -Eq "KEY|No skills installed" "$skill_output" ||
  fail "skill list output did not report installed skill state"
ok "source-wrapper skill listing works"

grep -q "Lemon Usage" "$usage_output" ||
  fail "usage output did not include usage heading"
grep -q "Includes prompts: false" "$usage_output" ||
  fail "usage output did not document prompt cleanup"
grep -q "Includes credentials: false" "$usage_output" ||
  fail "usage output did not document credential cleanup"
ok "source-wrapper usage diagnostics work"

grep -q "Source checkouts cannot plan, apply, or roll back release artifacts" "$update_output" ||
  fail "update plan did not document the source-checkout update boundary"
ok "source-checkout update plan fails closed"

grep -Eq '^[0-9]+\.[0-9]+' "$version_output" ||
  fail "version did not print a Lemon version"
ok "version dispatch works: $(grep -E '^[0-9]+\.[0-9]+' "$version_output" | head -n 1)"

python3 - "$migrate_output" <<'PY'
import json
import sys

text = open(sys.argv[1], encoding="utf-8").read()
start = text.find("{")
if start < 0:
    print("error migrate hermes audit did not emit JSON", file=sys.stderr)
    raise SystemExit(1)

report = json.loads(text[start:])
if "summary" not in report or not isinstance(report.get("items"), list):
    print("error migrate hermes audit JSON lacks summary/items", file=sys.stderr)
    raise SystemExit(1)

print("ok read-only Hermes migration audit works")
PY

if ! $SKIP_DOCTOR; then
  work_dir="$(mktemp -d "${TMPDIR:-/tmp}/lemon-source-install.XXXXXX")"
  cleanup() {
    rm -rf "$work_dir"
    cleanup_setup_output
  }
  trap cleanup EXIT

  doctor_json="$work_dir/doctor.json"
  doctor_err="$work_dir/doctor.err"
  bundle_path="$work_dir/support-bundle.zip"

  set +e
  run_onboarding_split_output "$doctor_json" "$doctor_err" doctor --json --project-dir "$PROJECT_DIR" \
    --bundle --bundle-path "$bundle_path"
  doctor_status=$?
  set -e

  python3 - "$doctor_json" "$doctor_status" <<'PY'
import json
import sys

path, status = sys.argv[1], int(sys.argv[2])
text = open(path, encoding="utf-8").read()
start = text.find("{")
if start < 0:
    print("error doctor did not emit JSON", file=sys.stderr)
    raise SystemExit(1)

data = json.loads(text[start:])
summary = data.get("summary", {})
overall = data.get("overall")
failures = int(summary.get("fail", 0))

if status != 0 or failures:
    failed = [
        check.get("name") or check.get("id")
        for check in data.get("checks", [])
        if isinstance(check, dict) and check.get("status") == "fail"
    ]
    print(
        f"error doctor reported failures: status={status} overall={overall} fail={failures} checks={failed}",
        file=sys.stderr,
    )
    raise SystemExit(1)

print(
    "ok doctor JSON diagnostics completed "
    f"overall={overall} pass={summary.get('pass', 0)} warn={summary.get('warn', 0)} skip={summary.get('skip', 0)}"
)
PY

  python3 - "$bundle_path" <<'PY'
import sys
import zipfile

required = {
    "README.txt",
    "doctor_report.json",
    "channel_diagnostics.json",
}
path = sys.argv[1]

try:
    with zipfile.ZipFile(path) as archive:
        names = set(archive.namelist())
except zipfile.BadZipFile:
    print(f"error support bundle is not a valid zip: {path}", file=sys.stderr)
    raise SystemExit(1)

missing = sorted(required - names)
if missing:
    print(
        "error support bundle missing required entries: " + ", ".join(missing),
        file=sys.stderr,
    )
    raise SystemExit(1)

print("ok support bundle contains required redacted diagnostics")
PY
fi

echo "verified source install path"
