# Build context for docker/Dockerfile.runtime (whole umbrella, lemon_runtime_full).
#
# This is a denylist: anything not excluded here is sent to the daemon. What the
# prod build needs and must therefore survive: mix.exs, mix.lock, config/, every
# app under apps/ (Mix compiles all umbrella children, not just the ones named in
# a release), rel/ (release overlays), the committed priv/static assets, and
# clients/lemon-browser-node (the browser driver runtime releases bundle).

# VCS, CI metadata and agent scratch dirs
.git
.github
.agents
.claude
.codex
.expert
**/.expert
.factory
.hermes
.pi
.omp
.worktrees
.DS_Store

# Build output and caches — regenerated inside the image
_build
deps
tmp
**/tmp
**/cover
**/doc
node_modules
**/node_modules
erl_crash.dump
*.log
# The LemonCore.ConfinedFS helper is compiled per platform inside the image.
apps/lemon_core/priv/lemon_confined_fs
apps/lemon_core/priv/.lemon_confined_fs.platform

# Local state and secrets — must never reach an image layer
.lemon
.env*
**/.env
**/.env.*
*.db3
*.db3-shm
*.db3-wal

# Not referenced by any production compile path.
bench
bin
clients
docs
examples
installer
scripts
showcase
tools

# Re-included: `mix release` builds the browser driver it bundles into
# lemon_browser's priv. Its install and build output are regenerated.
!clients/tsconfig.base.json
!clients/lemon-browser-node
clients/lemon-browser-node/node_modules
clients/lemon-browser-node/dist
clients/lemon-browser-node/coverage
