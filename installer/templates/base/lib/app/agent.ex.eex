defmodule <%= @app_module %>.Agent do
  @moduledoc """
  The agent: a model, a system prompt, a tool list, and a supervised process
  that runs the loop.

  `LemonAgent.Agent` is a GenServer. It holds the conversation, streams the
  model's response, executes tool calls, and feeds the results back until the
  model stops asking for tools. This module is the thin layer that decides
  *which* model, prompt and tools — the parts that are yours.

  The process is started by `<%= @app_module %>.Application`, so there is one
  long-lived agent named `#{inspect(__MODULE__)}`. Start more with
  `start_link(name: SomeOtherName)` when you want a conversation per user.
  """

  alias LemonAgent.Types.AgentState
  alias LemonAi.Types.AssistantMessage

  @system_prompt """
  You are a concise assistant.

  You have tools. When a question can be answered by calling one, call it
  instead of guessing — a wrong number stated confidently is worse than a
  tool call.
  """

  @doc """
  Starts the agent.

  Options are passed through to `LemonAgent.new_agent/1`. The ones worth knowing:

    * `:name` — the registered name. Defaults to this module.
    * `:model` — an `LemonAi.Types.Model`. Defaults to `model/0`.
    * `:tools` — the tool list. Defaults to `tools/0`.
    * `:stream_fn` — replaces the function that talks to the provider. This is
      the seam the test suite uses to run without an API key; see
      `test/support/fake_llm.ex`.
  """
  def start_link(opts \\ []) do
    opts
    |> Keyword.put_new(:name, __MODULE__)
    |> Keyword.put_new_lazy(:model, &model/0)
    |> Keyword.put_new(:system_prompt, @system_prompt)
    |> Keyword.put_new_lazy(:tools, &tools/0)
    |> LemonAgent.new_agent()
  end

  def child_spec(opts) do
    %{id: Keyword.get(opts, :name) || __MODULE__, start: {__MODULE__, :start_link, [opts]}}
  end

  @doc """
  Sends a prompt and blocks until the agent has finished answering.

  Returns `{:ok, answer}` with the final assistant text, or `{:error, reason}`
  if the run failed. A run may involve several model calls and any number of
  tool executions; this returns only the last thing the assistant said. Use
  `LemonAgent.subscribe/2` when you want to see the run as it happens —
  `<%= @app_module %>.Console` does exactly that.
  """
  def ask(prompt) when is_binary(prompt), do: ask(__MODULE__, prompt)

  def ask(agent, prompt) when is_binary(prompt) do
    with :ok <- LemonAgent.prompt(agent, prompt),
         :ok <- LemonAgent.wait_for_idle(agent) do
      case LemonAgent.get_state(agent) do
        %AgentState{error: nil} = state -> {:ok, last_answer(state)}
        %AgentState{error: error} -> {:error, error}
      end
    end
  end

  @doc """
  The tools this agent may call.

  The list is our own tools plus any contributed at runtime through
  `LemonAgent.ToolRegistry`. That registry is how a dependency adds a tool to
  your agent without you naming it here: it calls
  `LemonAgent.ToolRegistry.register(:name, Module)` when its application starts.
  `available/1` drops any registration whose name collides with one of ours, so
  a dependency can never quietly replace a tool you wrote.
  """
  def tools do
    builtin = [<%= @app_module %>.Tools.WordCount.tool()]
    taken = Enum.map(builtin, &String.to_atom(&1.name))

    contributed =
      for {_name, module} <- LemonAgent.ToolRegistry.available(taken), do: module.tool()

    builtin ++ contributed
  end

  @doc """
  The model to run, from application config.

  `LemonAi.Models` is a registry of known models across twenty-odd providers; it
  carries the context window, pricing and capability flags the loop needs. The
  API key is read from the provider's environment variable at request time
  (`ANTHROPIC_API_KEY` for the default below).
  """
  def model do
    provider = Application.get_env(:<%= @app %>, :provider)
    id = Application.get_env(:<%= @app %>, :model)

    LemonAi.Models.get_model(provider, id) ||
      raise """
      Unknown model #{inspect(provider)} / #{inspect(id)}.

      Check config/config.exs. `LemonAi.Models.get_model_ids(#{inspect(provider)})`
      lists what this provider offers.
      """
  end

  defp last_answer(%AgentState{messages: messages}) do
    messages
    |> Enum.reverse()
    |> Enum.find_value("", fn
      %AssistantMessage{} = message -> LemonAi.get_text(message)
      _other -> nil
    end)
  end
end
