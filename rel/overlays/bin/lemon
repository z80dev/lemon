#!/usr/bin/env bash
#
# lemon - launcher for a packaged Lemon release (copied into every release
# profile by Mix's rel/overlays convention; it never touches RELEASE_NAME).
#
# The shell owns only what cannot run inside a release VM: locating the
# profile executable, per-user defaults under ~/.lemon, the managed
# control-plane credential, runtime lifecycle and health waits, and exec'ing
# the TUI. Every other command is dispatched by LemonCli.CLI from
# LemonCli.CommandRegistry -- the same registry ./bin/lemon uses in a source
# checkout. Run `lemon --help` for the command list.
#
#   lemon                    # interactive terminal: TUI (starts the runtime if needed)
#   lemon start              # foreground runtime
#   lemon daemon|stop|restart|status|remote|eval|rpc
#   lemon <command> [args]   # setup, doctor, sessions, migrate, ... via LemonCli.CLI

set -euo pipefail

info() { printf '\033[0;32m[lemon]\033[0m %s\n' "$1"; }
warn() { printf '\033[0;33m[lemon]\033[0m %s\n' "$1"; }
error() { printf '\033[0;31m[lemon]\033[0m %s\n' "$1" >&2; }

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
LEMON_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"

PROFILE=""
for candidate in lemon_runtime_full lemon_runtime_min sim_broadcast_platform; do
  if [ -x "$LEMON_ROOT/bin/$candidate" ]; then
    PROFILE="$candidate"
    break
  fi
done
if [ -z "$PROFILE" ]; then
  error "no runtime profile found under $LEMON_ROOT/bin"
  exit 1
fi

RELEASE_BIN="$LEMON_ROOT/bin/$PROFILE"
TUI_BIN="$LEMON_ROOT/tui/bin/lemon-tui"
CLI_EXPR='LemonCli.CLI.main(System.argv())'
LEMON_HOME_DIR="$HOME/.lemon"
STATE_DIR="$LEMON_HOME_DIR/run"
PORT="${LEMON_CONTROL_PLANE_PORT:-4040}"
WEB_PORT="${LEMON_WEB_PORT:-4080}"
SIM_PORT="${LEMON_SIM_UI_PORT:-4090}"
LOG_PATH="${RELEASE_TMP:-$LEMON_ROOT/tmp}/log"
export LEMON_RUNTIME_LOG_DIR="$LOG_PATH"
PIDFILE="${LEMON_RUNTIME_PID_FILE:-$STATE_DIR/lemon-$PORT.pid}"
ROOTFILE="$STATE_DIR/lemon-$PORT.root"
export LEMON_CLI_LAUNCHER=release LEMON_LAUNCHER="$SCRIPT_DIR/lemon"
export LEMON_RUNTIME_PROFILE="${PROFILE#lemon_}"

for port in "$PORT" "$WEB_PORT" "$SIM_PORT"; do
  if [[ ! "$port" =~ ^[0-9]{1,5}$ ]] || ((10#$port < 1 || 10#$port > 65535)); then
    error "invalid port value: $port (expected 1-65535)"
    exit 2
  fi
done

require_curl() {
  command -v curl >/dev/null 2>&1 || {
    error "curl is required for health checks; install it and retry"
    exit 1
  }
}

control_port_in_use() {
  (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null
}

status_context() {
  printf '  web: port %s\n  sim: port %s\n  log: %s (foreground output stays in its terminal)\n' "$WEB_PORT" "$SIM_PORT" "$LOG_PATH"
}

process_identity() {
  local state
  state="$(ps -p "$1" -o stat= 2>/dev/null)" || return 1
  [[ "$state" != *Z* ]] || return 1
  ps -p "$1" -o lstart= 2>/dev/null
}

# ── Managed operator credential: lets a later TUI or CLI process authenticate
# to a daemon without putting the bearer in argv. Explicit tokens stay
# caller-owned and are never persisted. ──
load_managed_token() {
  local file="$STATE_DIR/control-plane-$PORT.token" mode token
  [ -z "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}" ] || return 0
  [[ -e "$file" || -L "$file" ]] || return 1
  if [[ -L "$file" || ! -f "$file" || ! -O "$file" ]]; then
    error "refusing unsafe managed control-plane credential: $file"
    return 2
  fi
  mode="$(stat -f '%Lp' "$file" 2>/dev/null)" || mode="$(stat -c '%a' "$file" 2>/dev/null)" || mode=""
  if [ "$mode" != "600" ]; then
    error "managed control-plane credential must have mode 600: $file"
    return 2
  fi
  IFS= read -r token < "$file" || true
  if [[ ! "$token" =~ ^[0-9a-fA-F]{64}$ ]]; then
    error "managed control-plane credential is invalid: $file"
    return 2
  fi
  export LEMON_CONTROL_PLANE_OPERATOR_TOKEN="$token"
}

ensure_managed_token() {
  local status=0 file="$STATE_DIR/control-plane-$PORT.token" temporary token old_umask
  load_managed_token || status=$?
  [ "$status" = 1 ] || return "$status"
  old_umask="$(umask)"
  umask 077
  mkdir -p "$STATE_DIR"
  chmod 700 "$LEMON_HOME_DIR" "$STATE_DIR"
  temporary="$(mktemp "$STATE_DIR/.control-plane-$PORT.XXXXXX")"
  token="$(openssl rand -hex 32 2>/dev/null || od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  umask "$old_umask"
  if [[ ! "$token" =~ ^[0-9a-fA-F]{64}$ ]]; then
    rm -f "$temporary"
    error "could not generate a secure managed control-plane credential"
    return 2
  fi
  printf '%s\n' "$token" > "$temporary"
  chmod 600 "$temporary"
  # Linking a fully written file makes concurrent first launches converge on
  # one credential without ever exposing a partial file.
  if ! ln "$temporary" "$file" 2>/dev/null && [ ! -f "$file" ]; then
    rm -f "$temporary"
    error "could not install managed control-plane credential: $file"
    return 2
  fi
  rm -f "$temporary"
  load_managed_token
}

# ── A 200 from /healthz is not proof that Lemon answered it; require the
# documented bodies before reusing whatever holds the port. ──
healthz() { curl --noproxy '*' -fsS --connect-timeout 1 --max-time 1 "http://127.0.0.1:$1/healthz" 2>/dev/null || true; }
control_plane_healthy() {
  local ok='"ok"[[:space:]]*:[[:space:]]*true'
  [[ "$(healthz "$PORT")" =~ $ok ]]
}
web_healthy() { [ "$(healthz "$WEB_PORT" | tr -d '[:space:]')" = "ok" ]; }

prepare_runtime_credential() {
  local status=0
  if ! control_plane_healthy; then
    ensure_managed_token
    return
  fi
  [ -n "${LEMON_WS_TOKEN:-}" ] || load_managed_token || status=$?
  [ "$status" -le 1 ] || return 1
  [ -z "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}${LEMON_WS_TOKEN:-}" ] || return 0
  case "${LEMON_CONTROL_PLANE_ALLOW_UNAUTHENTICATED_LOOPBACK:-}" in
    1|true|TRUE|yes|YES) return 0 ;;
  esac
  error "healthy external runtime on port $PORT has no matching credential; set LEMON_CONTROL_PLANE_OPERATOR_TOKEN or use its managed HOME"
  return 1
}

wait_until() {
  local attempt
  for ((attempt = 0; attempt < $2; attempt++)); do
    "$1" && return 0
    sleep 1
  done
  "$1"
}

# ── Per-user defaults, applied only when unset so server installs that export
# these keep full control. The umask keeps everything under ~/.lemon private
# from its first byte. ──
setup_environment() {
  umask 077
  mkdir -p "$STATE_DIR"
  chmod 700 "$LEMON_HOME_DIR" "$STATE_DIR"
  export LEMON_STORE_PATH="${LEMON_STORE_PATH:-$LEMON_HOME_DIR/store}"

  if [ -z "${RELEASE_COOKIE:-}" ]; then
    [ -s "$LEMON_HOME_DIR/cookie" ] || openssl rand -hex 32 > "$LEMON_HOME_DIR/cookie"
    chmod 600 "$LEMON_HOME_DIR/cookie"
    RELEASE_COOKIE="$(cat "$LEMON_HOME_DIR/cookie")"
    export RELEASE_COOKIE
  fi

  # shellcheck disable=SC1091
  [ ! -f "$LEMON_HOME_DIR/env" ] || source "$LEMON_HOME_DIR/env"

  if [ -z "${LEMON_WEB_SECRET_KEY_BASE:-}" ]; then
    LEMON_WEB_SECRET_KEY_BASE="$(openssl rand -hex 64)"
    printf 'export LEMON_WEB_SECRET_KEY_BASE=%q\n' "$LEMON_WEB_SECRET_KEY_BASE" >> "$LEMON_HOME_DIR/env"
    chmod 600 "$LEMON_HOME_DIR/env"
    export LEMON_WEB_SECRET_KEY_BASE
  fi

  export PHX_SERVER="${PHX_SERVER:-true}"
}

# The sim-only release bundles no lemon_cli; keep its few commands CLI-free.
sim_command() {
  case "${1:-}" in
    --version) exec "$RELEASE_BIN" eval 'IO.puts(LemonCore.Update.Version.describe())' ;;
    version) exec "$RELEASE_BIN" eval 'IO.puts(LemonCore.Update.Version.current())' ;;
    update) shift && exec "$RELEASE_BIN" eval 'LemonCore.Update.CLI.main(System.argv())' "$@" ;;
    doctor)
      if [ "${2:-}" = "--bundle" ] && [ "$#" -le 3 ]; then
        export LEMON_DOCTOR_BUNDLE_PATH="${3:-$LEMON_HOME_DIR/support-bundle-$(date -u +%Y%m%dT%H%M%SZ).zip}"
        mkdir -p "$(dirname "$LEMON_DOCTOR_BUNDLE_PATH")"
        exec "$RELEASE_BIN" eval 'LemonCore.Doctor.CLI.bundle!(bundle_path: System.fetch_env!("LEMON_DOCTOR_BUNDLE_PATH"))'
      fi
      ;;
  esac
  local usage="Usage: lemon <start|daemon|stop|restart|status|remote|eval|rpc|version|update|doctor --bundle [PATH]>
The sim_broadcast_platform release has no runtime CLI; use lemon_runtime_min or lemon_runtime_full."
  case "${1:-}" in
    -h|--help|help) echo "$usage" && exit 0 ;;
    *) echo "$usage" >&2 && exit 2 ;;
  esac
}

run_cli() {
  [ "$PROFILE" != "sim_broadcast_platform" ] || sim_command "$@"
  # Operator follow must exit on Ctrl-C instead of opening the BEAM break menu.
  if [ "${1:-}" = logs ]; then export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} +Bd"; fi
  exec "$RELEASE_BIN" eval "$CLI_EXPR" "$@"
}

# Starts the background runtime unless a healthy one already answers, records
# pid + release root (so stop/restart survive a version flip), and waits for
# the control plane.
start_daemon() {
  local pid="" born attempt snapshot reuse="${1:-1}"
  if [ "$PROFILE" != "sim_broadcast_platform" ] && control_plane_healthy; then
    [ "$reuse" = 1 ] || { error "another runtime is serving port $PORT; restart did not replace it; stop it where it runs, then retry"; return 1; }
    info "a healthy Lemon runtime is already running on port $PORT; reusing it"
    return 0
  fi
  if [ "$PROFILE" != "sim_broadcast_platform" ] && control_port_in_use; then
    error "port $PORT is occupied but does not answer Lemon health checks; free it or set LEMON_CONTROL_PLANE_PORT"
    return 1
  fi
  if [ -e "$PIDFILE" ]; then
    snapshot="$(update_daemon_snapshot)" || return 1
    [ "$snapshot" = stopped ] || { error "managed runtime is alive but unhealthy; inspect $LOG_PATH, then run 'lemon stop' before retrying"; return 1; }
    rm -f "$PIDFILE" "$ROOTFILE"
  fi
  ensure_managed_token || exit 1
  release_command "$LEMON_ROOT" daemon
  for ((attempt = 0; attempt < 15; attempt++)); do
    pid="$(release_command "$LEMON_ROOT" pid 2>/dev/null || true)"
    [ -z "$pid" ] || break
    sleep 1
  done
  if [ -z "$pid" ]; then
    error "daemon started but its pid could not be determined"
    exit 1
  fi
  born="$(process_identity "$pid" || true)"
  printf '%s\n' "$pid" > "$PIDFILE"
  printf '%s\n' "$LEMON_ROOT" > "$ROOTFILE"
  info "started (pid $pid)"
  if [ "$PROFILE" != "sim_broadcast_platform" ] && ! wait_until control_plane_healthy 60; then
    error "runtime did not become healthy on port $PORT within 60s; see $LOG_PATH"
    # This pid came from this launch; bind signals to its observed start time.
    if [ -n "$born" ] && [ "$(process_identity "$pid" || true)" = "$born" ]; then
      kill -TERM "$pid" 2>/dev/null || true
      for ((attempt = 0; attempt < 100; attempt++)); do
        [ "$(process_identity "$pid" || true)" = "$born" ] || break
        sleep 0.1
      done
      [ "$(process_identity "$pid" || true)" != "$born" ] || kill -KILL "$pid"
    fi
    rm -f "$PIDFILE" "$ROOTFILE"
    exit 1
  fi
}

# An eval VM exports its own release selection into child processes. Never let
# those generated paths make an update boot the old release through a new shim.
release_command() (
  local root="$1" variable value
  shift
  for variable in RELEASE_SYS_CONFIG RELEASE_VM_ARGS RELEASE_REMOTE_VM_ARGS RELEASE_TMP; do
    value="${!variable:-}"
    case "$value" in
      "${RELEASE_ROOT:-$LEMON_ROOT}"/*|"$root"/*) unset "$variable" ;;
    esac
  done
  unset RELEASE_ROOT RELEASE_VSN RELEASE_NAME RELEASE_PROG RELEASE_COMMAND RELEASE_MODE
  unset RELEASE_BOOT_SCRIPT RELEASE_BOOT_SCRIPT_CLEAN
  exec "$root/bin/$PROFILE" "$@"
)

daemon_identity() {
  local digest
  digest="$(printf '%s\n' "$1" "$2" "$3" "$PORT" | openssl dgst -sha256)"
  printf '%s\n' "${digest##* }"
}

# Private update protocol: bind the live process to its recorded release and
# control port. Single-line pid records require authenticated RPC confirmation.
update_daemon_snapshot() {
  local pid recorded born actual file
  if [ ! -e "$PIDFILE" ]; then
    if (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
      error "port $PORT answers but is not managed by this HOME ($HOME); stop it where it runs"
      return 1
    fi
    printf 'stopped\n'
    return 0
  fi
  for file in "$PIDFILE" "$ROOTFILE"; do
    if [ ! -f "$file" ] || [ -L "$file" ] || [ ! -O "$file" ]; then
      error "unsafe or missing managed daemon record: $file"
      return 1
    fi
  done
  IFS= read -r pid < "$PIDFILE" || true
  IFS= read -r recorded < "$ROOTFILE" || true
  if [[ ! "$pid" =~ ^[0-9]+$ ]] || [ ! -x "$recorded/bin/$PROFILE" ]; then
    error "invalid managed daemon identity; no process was signalled"
    return 1
  fi
  recorded="$(cd "$recorded" && pwd -P)" || return
  born="$(process_identity "$pid" || true)"
  if [ -z "$born" ]; then
    if (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
      error "stale daemon record with occupied port $PORT; no process was signalled"
      return 1
    fi
    printf 'stopped\n'
    return 0
  fi
  actual="$(release_command "$recorded" rpc 'IO.puts("#{System.pid()}:#{Application.get_env(:lemon_control_plane, :port)}")' 2>/dev/null)" || {
    error "cannot authenticate the recorded daemon; no process was signalled"
    return 1
  }
  if { [ "$PROFILE" != sim_broadcast_platform ] && [ "$actual" != "$pid:$PORT" ]; } ||
     { [ "$PROFILE" = sim_broadcast_platform ] && [ "$actual" != "$pid:" ]; }; then
    error "recorded PID/control port does not match the authenticated daemon; no process was signalled"
    return 1
  fi
  daemon_identity "$pid" "$born" "$recorded"
}

stop_recorded_runtime() {
  local root="$1" token="$2" pid born attempt
  root="$(cd "$root" && pwd -P)" || return
  IFS= read -r pid < "$PIDFILE"
  born="$(process_identity "$pid" || true)"
  if [ "$(daemon_identity "$pid" "$born" "$root")" != "$token" ]; then
    error "daemon changed before stop; no process was signalled"
    return 1
  fi
  release_command "$root" rpc \
    "if System.pid() == \"$pid\", do: System.stop(), else: raise(\"daemon changed before stop\")" || return
  for ((attempt = 0; attempt < 100; attempt++)); do
    [ "$(process_identity "$pid" || true)" = "$born" ] || break
    sleep 0.1
  done
  if [ "$(process_identity "$pid" || true)" = "$born" ]; then
    error "daemon has not exited after stop; refusing to start another runtime"
    return 1
  fi
  rm -f "$PIDFILE" "$ROOTFILE"
}

restart_updated_daemon() {
  local token="$1" previous="$2" current recorded
  previous="$(cd "$previous" && pwd -P)" || return
  current="$(update_daemon_snapshot)" || return
  IFS= read -r recorded < "$ROOTFILE" || true
  recorded="$(cd "$recorded" && pwd -P)" || return
  if [ "$current" = stopped ] || [ "$current" != "$token" ] || [ "$recorded" != "$previous" ]; then
    error "daemon changed during update; no process was signalled"
    return 1
  fi
  stop_recorded_runtime "$previous" "$token" || return
  RELEASE_BIN="$LEMON_ROOT/bin/$PROFILE"
  start_daemon 0 || return
  IFS= read -r recorded < "$ROOTFILE" || true
  if [ "$recorded" != "$LEMON_ROOT" ]; then
    error "another runtime won the restart; selected release was not started"
    return 1
  fi
  info "restarted selected release at $LEMON_ROOT"
}

open_browser() {
  local url="$1" opener
  # Sign in with the operator token in the URL fragment: browsers never send
  # fragments to the server, so it stays out of request logs, history after
  # the login page removes it, and Referer headers.
  if [ -n "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}" ]; then
    if [[ "$LEMON_CONTROL_PLANE_OPERATOR_TOKEN" =~ ^[A-Za-z0-9._~-]+$ ]]; then
      url="${url}login#token=$LEMON_CONTROL_PLANE_OPERATOR_TOKEN"
    else
      warn "The operator token contains URL-reserved characters; sign in by pasting it on the login page."
    fi
  fi
  for opener in open xdg-open wslview; do
    if command -v "$opener" >/dev/null 2>&1; then
      "$opener" "$url" >/dev/null 2>&1 &
      return 0
    fi
  done
  warn "No browser opener found; open the URL above manually."
}

COMMAND="${1:-}"
if [ -z "$COMMAND" ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
  error "No interactive terminal. Use 'lemon -p \"PROMPT\"' for CI, 'lemon daemon' to start a service, or 'lemon --help'."
  exit 2
fi
if [ -z "$COMMAND" ]; then
  COMMAND="tui"
  set -- tui
fi
# Session-resume flags open the TUI: `lemon -c`, `lemon --continue`, `lemon -r [key]`.
case "$COMMAND" in
  -c|--continue|-r|--resume)
    COMMAND="tui"
    set -- tui "$@"
    ;;
esac

case "$COMMAND" in
  --version|version)
    # Build identity must work before setup, even when runtime configuration
    # requires secrets or endpoint settings that do not exist yet.
    export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -elixir config_provider_init nil"
    run_cli "$@"
    ;;
  __update-daemon)
    if [ -z "${RELEASE_COOKIE:-}" ] && [ -f "$LEMON_HOME_DIR/cookie" ]; then
      IFS= read -r RELEASE_COOKIE < "$LEMON_HOME_DIR/cookie"
      export RELEASE_COOKIE
    fi
    case "${2:-}:$#" in
      snapshot:2) update_daemon_snapshot ;;
      restart:4) restart_updated_daemon "$3" "$4" ;;
      *) error "invalid internal update lifecycle request"; exit 2 ;;
    esac
    exit $?
    ;;
  ""|-h|--help|help) run_cli "$@" ;;
  tui|web|start|daemon|stop|restart|status|remote|eval|rpc)
    case "${2:-}" in -h|--help) run_cli help "$COMMAND" ;; esac
    ;;
esac
case "$COMMAND" in
  tui|web|start|daemon|stop|restart|status|__update-daemon|acp|run|-p|--print) require_curl ;;
esac

setup_environment

case "$COMMAND" in
  acp)
    shift
    case "${1:-}" in -h|--help) run_cli acp --help ;; esac
    prepare_runtime_credential || exit 1
    if ! control_plane_healthy; then start_daemon >&2; fi
    run_cli acp "$@"
    ;;
  tui)
    shift
    if [ "$PROFILE" = "sim_broadcast_platform" ] || [ ! -x "$TUI_BIN" ]; then
      error "TUI not installed at $TUI_BIN (sim-only release, or installed with LEMON_NO_TUI=1)"
      exit 1
    fi
    status=0
    [ -n "${LEMON_WS_TOKEN:-}" ] || load_managed_token || status=$?
    [ "$status" -le 1 ] || exit 1
    if ! control_plane_healthy; then
      # First launch only: finish setup in one VM before starting a daemon.
      if [ -t 0 ] && [ -t 1 ]; then
        "$RELEASE_BIN" eval "$CLI_EXPR" setup --if-required || exit 1
      fi
      start_daemon
    fi
    if [ -z "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}${LEMON_WS_TOKEN:-}" ]; then
      case "${LEMON_CONTROL_PLANE_ALLOW_UNAUTHENTICATED_LOOPBACK:-}" in
        1|true|TRUE|yes|YES) ;;
        *)
          error "no credential is available for the existing runtime"
          error "start managed runtimes with 'lemon daemon', or set LEMON_CONTROL_PLANE_OPERATOR_TOKEN"
          exit 1
          ;;
      esac
    fi
    exec "$TUI_BIN" --ws-url "ws://127.0.0.1:$PORT/ws" "$@"
    ;;

  web)
    case "$#:${2:-}" in
      1:|2:--no-open) ;;
      *) error "usage: lemon web [--no-open]"; exit 2 ;;
    esac
    if [ "$PROFILE" != "lemon_runtime_full" ]; then
      error "the Web UI is available only in the lemon_runtime_full profile; reinstall with LEMON_PROFILE=full"
      exit 1
    fi
    status=0
    load_managed_token || status=$?
    [ "$status" -le 1 ] || exit 1
    if ! web_healthy; then
      info "Web UI is not running; starting Lemon"
      start_daemon
      wait_until web_healthy 30 || { error "Web UI did not become healthy on port $WEB_PORT within 30s"; exit 1; }
    fi
    info "Lemon Web: http://127.0.0.1:$WEB_PORT/"
    [ "${2:-}" = "--no-open" ] || open_browser "http://127.0.0.1:$WEB_PORT/"
    ;;

  start)
    shift
    # Reuse guard before the release registers its Erlang node name.
    if [ "$PROFILE" != "sim_broadcast_platform" ] && control_plane_healthy; then
      info "a healthy Lemon runtime is already running on port $PORT; reusing it"
      exit 0
    fi
    if [ "$PROFILE" != "sim_broadcast_platform" ] && control_port_in_use; then
      error "port $PORT is occupied but does not answer Lemon health checks; free it or set LEMON_CONTROL_PLANE_PORT"
      exit 1
    fi
    if [ -e "$PIDFILE" ] || [ -L "$PIDFILE" ]; then
      snapshot="$(update_daemon_snapshot)" || exit 1
      [ "$snapshot" = stopped ] || { error "managed runtime is alive but unhealthy; inspect $LOG_PATH, then run 'lemon stop' before retrying"; exit 1; }
    fi
    rm -f "$PIDFILE" "$ROOTFILE"
    ensure_managed_token || exit 1
    printf '%s\n' "$$" > "$PIDFILE"
    printf '%s\n' "$LEMON_ROOT" > "$ROOTFILE"
    exec "$RELEASE_BIN" start "$@"
    ;;

  daemon) start_daemon ;;

  stop)
    snapshot="$(update_daemon_snapshot)" || exit 1
    [ "$snapshot" != stopped ] || { error "not running; no process was signalled"; exit 1; }
    IFS= read -r recorded < "$ROOTFILE"
    stop_recorded_runtime "$recorded" "$snapshot"
    info "stopped"
    ;;

  restart)
    snapshot="$(update_daemon_snapshot)" || exit 1
    if [ "$snapshot" = stopped ]; then
      start_daemon 0
    else
      IFS= read -r recorded < "$ROOTFILE"
      restart_updated_daemon "$snapshot" "$recorded"
    fi
    ;;

  status)
    pid=""
    if [ -f "$PIDFILE" ] && [ ! -L "$PIDFILE" ] && [ -O "$PIDFILE" ]; then
      IFS= read -r pid < "$PIDFILE" || true
    fi
    if control_plane_healthy; then
      if [[ "$pid" =~ ^[0-9]+$ ]] && process_identity "$pid" >/dev/null; then
        echo "lemon: running (pid $pid), control-plane healthy on port $PORT; home: $LEMON_HOME_DIR"
      else
        echo "lemon: running, healthy on port $PORT (not managed by this HOME); home: $LEMON_HOME_DIR (launcher)"
      fi
      status_context
    else
      if [[ "$pid" =~ ^[0-9]+$ ]] && process_identity "$pid" >/dev/null; then
        echo "lemon: running (pid $pid), control-plane not reachable on port $PORT; home: $LEMON_HOME_DIR"
      else
        echo "lemon: no Lemon runtime answers on port $PORT; home: $LEMON_HOME_DIR"
      fi
      status_context
      exit 1
    fi
    ;;

  remote|eval|rpc) exec "$RELEASE_BIN" "$@" ;;

  *)
    case "$COMMAND" in
      run|-p|--print) prepare_runtime_credential || exit 1 ;;
      *) ensure_managed_token || exit 1 ;;
    esac
    run_cli "$@"
    ;;
esac
