#!/bin/sh
# Release environment hook (copied to releases/<vsn>/env.sh by `mix release`).
#
# Every generated release command sources this file before starting the VM,
# including `bin/<release> start` invoked directly (the container CMD) and the
# `bin/lemon` wrapper. It is the single place where packaged releases get their
# distribution exposure defaults.
#
# Erlang distribution and epmd listen on every interface unless told otherwise.
# epmd is scoped to loopback by default; a cross-host deployment opts in by
# exporting ERL_EPMD_ADDRESS explicitly. The distribution listen interface is
# pinned to loopback only when the operator has not asked for long-name
# distribution, which is the mode used to cluster across hosts.
#
# A bare short name resolves its host from `hostname`, which may map to a LAN,
# tailnet or VPN address where nothing listens once distribution is on
# loopback; `pid`, `rpc`, `remote` and `stop` would then fail with
# :noconnection. Short-name nodes therefore default to the `localhost` host.
ERL_EPMD_ADDRESS="${ERL_EPMD_ADDRESS:-127.0.0.1}"
export ERL_EPMD_ADDRESS

if [ "${RELEASE_DISTRIBUTION:-}" != "name" ]; then
  case "${RELEASE_NODE:-}" in
    *@*) ;;
    *)
      RELEASE_NODE="${RELEASE_NODE:-$RELEASE_NAME}@localhost"
      export RELEASE_NODE
      ;;
  esac
  case "${ELIXIR_ERL_OPTIONS:-}" in
    *inet_dist_use_interface*) ;;
    *)
      ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-}${ELIXIR_ERL_OPTIONS:+ }-kernel inet_dist_use_interface {127,0,0,1}"
      export ELIXIR_ERL_OPTIONS
      ;;
  esac
fi
