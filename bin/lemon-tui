#!/bin/bash
#
# lemon-tui - Launch Lemon TUI against a shared runtime.
#
# If a control-plane runtime is already up, this attaches over WebSocket.
# If not, it boots ./bin/lemon with a process-scoped operator token, waits for
# readiness, then stops that owned runtime when the TUI exits.
#
# Usage:
#   ./bin/lemon-tui [all TUI args]
#

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done

SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LEMON_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export LEMON_PATH="$LEMON_ROOT"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

info() {
  echo -e "${GREEN}[lemon-tui]${NC} $1"
}

warn() {
  echo -e "${YELLOW}[lemon-tui]${NC} $1"
}

error() {
  echo -e "${RED}[lemon-tui]${NC} $1" >&2
}

PORT="${LEMON_CONTROL_PLANE_PORT:-4040}"
if ! [[ "$PORT" =~ ^[0-9]+$ ]]; then
  error "Invalid LEMON_CONTROL_PLANE_PORT value: $PORT"
  exit 1
fi
RUNTIME_LAUNCHER="${LEMON_TUI_RUNTIME_LAUNCHER:-$LEMON_ROOT/bin/lemon}"
RUNTIME_PID_FILE=""
STARTED_RUNTIME=0
MANAGED_TOKEN_FILE="$HOME/.lemon/run/control-plane-${PORT}.token"

private_file_mode() {
  local path="$1"
  local mode=""

  if mode="$(stat -f '%Lp' "$path" 2>/dev/null)"; then
    printf '%s\n' "$mode"
  elif mode="$(stat -c '%a' "$path" 2>/dev/null)"; then
    printf '%s\n' "$mode"
  else
    return 1
  fi
}

load_managed_operator_token() {
  local mode
  local token

  if [[ -n "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}" || -n "${LEMON_WS_TOKEN:-}" ]]; then
    return 0
  fi

  if [[ ! -e "$MANAGED_TOKEN_FILE" && ! -L "$MANAGED_TOKEN_FILE" ]]; then
    return 1
  fi

  if [[ -L "$MANAGED_TOKEN_FILE" || ! -f "$MANAGED_TOKEN_FILE" || ! -O "$MANAGED_TOKEN_FILE" ]]; then
    error "Refusing unsafe managed control-plane credential: $MANAGED_TOKEN_FILE"
    return 2
  fi

  mode="$(private_file_mode "$MANAGED_TOKEN_FILE")" || {
    error "Could not verify permissions on managed control-plane credential: $MANAGED_TOKEN_FILE"
    return 2
  }

  if [[ "$mode" != "600" ]]; then
    error "Managed control-plane credential must have mode 600: $MANAGED_TOKEN_FILE"
    return 2
  fi

  IFS= read -r token < "$MANAGED_TOKEN_FILE" || true

  if [[ ! "$token" =~ ^[0-9a-fA-F]{64}$ ]]; then
    error "Managed control-plane credential is invalid: $MANAGED_TOKEN_FILE"
    return 2
  fi

  export LEMON_CONTROL_PLANE_OPERATOR_TOKEN="$token"
}

cleanup() {
  if [[ "$STARTED_RUNTIME" == "1" && -n "$RUNTIME_PID_FILE" && -f "$RUNTIME_PID_FILE" ]]; then
    runtime_pid="$(<"$RUNTIME_PID_FILE")"

    if [[ "$runtime_pid" =~ ^[0-9]+$ && "$runtime_pid" -gt 1 ]] && kill -0 "$runtime_pid" 2>/dev/null; then
      info "Stopping launcher-owned runtime (pid: $runtime_pid)"
      kill -TERM "$runtime_pid" 2>/dev/null || true

      for _ in $(seq 1 50); do
        kill -0 "$runtime_pid" 2>/dev/null || break
        sleep 0.1
      done

      if kill -0 "$runtime_pid" 2>/dev/null; then
        kill -KILL "$runtime_pid" 2>/dev/null || true
      fi
    fi
  fi

  if [[ -n "$RUNTIME_PID_FILE" ]]; then
    rm -f "$RUNTIME_PID_FILE"
  fi

  return 0
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if ! command -v bun >/dev/null 2>&1; then
  error "Bun is required to run the TUI. Install Bun and ensure 'bun' is on PATH."
  exit 1
fi

TUI_DIR="$LEMON_ROOT/clients/tui"
if [[ ! -d "$TUI_DIR" ]]; then
  error "TUI directory not found: $TUI_DIR"
  exit 1
fi

cd "$TUI_DIR"

if [[ ! -d "node_modules" ]]; then
  info "Installing TUI dependencies..."
  env -u LEMON_CONTROL_PLANE_OPERATOR_TOKEN -u LEMON_WS_TOKEN bun install --frozen-lockfile
fi

runtime_healthy() {
  curl -sS -m 2 "http://127.0.0.1:${PORT}/healthz" >/dev/null 2>&1
}

managed_token_status=0
load_managed_operator_token || managed_token_status=$?
if [[ "$managed_token_status" != "0" && "$managed_token_status" != "1" ]]; then
  exit 1
fi


if ! runtime_healthy; then
  if [[ -z "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}" ]]; then
    if command -v openssl >/dev/null 2>&1; then
      LEMON_CONTROL_PLANE_OPERATOR_TOKEN="$(openssl rand -hex 32)"
    else
      LEMON_CONTROL_PLANE_OPERATOR_TOKEN="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    fi

    if [[ ! "$LEMON_CONTROL_PLANE_OPERATOR_TOKEN" =~ ^[0-9a-fA-F]{64}$ ]]; then
      error "Could not generate a secure process-scoped operator token."
      exit 1
    fi

    export LEMON_CONTROL_PLANE_OPERATOR_TOKEN
  fi

  # Process ownership follows who started the runtime, not who supplied its
  # credential. Every daemon started here must be reaped when this TUI exits.
  STARTED_RUNTIME=1
  RUNTIME_PID_FILE="$(mktemp "${TMPDIR:-/tmp}/lemon-tui-runtime.XXXXXX")"
  chmod 600 "$RUNTIME_PID_FILE"
  export LEMON_RUNTIME_PID_FILE="$RUNTIME_PID_FILE"

  warn "No control-plane runtime detected on :${PORT}; starting ./bin/lemon --daemon"
  "$RUNTIME_LAUNCHER" --daemon --port "$PORT"

  ready=0
  for _ in $(seq 1 40); do
    if runtime_healthy; then
      ready=1
      break
    fi
    sleep 0.5
  done

  if [[ "$ready" != "1" ]]; then
    error "Runtime did not become healthy on :${PORT}"
    error "Check logs: /tmp/lemon-runtime.log"
    exit 1
  fi

  info "Runtime is healthy."
else
  if [[ -z "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}" && -z "${LEMON_WS_TOKEN:-}" ]]; then
    case "${LEMON_CONTROL_PLANE_ALLOW_UNAUTHENTICATED_LOOPBACK:-}" in
      1|true|TRUE|yes|YES) ;;
      *)
        error "No credential is available for the existing runtime."
        error "Start managed daemons with ./bin/lemon --daemon, or set LEMON_CONTROL_PLANE_OPERATOR_TOKEN."
        exit 1
        ;;
    esac
  fi

  info "Using existing runtime on :${PORT}"
fi

info "Launching TUI (ws: ws://127.0.0.1:${PORT}/ws)"
bun src/main.ts --ws-url "ws://127.0.0.1:$PORT/ws" "$@"
