#!/usr/bin/env bash
#
# lemon-gateway - start Lemon's runtime from source under the gateway node name.
#
# Usage:
#   ./bin/lemon-gateway [--debug] [--port N] [--web-port N]
#                       [--name <name@host> | --sname <name>] [--no-distribution]
#
# This is `./bin/lemon start` with the distributed node name defaulting to
# lemon_gateway (LEMON_GATEWAY_NODE_NAME). The gateway, router and channel
# adapters run only inside that one runtime, so this shares its health probe,
# start lock, compile and node registration sequence: a healthy runtime on the
# control port is reused, never joined by a second router or adapter set, and
# dependencies are never fetched. See `./bin/lemon start --help`.
#
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

export LEMON_GATEWAY_NODE_NAME="${LEMON_GATEWAY_NODE_NAME:-lemon_gateway}"
exec "$SCRIPT_DIR/lemon" start "$@"
