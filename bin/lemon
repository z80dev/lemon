#!/usr/bin/env bash
#
# lemon - launcher for a Lemon source checkout.
#
# The shell owns only what cannot run inside the Mix project: locating the
# checkout, the managed control-plane credential, secrets master-key
# normalization, runtime lifecycle and health waits, and exec'ing the TUI.
# Every other command is dispatched by LemonCli.CLI from
# LemonCli.CommandRegistry -- the same registry the packaged `lemon` uses.
# Run `./bin/lemon --help` for the command list.
#
#   ./bin/lemon                    # interactive terminal: TUI (starts the runtime if needed)
#   ./bin/lemon -c | -r [key]      # TUI: continue the latest session / resume a session
#   ./bin/lemon start [opts]       # foreground runtime (see `./bin/lemon start --help`)
#   ./bin/lemon daemon|stop|restart|status
#   ./bin/lemon <command> [args]   # setup, doctor, sessions, send, node, ... via LemonCli.CLI

set -euo pipefail

info() { printf '\033[0;32m[lemon]\033[0m %s\n' "$1"; }
warn() { printf '\033[0;33m[lemon]\033[0m %s\n' "$1"; }
error() { printf '\033[0;31m[lemon]\033[0m %s\n' "$1" >&2; }

LAUNCH_CWD="$(pwd)"
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
LEMON_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TUI_DIR="$LEMON_ROOT/clients/tui"
LEMON_HOME_DIR="$HOME/.lemon"
STATE_DIR="$LEMON_HOME_DIR/run"
export LEMON_PATH="$LEMON_ROOT"
export LEMON_CLI_LAUNCHER=source LEMON_LAUNCHER="$SCRIPT_DIR/lemon" LEMON_NODE_LAUNCH_CWD="$LAUNCH_CWD"

# Ports chosen by `lemon setup` (~/.lemon/ports.env) fill in unset port
# variables; an explicit environment value wins.
load_port_settings() {
  local key value
  [ -f "$1" ] || return 0
  while IFS='=' read -r key value || [ -n "$key" ]; do
    case "$key" in
      LEMON_CONTROL_PLANE_PORT | LEMON_WEB_PORT | LEMON_SIM_UI_PORT)
        if [[ "$value" =~ ^[0-9]{1,5}$ && -z "${!key:-}" ]]; then
          export "$key=$value"
        fi
        ;;
    esac
  done <"$1"
}
load_port_settings "$LEMON_HOME_DIR/ports.env"

PORT="${LEMON_CONTROL_PLANE_PORT:-4040}"
WEB_PORT="${LEMON_WEB_PORT:-4080}"
SIM_PORT="${LEMON_SIM_UI_PORT:-4090}"
export LEMON_CONTROL_PLANE_PORT="$PORT" LEMON_WEB_PORT="$WEB_PORT" LEMON_SIM_UI_PORT="$SIM_PORT"
NODE_MODE=""
NODE_NAME="${LEMON_GATEWAY_NODE_NAME:-lemon}"
NODE_COOKIE="${LEMON_GATEWAY_NODE_COOKIE:-${LEMON_GATEWAY_COOKIE:-lemon_gateway_dev_cookie}}"
DISTRIBUTED=1
DEBUG=""

# Match Path.expand before deciding whether a store path names a database file.
# Keep symlink resolution separate: a file alias must retain its own extension.
lexical_path() {
  local path="$1" resolved="" component
  [ -n "$path" ] || return 1
  case "$path" in
    \~) path="$HOME" ;;
    \~/*) path="$HOME/${path#\~/}" ;;
  esac
  [[ "$path" = /* ]] || path="$PWD/$path"
  while [ -n "$path" ]; do
    path="${path#/}"
    component="${path%%/*}"
    if [ "$path" = "$component" ]; then path=""; else path="${path#*/}"; fi
    case "$component" in
      ""|.) ;;
      ..) resolved="${resolved%/*}" ;;
      *) resolved="$resolved/$component" ;;
    esac
  done
  printf '%s\n' "${resolved:-/}"
}

# Resolve existing symlinks while also normalizing missing path components.
# Walking components keeps a missing-directory/../alias path comparable to an
# existing alias without requiring realpath or booting Elixir.
canonical_path() {
  local path="$1" resolved=/ component link links=0
  [ -n "$path" ] || return 1
  case "$path" in
    \~) path="$HOME" ;;
    \~/*) path="$HOME/${path#\~/}" ;;
  esac
  [[ "$path" = /* ]] || path="$PWD/$path"
  while [ -n "$path" ]; do
    path="${path#/}"
    component="${path%%/*}"
    if [ "$path" = "$component" ]; then path=""; else path="${path#*/}"; fi
    case "$component" in
      ""|.) ;;
      ..)
        resolved="${resolved%/*}"
        [ -n "$resolved" ] || resolved=/
        ;;
      *)
        if [ "$resolved" = / ]; then
          resolved="/$component"
        else
          resolved="$resolved/$component"
        fi
        if [ -L "$resolved" ]; then
          link="$(readlink "$resolved")" || return 1
          links=$((links + 1))
          [ "$links" -le 40 ] || return 1
          resolved="${resolved%/*}"
          [ -n "$resolved" ] || resolved=/
          [[ "$link" != /* ]] || resolved=/
          if [ -n "$path" ]; then path="$link/$path"; else path="$link"; fi
        fi
        ;;
    esac
  done
  printf '%s\n' "$resolved"
}

paths_overlap() {
  [ "$1" = / ] || [ "$2" = / ] || {
    case "$1/" in "$2"/*) return 0 ;; esac
    case "$2/" in "$1"/*) return 0 ;; esac
    return 1
  }
}

# Lifecycle state is per control-plane port, including when --port is supplied.
runtime_paths() {
  PIDFILE="${LEMON_RUNTIME_PID_FILE:-$STATE_DIR/lemon-$PORT.pid}"
  [[ "$PIDFILE" = /* ]] || PIDFILE="$LAUNCH_CWD/$PIDFILE"
  LOG_FILE="${LEMON_RUNTIME_LOG_FILE:-$STATE_DIR/lemon-$PORT.log}"
  LOCK_DIR="$STATE_DIR/lemon-$PORT.lock"
}
runtime_paths

validate_runtime_ports() {
  local port
  for port in "$PORT" "$WEB_PORT" "$SIM_PORT"; do
    if [[ ! "$port" =~ ^[0-9]{1,5}$ ]] || ((10#$port < 1 || 10#$port > 65535)); then
      error "invalid port value: $port (expected 1-65535)"
      exit 2
    fi
  done
}

require_curl() {
  command -v curl >/dev/null 2>&1 || {
    error "curl is required for health checks; install it and retry"
    exit 1
  }
}

require_elixir() {
  if ! command -v elixir >/dev/null 2>&1 || ! command -v mix >/dev/null 2>&1; then
    error "Elixir and Mix are required for a source checkout (Elixir 1.19.5+, Erlang/OTP 28.5+); see docs/install.md, Source development"
    exit 1
  fi
}

# Read only the registry, without Mix, application boot, or credential creation.
run_help() {
  require_elixir
  exec elixir -r "$LEMON_ROOT/apps/lemon_cli/lib/lemon_cli/command_registry.ex" \
    -e '
      alias LemonCli.CommandRegistry, as: Registry
      case System.argv() do
        [] -> IO.write(Registry.help())
        [name | _] ->
          case Registry.fetch(name) do
            {:ok, entry} ->
              if Registry.available?(entry, :source) do
                IO.write(Registry.help(name))
              else
                IO.puts(:stderr, "Command #{name} is available only in a packaged release.")
                System.halt(2)
              end
            :error ->
              IO.puts(:stderr, "Unknown command: #{name}. Run lemon --help to list commands.")
              System.halt(2)
          end
      end' -- "$@"
}

process_identity() {
  local state
  state="$(ps -p "$1" -o stat= 2>/dev/null)" || return 1
  [[ "$state" != *Z* ]] || return 1
  ps -p "$1" -o lstart= 2>/dev/null
}

owned_runtime_pid() {
  local file="${1:-$PIDFILE}" pid born=""
  [ -f "$file" ] && [ ! -L "$file" ] && [ -O "$file" ] || return 1
  { IFS= read -r pid; IFS= read -r born || true; } < "$file" || return 1
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  if [ -n "$born" ]; then
    [ "$(process_identity "$pid")" = "$born" ] || return 1
  else
    # Packaged/legacy PID-only records block startup, but cannot authorize
    # source-launcher signals: stop callers never opt into probe mode.
    [ "${2:-}" = probe ] || return 1
    process_identity "$pid" >/dev/null || return 1
  fi
  printf '%s' "$pid"
}

# A later invocation may no longer have the original PIDFILE override. Keep
# the published PID record authoritative without overlooking a live process
# recorded under either the requested override or the legacy default.
managed_runtime_pidfile() {
  local registered="" fourth="" _ file paths="$STATE_DIR/lemon-$PORT.paths"
  if [ -f "$paths" ] && [ ! -L "$paths" ] && [ -O "$paths" ]; then
    {
      IFS= read -r _
      IFS= read -r _
      IFS= read -r registered
      IFS= read -r fourth || true
      [ -z "$fourth" ] || registered="$fourth"
    } < "$paths" || true
  fi
  [[ "$registered" = /* ]] || registered=""
  for file in "$registered" "$PIDFILE" "$STATE_DIR/lemon-$PORT.pid"; do
    [ -n "$file" ] || continue
    if owned_runtime_pid "$file" probe >/dev/null; then
      printf '%s\n' "$file"
      return 0
    fi
  done
  return 1
}

record_runtime_pid() {
  local temporary
  temporary="$(mktemp "$STATE_DIR/.pid.XXXXXX")"
  printf '%s\n%s\n' "$1" "$(process_identity "$1")" > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$PIDFILE"
}

release_start_lock() {
  [ "${HAVE_START_LOCK:-0}" = 1 ] || return 0
  rm -f "$LOCK_DIR/owner"
  rmdir "$LOCK_DIR" 2>/dev/null || true
  HAVE_START_LOCK=0
}

acquire_start_lock() {
  local owner attempt
  umask 077
  mkdir -p "$STATE_DIR"
  for ((attempt = 0; attempt < 120; attempt++)); do
    if mkdir "$LOCK_DIR" 2>/dev/null; then
      printf '%s\n' "$$" > "$LOCK_DIR/owner"
      HAVE_START_LOCK=1
      trap release_start_lock EXIT
      trap 'exit 130' INT
      trap 'exit 143' TERM
      return 0
    fi
    owner="$(cat "$LOCK_DIR/owner" 2>/dev/null || true)"
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null &&
       mkdir "$LOCK_DIR/reaping" 2>/dev/null; then
      # Only one reaper may unlink the dead owner's record. rmdir, not rm -rf,
      # prevents an old waiter from deleting a newly acquired lock.
      rm -f "$LOCK_DIR/owner"
      rmdir "$LOCK_DIR/reaping" "$LOCK_DIR" 2>/dev/null || true
      continue
    fi
    sleep 0.25
  done
  error "startup is locked at $LOCK_DIR; check its owner before removing an abandoned lock"
  return 1
}

# A restore publishes its completed owner/target lock before its final runtime
# check. Publish startup ownership before checking that lock, so either side
# sees the other. Only temporary run metadata may change until this check.
runtime_state_paths() {
  local store="${LEMON_STORE_PATH:-$LEMON_HOME_DIR/store}" trailing="" lower primary
  case "$store" in
    /*|\~|\~/*) ;;
    *) store="$LEMON_ROOT/$store" ;;
  esac
  [[ "$store" != */ ]] || trailing=/
  store="$(lexical_path "$store")" || return 1
  primary="$store/store.sqlite3"
  lower="$(printf '%s' "$store" | tr '[:upper:]' '[:lower:]')"
  if [ "$trailing" != / ] && [ ! -d "$store" ]; then
    case "${lower##*/}" in
      .db|.sqlite|.sqlite3) ;;
      *.db|*.sqlite|*.sqlite3)
        primary="$store"
        store="${store%/*}"
        [ -n "$store" ] || store=/
        ;;
    esac
  fi
  canonical_path "$LEMON_HOME_DIR" || return 1
  canonical_path "$store" || return 1
  canonical_path "$primary"
}

record_runtime_paths() {
  local temporary paths pidfile
  paths="$(runtime_state_paths)" || return 1
  pidfile="$PIDFILE"
  [[ "$pidfile" = /* ]] || pidfile="$PWD/$pidfile"
  temporary="$(mktemp "$STATE_DIR/.paths.XXXXXX")"
  printf '%s\n%s\n' "$paths" "$pidfile" > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$STATE_DIR/lemon-$PORT.paths"
}

restore_in_progress() {
  local lock owner target canonical_target mine paths
  local mine_paths=()
  paths="$(runtime_state_paths)" || {
    error "cannot resolve state paths for backup restore coordination; fix the paths, then retry"
    return 0
  }
  while IFS= read -r mine; do
    mine_paths+=("$mine")
  done <<< "$paths"
  for lock in "$STATE_DIR"/restore-*.lock; do
    [ -d "$lock" ] || continue
    owner=""
    target=""
    { IFS= read -r owner < "$lock/owner"; } 2>/dev/null || true
    if ! [[ "$owner" =~ ^[1-9][0-9]*$ ]] || ! kill -0 "$owner" 2>/dev/null; then continue; fi
    { IFS= read -r target < "$lock/target"; } 2>/dev/null || true
    canonical_target=""
    if [[ "$target" = /* ]]; then
      canonical_target="$(canonical_path "$target" 2>/dev/null || true)"
    fi
    for mine in "${mine_paths[@]}"; do
      if [ -z "$canonical_target" ] || paths_overlap "$canonical_target" "$mine"; then
        error "a backup restore (pid $owner) is replacing ${target:-Lemon state}; wait for it to finish, then retry"
        return 0
      fi
    done
  done
  return 1
}

control_port_in_use() {
  # Bash TCP redirection avoids a dependency on platform-specific nc flags.
  (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null
}

compile_source() {
  [ "${SOURCE_COMPILED:-0}" = 1 ] && return 0
  require_elixir
  (cd "$LEMON_ROOT" && mix compile) || return
  SOURCE_COMPILED=1
}
# ── Managed operator credential: lets a later TUI or CLI process authenticate
# to a daemon without putting the bearer in argv. Explicit tokens stay
# caller-owned and are never persisted. ──
load_managed_token() {
  local file="$STATE_DIR/control-plane-$PORT.token" mode token
  [ -z "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}" ] || return 0
  [[ -e "$file" || -L "$file" ]] || return 1
  if [[ -L "$file" || ! -f "$file" || ! -O "$file" ]]; then
    error "refusing unsafe managed control-plane credential: $file"
    return 2
  fi
  mode="$(stat -f '%Lp' "$file" 2>/dev/null)" || mode="$(stat -c '%a' "$file" 2>/dev/null)" || mode=""
  if [ "$mode" != "600" ]; then
    error "managed control-plane credential must have mode 600: $file"
    return 2
  fi
  IFS= read -r token < "$file" || true
  if [[ ! "$token" =~ ^[0-9a-fA-F]{64}$ ]]; then
    error "managed control-plane credential is invalid: $file"
    return 2
  fi
  export LEMON_CONTROL_PLANE_OPERATOR_TOKEN="$token"
}

ensure_managed_token() {
  local status=0 file="$STATE_DIR/control-plane-$PORT.token" temporary token old_umask
  load_managed_token || status=$?
  [ "$status" = 1 ] || return "$status"
  old_umask="$(umask)"
  umask 077
  mkdir -p "$STATE_DIR"
  chmod 700 "$LEMON_HOME_DIR" "$STATE_DIR"
  temporary="$(mktemp "$STATE_DIR/.control-plane-$PORT.XXXXXX")"
  token="$(openssl rand -hex 32 2>/dev/null || od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  umask "$old_umask"
  if [[ ! "$token" =~ ^[0-9a-fA-F]{64}$ ]]; then
    rm -f "$temporary"
    error "could not generate a secure managed control-plane credential"
    return 2
  fi
  printf '%s\n' "$token" > "$temporary"
  chmod 600 "$temporary"
  # Linking a fully written file makes concurrent first launches converge on
  # one credential without ever exposing a partial file.
  if ! ln "$temporary" "$file" 2>/dev/null && [ ! -f "$file" ]; then
    rm -f "$temporary"
    error "could not install managed control-plane credential: $file"
    return 2
  fi
  rm -f "$temporary"
  load_managed_token
}

# ── A 200 from /healthz is not proof that Lemon answered it; require the
# documented bodies before reusing whatever holds the port. ──
healthz() { curl --noproxy '*' -fsS --connect-timeout 1 --max-time 1 "http://127.0.0.1:$1/healthz" 2>/dev/null || true; }
control_plane_healthy() {
  local ok='"ok"[[:space:]]*:[[:space:]]*true'
  [[ "$(healthz "$PORT")" =~ $ok ]]
}
web_healthy() { [ "$(healthz "$WEB_PORT" | tr -d '[:space:]')" = "ok" ]; }

prepare_runtime_credential() {
  local status=0
  if ! control_plane_healthy; then
    ensure_managed_token
    return
  fi
  [ -n "${LEMON_WS_TOKEN:-}" ] || load_managed_token || status=$?
  [ "$status" -le 1 ] || return 1
  [ -z "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}${LEMON_WS_TOKEN:-}" ] || return 0
  case "${LEMON_CONTROL_PLANE_ALLOW_UNAUTHENTICATED_LOOPBACK:-}" in
    1|true|TRUE|yes|YES) return 0 ;;
  esac
  error "healthy external runtime on port $PORT has no matching credential; set LEMON_CONTROL_PLANE_OPERATOR_TOKEN or use its managed HOME"
  return 1
}

wait_until() {
  local attempt
  for ((attempt = 0; attempt < $2; attempt++)); do
    "$1" && return 0
    sleep 1
  done
  "$1"
}

# Compile first, then isolate Mix bootstrap diagnostics from the CLI's stdio.
run_cli() {
  cd "$LEMON_ROOT"
  # Dependencies are installed explicitly; launching must never mutate them.
  MIX_QUIET=1 compile_source >&2
  # Operator follow must exit on Ctrl-C instead of opening the BEAM break menu.
  if [ "${1:-}" = logs ]; then export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} +Bd"; fi
  exec env MIX_QUIET=1 elixir "$LEMON_ROOT/scripts/lemon_cli.exs" "$@"
}

parse_runtime_options() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --debug) DEBUG=1 ;;
      --no-distribution) DISTRIBUTED=0 ;;
      --port|--web-port|--sim-port|--name|--sname|--cookie)
        [ -n "${2:-}" ] || { error "missing value for $1"; exit 2; }
        case "$1" in
          --port) PORT="$2" ;;
          --web-port) WEB_PORT="$2" ;;
          --sim-port) SIM_PORT="$2" ;;
          --name) NODE_MODE="name" NODE_NAME="$2" ;;
          --sname) NODE_MODE="sname" NODE_NAME="$2" ;;
          --cookie) NODE_COOKIE="$2" ;;
        esac
        shift
        ;;
      *) error "unknown runtime option: $1 (see ./bin/lemon start --help)"; exit 2 ;;
    esac
    shift
  done
  validate_runtime_ports
  require_curl
  runtime_paths
}

# Long-lived BEAM processes may be denied keychain reads, and stale session env
# must not beat the canonical key file, so resolve the master key before boot.
load_secrets_master_key() {
  local key_file="$LEMON_HOME_DIR/secrets_master_key" key=""
  if [ "$(uname -s)" != "Darwin" ] && [ -r "$key_file" ]; then
    key="$(cat "$key_file")"
    [ -z "$key" ] || { export LEMON_SECRETS_MASTER_KEY="$key"; info "Loaded secrets master key from $key_file."; }
  fi
  if [ -z "${LEMON_SECRETS_MASTER_KEY:-}" ] && command -v security >/dev/null 2>&1; then
    key="$(security find-generic-password -s "Lemon Secrets" -a default -w 2>/dev/null ||
      security find-generic-password -s "Lemon Secrets" -a default -w \
        "$HOME/Library/Keychains/login.keychain-db" 2>/dev/null || true)"
    [ -z "$key" ] || { export LEMON_SECRETS_MASTER_KEY="$key"; info "Loaded secrets master key from keychain."; }
  fi
}

# Starts the unified runtime in the foreground (exec) or background.
start_runtime() {
  local mode="$1" reuse="${2:-1}" pid attempt file
  local cmd=(mix run --no-start --no-halt --no-compile --no-deps-check -e 'LemonCore.Runtime.Boot.start!(:runtime_full)')
  # Reuse guard before compiling or registering the Erlang node name: a
  # duplicate lemon@host registration would fail before the in-VM Boot guard.
  if control_plane_healthy; then
    [ "$reuse" = 1 ] || { error "another runtime is serving port $PORT; restart did not replace it; stop it where it runs, then retry"; return 1; }
    info "a healthy Lemon runtime is already running on port $PORT; reusing it"
    if [ "$mode" = "daemon" ]; then return 0; fi
    exit 0
  fi
  acquire_start_lock || exit 1
  # Another launcher may have finished while this one waited.
  if control_plane_healthy; then
    [ "$reuse" = 1 ] || { error "another runtime is serving port $PORT; restart did not replace it; stop it where it runs, then retry"; return 1; }
    release_start_lock
    info "a healthy Lemon runtime is already running on port $PORT; reusing it"
    return 0
  fi
  if file="$(managed_runtime_pidfile)"; then
    pid="$(owned_runtime_pid "$file" probe || true)"
    error "managed runtime pid ${pid:-recorded in $file} is alive but unhealthy; inspect $LOG_FILE, then run './bin/lemon stop' before retrying"
    exit 1
  fi
  if control_port_in_use; then
    error "port $PORT is occupied but does not answer Lemon health checks; free it, use --port <port>, or save another port with 'lemon setup runtime --control-port PORT'"
    exit 1
  fi
  # Never displace a live runtime's ownership record, even if it is unhealthy.
  # The start lock and paths cover compilation as well as the eventual boot.
  record_runtime_paths
  if restore_in_progress; then
    release_start_lock
    exit 1
  fi
  if [ -n "${LEMON_STORE_PATH:-}" ]; then
    case "$LEMON_STORE_PATH" in
      \~) LEMON_STORE_PATH="$HOME" ;;
      \~/*) LEMON_STORE_PATH="$HOME/${LEMON_STORE_PATH#\~/}" ;;
      /*) ;;
      *) LEMON_STORE_PATH="$LEMON_ROOT/$LEMON_STORE_PATH" ;;
    esac
    export LEMON_STORE_PATH
  fi
  rm -f "$PIDFILE"
  if [ "$DISTRIBUTED" = "1" ]; then
    [ -n "$NODE_COOKIE" ] || { error "distributed mode requires a non-empty --cookie"; exit 2; }
    if [ -z "$NODE_MODE" ]; then
      if [[ "$NODE_NAME" == *@* ]]; then NODE_MODE="name"; else NODE_MODE="sname"; fi
    fi
    cmd=(elixir "--$NODE_MODE" "$NODE_NAME" --cookie "$NODE_COOKIE" -S "${cmd[@]}")
  fi
  ensure_managed_token || exit 1
  export LEMON_DOTENV_DIR="${LEMON_DOTENV_DIR:-$LAUNCH_CWD}" LEMON_CONTROL_PLANE_PORT="$PORT"
  export LEMON_WEB_PORT="$WEB_PORT" LEMON_SIM_UI_PORT="$SIM_PORT"
  export LEMON_RUNTIME_PROFILE=runtime_full
  [ -z "$DEBUG" ] || export LEMON_DEBUG=1 LEMON_LOG_LEVEL=debug
  load_secrets_master_key

  cd "$LEMON_ROOT"
  compile_source
  info "Control plane: ws://localhost:$PORT/ws"
  info "Web UI:        http://localhost:$WEB_PORT/"
  info "Sim UI:        http://localhost:$SIM_PORT/"
  info "Dotenv dir:    $LEMON_DOTENV_DIR"
  [ "$DISTRIBUTED" = "1" ] || warn "Distribution disabled (--no-distribution); remote attach is unavailable."

  if [ "$mode" = "foreground" ]; then
    [ "$DISTRIBUTED" = "0" ] || info "Distributed node: --$NODE_MODE $NODE_NAME (attach with iex --remsh and the same cookie)"
    record_runtime_pid "$$"
    release_start_lock
    exec "${cmd[@]}"
  fi

  nohup "${cmd[@]}" > "$LOG_FILE" 2>&1 &
  pid=$!
  record_runtime_pid "$pid"
  for ((attempt = 0; attempt < 240; attempt++)); do
    if control_plane_healthy; then
      info "Runtime started in background (pid: $pid); logs: $LOG_FILE"
      release_start_lock
      return 0
    fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.25
  done
  error "Runtime did not become healthy on port $PORT. See $LOG_FILE"
  # Never leave a failed launch occupying ports or holding an unexplained pid.
  stop_runtime || true
  rm -f "$PIDFILE"
  exit 1
}

stop_runtime() {
  local pid attempt file
  if ! file="$(managed_runtime_pidfile)" || ! pid="$(owned_runtime_pid "$file")"; then
    if control_port_in_use; then
      error "port $PORT answers but is not managed by this HOME ($HOME); stop it where it runs"
    else
      error "no Lemon runtime answers on port $PORT; no process was signalled"
    fi
    return 1
  fi
  kill -TERM "$pid"
  for ((attempt = 0; attempt < 30; attempt++)); do
    [ "$(owned_runtime_pid "$file" || true)" = "$pid" ] || break
    sleep 1
  done
  [ "$(owned_runtime_pid "$file" || true)" != "$pid" ] || kill -KILL "$pid"
  rm -f "$file"
  info "stopped"
}

status_context() {
  printf '  web: port %s\n  sim: port %s\n  log: %s (foreground output stays in its terminal)\n' "$WEB_PORT" "$SIM_PORT" "$LOG_FILE"
}

open_browser() {
  local url="$1" opener
  # Sign in with the operator token in the URL fragment: browsers never send
  # fragments to the server, so it stays out of request logs, history after
  # the login page removes it, and Referer headers.
  if [ -n "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}" ]; then
    if [[ "$LEMON_CONTROL_PLANE_OPERATOR_TOKEN" =~ ^[A-Za-z0-9._~-]+$ ]]; then
      url="${url}login#token=$LEMON_CONTROL_PLANE_OPERATOR_TOKEN"
    else
      warn "The operator token contains URL-reserved characters; sign in by pasting it on the login page."
    fi
  fi
  for opener in open xdg-open wslview; do
    if command -v "$opener" >/dev/null 2>&1; then
      "$opener" "$url" >/dev/null 2>&1 &
      return 0
    fi
  done
  warn "No browser opener found; open the URL above manually."
}

COMMAND="${1:-}"
if [ -z "$COMMAND" ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
  error "No interactive terminal. Use 'lemon -p \"PROMPT\"' for CI, 'lemon daemon' to start a service, or 'lemon --help'."
  exit 2
fi
if [ -z "$COMMAND" ]; then
  COMMAND="tui"
  set -- tui
fi
# Session-resume flags open the TUI: `lemon -c`, `lemon --continue`, `lemon -r [key]`.
case "$COMMAND" in
  -c|--continue|-r|--resume)
    COMMAND="tui"
    set -- tui "$@"
    ;;
esac

case "$COMMAND" in
  -h|--help) run_help ;;
  help) shift; run_help "$@" ;;
esac
for argument in "${@:2}"; do
  case "$argument" in
    -h|--help|help)
      case "$COMMAND" in
        -p|--print) run_help run ;;
        *) run_help "$COMMAND" ;;
      esac
      ;;
  esac
done
case "$COMMAND" in --version|version|backup) run_cli "$@" ;; esac
validate_runtime_ports
case "$COMMAND" in
  tui|web|start|daemon|stop|restart|status|acp|run|-p|--print) require_curl ;;
esac

case "$COMMAND" in
  acp)
    shift
    case "${1:-}" in -h|--help) run_help acp ;; esac
    prepare_runtime_credential || exit 1
    if ! control_plane_healthy; then start_runtime daemon >&2; fi
    run_cli acp "$@"
    ;;
  tui)
    shift
    command -v bun >/dev/null 2>&1 || { error "Bun is required to run the TUI; install Bun and put 'bun' on PATH."; exit 1; }
    if [ ! -d "$TUI_DIR/node_modules" ]; then
      info "Installing TUI dependencies..."
      (cd "$TUI_DIR" && env -u LEMON_CONTROL_PLANE_OPERATOR_TOKEN -u LEMON_WS_TOKEN bun install --frozen-lockfile)
    fi
    status=0
    [ -n "${LEMON_WS_TOKEN:-}" ] || load_managed_token || status=$?
    [ "$status" -le 1 ] || exit 1
    if ! control_plane_healthy; then
      # First launch only: finish setup in one VM before starting a daemon.
      if [ -t 0 ] && [ -t 1 ]; then
        compile_source >/dev/null
        (run_cli setup --if-required) || exit 1
      fi
      start_runtime daemon
    fi
    if [ -z "${LEMON_CONTROL_PLANE_OPERATOR_TOKEN:-}${LEMON_WS_TOKEN:-}" ]; then
      case "${LEMON_CONTROL_PLANE_ALLOW_UNAUTHENTICATED_LOOPBACK:-}" in
        1|true|TRUE|yes|YES) ;;
        *)
          error "no credential is available for the existing runtime"
          error "start managed runtimes with './bin/lemon daemon', or set LEMON_CONTROL_PLANE_OPERATOR_TOKEN"
          exit 1
          ;;
      esac
    fi
    cd "$LAUNCH_CWD"
    exec bun "$TUI_DIR/src/main.ts" --ws-url "ws://127.0.0.1:$PORT/ws" "$@"
    ;;

  web)
    case "$#:${2:-}" in
      1:|2:--no-open) ;;
      *) error "usage: ./bin/lemon web [--no-open]"; exit 2 ;;
    esac
    status=0
    load_managed_token || status=$?
    [ "$status" -le 1 ] || exit 1
    if ! web_healthy; then
      info "Web UI is not running; starting Lemon"
      start_runtime daemon
      wait_until web_healthy 30 || { error "Web UI did not become healthy on port $WEB_PORT within 30s"; exit 1; }
    fi
    info "Lemon Web: http://127.0.0.1:$WEB_PORT/"
    [ "${2:-}" = "--no-open" ] || open_browser "http://127.0.0.1:$WEB_PORT/"
    ;;

  start)
    shift
    parse_runtime_options "$@"
    start_runtime foreground
    ;;

  daemon)
    shift
    parse_runtime_options "$@"
    start_runtime daemon
    ;;

  stop)
    shift
    parse_runtime_options "$@"
    stop_runtime
    ;;

  restart)
    shift
    parse_runtime_options "$@"
    if managed_runtime_pidfile >/dev/null; then
      stop_runtime || exit 1
    elif control_port_in_use; then
      error "port $PORT answers but is not managed by this HOME ($HOME); stop it where it runs, then retry restart"
      exit 1
    fi
    start_runtime daemon 0
    ;;

  status)
    shift
    parse_runtime_options "$@"
    if ! file="$(managed_runtime_pidfile)" || ! pid="$(owned_runtime_pid "$file")"; then
      if control_plane_healthy; then
        echo "lemon: running, healthy on port $PORT (not managed by this HOME); home: $LEMON_HOME_DIR (launcher)"
        status_context
        exit 0
      fi
      echo "lemon: no Lemon runtime answers on port $PORT; home: $LEMON_HOME_DIR"
      status_context
      exit 1
    fi
    if control_plane_healthy; then
      echo "lemon: running (pid $pid), control-plane healthy on port $PORT; home: $LEMON_HOME_DIR"
      status_context
    else
      echo "lemon: running (pid $pid), control-plane not reachable on port $PORT; home: $LEMON_HOME_DIR"
      status_context
      exit 1
    fi
    ;;

  *)
    case "$COMMAND" in
      run|-p|--print) prepare_runtime_credential || exit 1 ;;
      *) ensure_managed_token || exit 1 ;;
    esac
    run_cli "$@"
    ;;
esac
