{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone factory decision configuration (no credentials)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {"type": "boolean", "default": true},
    "mode": {"enum": ["off", "shadow", "advisory", "automatic"], "default": "shadow"},
    "provider": {"const": "openrouter", "default": "openrouter"},
    "model": {"const": "cloudflare/clef-flash", "default": "cloudflare/clef-flash"},
    "endpoint": {"const": "https://openrouter.ai/api/v1/systemone", "default": "https://openrouter.ai/api/v1/systemone"},
    "deadline_s": {"type": "number", "minimum": 0.1, "maximum": 60, "default": 20},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 1, "default": 0},
    "max_input_bytes": {"type": "integer", "minimum": 512, "maximum": 32000, "default": 12000},
    "uncertainty_threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.25},
    "min_probability": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.75},
    "tier_models": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "simple": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s]+/[^\\s]+$"},
        "standard": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s]+/[^\\s]+$"},
        "complex": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\s]+/[^\\s]+$"}
      }, "default": {}
    },
    "prompt_version": {"const": "factory-complexity-1", "default": "factory-complexity-1"},
    "schema_version": {"const": "1", "default": "1"},
    "cache_entries": {"type": "integer", "minimum": 1, "maximum": 4096, "default": 256}
  }
}
