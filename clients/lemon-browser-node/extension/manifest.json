{
  "manifest_version": 3,
  "name": "Lemon Browser Relay",
  "version": "1.0.0",
  "key": "",
  "description": "Lets Lemon securely control opted-in existing Chrome tabs through a local CDP relay.",
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Lemon Browser Relay settings"
  }
}
