{
  "name": "lemon-tui",
  "version": "2026.08.1",
  "description": "Lemon terminal client built on pi-tui",
  "type": "module",
  "license": "MIT",
  "bin": {
    "lemon-tui": "src/main.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@oh-my-pi/pi-natives": "17.3.4",
    "@oh-my-pi/pi-tui": "17.3.4",
    "@oh-my-pi/pi-utils": "17.3.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  },
  "trustedDependencies": [
    "@oh-my-pi/pi-natives"
  ],
  "scripts": {
    "start": "bun src/main.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "gallery": "bun src/dev/gallery.ts",
    "build:binary": "bun scripts/build-binary.ts"
  }
}
